{
  // The hand-written glossary: core terms across the topics, each with a plain-English definition of one or two
  // sentences. Server/Search.cs links each term to the lessons that teach it (title, card heading, then text), and
  // adds the terms lessons define themselves ("**Term** is ..."). Optional per term: "aliases" (other names that
  // also find it) and "lessons" (lesson keys to link first). "topic" is a track id. Keep definitions accurate.
  "terms": [
    { "term": "IP address", "topic": "networking", "aliases": ["IPv4 address"], "def": "A number that identifies a network interface so packets can be delivered to it: 32 bits for IPv4 (written as four bytes, like 192.168.1.10) and 128 bits for IPv6." },
    { "term": "CIDR", "topic": "networking", "aliases": ["CIDR notation", "prefix length"], "def": "Classless Inter-Domain Routing: writing a network as an address plus how many leading bits name the network, like 10.0.0.0/8. A /24 leaves 8 bits for hosts, so 256 addresses." },
    { "term": "Subnet mask", "topic": "networking", "aliases": ["netmask"], "def": "The 32-bit pattern of ones then zeros that marks which part of an IPv4 address is the network and which is the host; 255.255.255.0 is the same as /24." },
    { "term": "Default gateway", "topic": "networking", "aliases": ["gateway"], "def": "The router a host sends packets to when the destination is not on its own subnet. A wrong or missing gateway means local traffic works but nothing beyond it does." },
    { "term": "NAT", "topic": "networking", "aliases": ["network address translation", "port forwarding"], "def": "Rewriting addresses (and often ports) in packets as they pass a router, usually so many private addresses can share one public address. Connections from outside need an explicit port forward." },
    { "term": "ARP", "topic": "networking", "aliases": ["Address Resolution Protocol"], "def": "How a host on an IPv4 LAN finds the MAC address that owns an IP address: it broadcasts \"who has 10.0.0.5?\" and caches the reply." },
    { "term": "DNS", "topic": "networking", "aliases": ["Domain Name System", "DNS record"], "def": "The distributed, cached directory that turns names like example.com into records such as A (IPv4), AAAA (IPv6), CNAME (an alias) and MX (mail)." },
    { "term": "TTL", "topic": "networking", "aliases": ["time to live"], "def": "A countdown attached to data. In an IP packet each router decrements it and drops the packet at zero (which is how traceroute works); in DNS it is how many seconds a record may be cached." },
    { "term": "TCP", "topic": "networking", "aliases": ["three-way handshake"], "def": "Transmission Control Protocol: a connection-oriented transport giving a reliable, ordered byte stream, with a three-way handshake (SYN, SYN-ACK, ACK), acknowledgements and retransmission." },
    { "term": "UDP", "topic": "networking", "def": "User Datagram Protocol: a connectionless transport that sends independent datagrams with no handshake, ordering or retransmission, used where low latency matters more than guaranteed delivery (DNS queries, voice, games)." },
    { "term": "Port", "topic": "networking", "aliases": ["port number"], "def": "A 16-bit number that, with an IP address and protocol, identifies one endpoint of a connection, so many services can share a host (443 for HTTPS, 22 for SSH)." },
    { "term": "MTU", "topic": "networking", "aliases": ["maximum transmission unit"], "def": "The largest packet a link carries without fragmenting, usually 1500 bytes on Ethernet. Tunnels and VPNs lower it, which can make large transfers hang while small requests still work." },
    { "term": "DHCP", "topic": "networking", "def": "Dynamic Host Configuration Protocol: how a device joining a network is automatically leased an IP address, subnet mask, default gateway and DNS servers." },
    { "term": "VLAN", "topic": "networking", "aliases": ["virtual LAN"], "def": "A way to split one switched network into separate broadcast domains by tagging frames (802.1Q); hosts on different VLANs need a router to talk to each other." },
    { "term": "Load balancer", "topic": "networking", "def": "A component that spreads incoming connections or requests across several backend servers, with health checks so traffic stops going to an instance that fails." },
    { "term": "HSTS", "topic": "networking", "aliases": ["Strict-Transport-Security"], "def": "HTTP Strict Transport Security: a response header that tells the browser to use only HTTPS for the site for a set time, closing the gap where a first plain-HTTP request could be intercepted." },
    { "term": "CDN", "topic": "networking", "aliases": ["content delivery network"], "def": "Servers in many locations that cache and serve content close to users, cutting latency and taking load off the origin server." },
    { "term": "Latency", "topic": "networking", "aliases": ["throughput"], "def": "How long one request or packet takes to arrive (or to make the round trip). Throughput is different: how much gets through per second." },

    { "term": "Hash function", "topic": "crypto", "aliases": ["cryptographic hash", "SHA-256", "digest"], "def": "A function that maps any input to a fixed-size digest so that it is infeasible to recover the input or find two inputs with the same digest. SHA-256 is the usual choice; MD5 and SHA-1 are broken for security use." },
    { "term": "Salt", "topic": "auth", "def": "A random value stored with a password hash and mixed into it, so identical passwords produce different hashes and precomputed (rainbow) tables are useless." },
    { "term": "Key derivation function", "topic": "auth", "aliases": ["KDF", "PBKDF2", "Argon2", "bcrypt"], "def": "A deliberately slow, tunable function such as PBKDF2, bcrypt, scrypt or Argon2id that turns a password into a hash or key, so every guess costs an attacker real time." },
    { "term": "Symmetric encryption", "topic": "crypto", "aliases": ["AES", "symmetric key"], "def": "Encryption where the same secret key encrypts and decrypts, such as AES. It is fast, but both sides must already share the key." },
    { "term": "Public-key cryptography", "topic": "crypto", "aliases": ["asymmetric encryption", "key pair", "RSA"], "def": "Cryptography with a key pair: what the public key encrypts only the private key can decrypt, and what the private key signs anyone can verify with the public key." },
    { "term": "Authenticated encryption", "topic": "crypto", "aliases": ["AEAD", "AES-GCM"], "def": "Encryption that also detects tampering, such as AES-GCM or ChaCha20-Poly1305: decryption fails if the ciphertext, nonce or associated data was changed." },
    { "term": "Nonce", "topic": "crypto", "aliases": ["IV", "initialization vector"], "def": "A number used once: a value that must never repeat with the same key. Reusing a nonce with AES-GCM breaks both confidentiality and integrity." },
    { "term": "HMAC", "topic": "crypto", "def": "Hash-based message authentication code: a keyed hash proving that a message came from someone holding the shared key and was not altered. Webhook signatures and HS256 JWTs use it." },
    { "term": "Digital signature", "topic": "crypto", "aliases": ["signature"], "def": "A value made with a private key over some data that anyone with the matching public key can verify, proving who signed it and that the data has not changed since." },
    { "term": "Constant-time comparison", "topic": "crypto", "aliases": ["FixedTimeEquals", "timing attack"], "def": "Comparing secrets such as MACs or tokens in a way that takes the same time wherever they differ, so response timing leaks nothing. In .NET: CryptographicOperations.FixedTimeEquals." },
    { "term": "TLS", "topic": "networking", "aliases": ["TLS handshake", "HTTPS"], "def": "Transport Layer Security, the protocol behind HTTPS. Its handshake authenticates the server by its certificate and agrees fresh keys; after that, traffic is encrypted and protected against tampering." },
    { "term": "X.509 certificate", "topic": "pki", "aliases": ["certificate", "TLS certificate"], "def": "A signed document binding a public key to names (the Subject Alternative Names), issued by a certificate authority, with a validity period and the uses it is allowed for." },
    { "term": "Certificate authority", "topic": "pki", "aliases": ["CA", "root CA", "root certificate"], "def": "An issuer whose signature on certificates others trust. Root CAs are self-signed and preinstalled in trust stores; they normally sign intermediates, which sign server certificates." },
    { "term": "Certificate chain", "topic": "pki", "aliases": ["chain of trust", "intermediate certificate"], "def": "The path from a server's certificate through intermediates to a trusted root. Servers must send the intermediates; a missing one causes \"unable to get local issuer certificate\"." },
    { "term": "Subject Alternative Name", "topic": "pki", "aliases": ["SAN"], "def": "The certificate extension listing the DNS names and IP addresses it is valid for. Clients match the host name against it, not against the subject's Common Name." },
    { "term": "Mutual TLS", "topic": "pki", "aliases": ["mTLS", "client certificate"], "def": "TLS where the client also presents a certificate, so both sides authenticate each other; common between internal services." },
    { "term": "Certificate revocation", "topic": "pki", "aliases": ["CRL", "OCSP"], "def": "Withdrawing a certificate before it expires, for example after a key leak. Clients learn about it from a CRL (a signed list) or OCSP (an online status check)." },

    { "term": "Authentication", "topic": "auth", "aliases": ["authn"], "def": "Proving who a caller is, for example with a password, a passkey or a token. When it fails, an HTTP API answers 401 Unauthorized." },
    { "term": "Authorization", "topic": "auth", "aliases": ["authz"], "def": "Deciding what an authenticated caller may do. When it fails, an HTTP API answers 403 Forbidden." },
    { "term": "JWT", "topic": "auth", "aliases": ["JSON Web Token"], "def": "A compact token of three base64url parts: header, claims and signature. The signature proves who issued it and that the claims are unchanged; anyone can read the claims, so they must not hold secrets." },
    { "term": "Claim", "topic": "auth", "aliases": ["claims"], "def": "A statement about the subject inside a token, such as sub (who), exp (when it expires), aud (who it is for), iss (who issued it), or a role or scope." },
    { "term": "OAuth 2.0", "topic": "auth", "aliases": ["OAuth"], "def": "A framework for delegated authorization: with the user's consent, a client gets an access token from an authorization server to call an API on their behalf, without ever seeing their password." },
    { "term": "OpenID Connect", "topic": "auth", "aliases": ["OIDC", "ID token"], "def": "An identity layer on top of OAuth 2.0 that adds the ID token, so an app learns who signed in rather than only getting API access." },
    { "term": "PKCE", "topic": "auth", "aliases": ["Proof Key for Code Exchange"], "def": "The client sends a hash of a random secret with the authorization request and the secret itself when redeeming the code, so a stolen authorization code is useless. Recommended for all clients, required for public ones." },
    { "term": "Scope", "topic": "auth", "aliases": ["OAuth scope"], "def": "A named permission an access token carries, such as orders:read, which the API checks before allowing a call." },
    { "term": "Refresh token", "topic": "auth", "def": "A long-lived credential used only at the token endpoint to get new short-lived access tokens without signing in again. Rotate it on every use and revoke it on sign-out." },
    { "term": "Session cookie", "topic": "auth", "aliases": ["HttpOnly", "SameSite"], "def": "A cookie holding an opaque session id that the server looks up on every request. Mark it HttpOnly, Secure and SameSite so scripts and other sites cannot use it." },
    { "term": "CSRF", "topic": "auth", "aliases": ["cross-site request forgery"], "def": "An attack where another site makes the victim's browser send a request that carries their cookies. Defended with SameSite cookies and anti-forgery tokens." },
    { "term": "Multi-factor authentication", "topic": "auth", "aliases": ["MFA", "2FA", "TOTP"], "def": "Requiring two or more kinds of evidence (something you know, have or are), such as a password plus a one-time code or a passkey." },
    { "term": "Rate limiting", "topic": "integration", "aliases": ["429", "throttling"], "def": "Capping how many requests a client may make in a time window and answering 429 Too Many Requests beyond it. It slows password guessing and protects services from overload." },
    { "term": "CORS", "topic": "auth", "aliases": ["cross-origin resource sharing"], "def": "The browser rules, driven by response headers such as Access-Control-Allow-Origin, that decide whether a page from one origin may read responses from another. It protects users in browsers; it is not access control on the server." },

    { "term": "Pod", "topic": "kubernetes", "def": "The smallest unit Kubernetes runs: one or more containers that share one IP address and volumes and are scheduled together on one node." },
    { "term": "Deployment", "topic": "kubernetes", "def": "A Kubernetes controller that keeps a set number of identical pods running from a template and rolls changes to that template out gradually, with rollback." },
    { "term": "ReplicaSet", "topic": "kubernetes", "def": "The object a Deployment creates for each version of its pod template; it keeps the requested number of pod replicas running." },
    { "term": "Service", "topic": "kubernetes", "aliases": ["ClusterIP", "endpoints"], "def": "A stable virtual IP and DNS name in front of the pods a label selector picks, balancing traffic across the ready ones. With no matching ready pods it has no endpoints and requests fail." },
    { "term": "Ingress", "topic": "kubernetes", "aliases": ["ingress controller"], "def": "Rules routing HTTP(S) traffic from outside the cluster by host and path to Services, carried out by an ingress controller such as ingress-nginx or Traefik." },
    { "term": "ConfigMap", "topic": "kubernetes", "def": "A Kubernetes object holding non-secret configuration as key-value pairs or files, given to pods as environment variables or mounted files." },
    { "term": "Secret", "topic": "kubernetes", "aliases": ["Kubernetes Secret"], "def": "Like a ConfigMap but for sensitive values. By default it is only base64-encoded, so who may read it (RBAC) and encryption at rest matter." },
    { "term": "Liveness probe", "topic": "kubernetes", "def": "A check the kubelet runs on a container; when it keeps failing the container is restarted. A liveness probe that is too strict kills slow-starting apps over and over." },
    { "term": "Readiness probe", "topic": "kubernetes", "def": "A check that decides whether a pod gets traffic from Services. Failing it takes the pod out of the endpoints without restarting it." },
    { "term": "CrashLoopBackOff", "topic": "kubernetes", "def": "A pod status meaning its container keeps exiting and Kubernetes waits longer each time (up to five minutes) before restarting it. kubectl logs --previous shows why the last run died." },
    { "term": "ImagePullBackOff", "topic": "kubernetes", "aliases": ["ErrImagePull"], "def": "A pod status meaning the node could not pull the container image (a wrong name or tag, missing registry credentials, or no network) and is waiting between retries." },
    { "term": "OOMKilled", "topic": "kubernetes", "aliases": ["exit code 137", "out of memory"], "def": "A container status meaning it was killed for going over its memory limit (exit code 137). Raise the limit or fix the memory use; restarting alone will not help." },
    { "term": "Resource requests and limits", "topic": "kubernetes", "aliases": ["requests", "limits"], "def": "Requests are what the scheduler reserves for a container; limits are the most it may use. Going over the CPU limit throttles it; going over the memory limit gets it OOMKilled." },
    { "term": "kubelet", "topic": "kubernetes", "def": "The agent on every node that starts the containers of the pods scheduled there, runs their probes and reports their status." },
    { "term": "Namespace (Kubernetes)", "topic": "kubernetes", "aliases": ["kubernetes namespace"], "def": "A named scope for Kubernetes objects: names are unique within it, and quotas, access rules and network policies are often set per namespace." },

    { "term": "Container", "topic": "docker", "def": "A process isolated with kernel namespaces and limited with cgroups, running on an image's filesystem. It shares the host's kernel, unlike a virtual machine." },
    { "term": "Container image", "topic": "docker", "aliases": ["image", "image tag"], "def": "A read-only, layered filesystem plus metadata (entrypoint, environment, ports) that containers start from, named by repository and tag and identified exactly by its digest." },
    { "term": "Dockerfile", "topic": "docker", "def": "The recipe for building an image: a base image (FROM) followed by instructions such as COPY, RUN and ENTRYPOINT, each producing a cached layer." },
    { "term": "Layer cache", "topic": "docker", "aliases": ["build cache"], "def": "Docker reuses a layer from an earlier build when its instruction and inputs are unchanged. Copying the dependency manifest and restoring before copying the source keeps rebuilds fast." },
    { "term": "Multi-stage build", "topic": "docker", "def": "A Dockerfile with several FROM stages where the final image copies only the build output from an earlier stage, leaving the SDK and sources behind." },
    { "term": "Volume", "topic": "docker", "aliases": ["named volume"], "def": "Storage managed by Docker outside a container's writable layer, so the data survives when the container is removed and recreated." },
    { "term": "Bind mount", "topic": "docker", "def": "Mounting a host directory or file into a container at a path, so both see the same files. Handy in development, fragile in production." },
    { "term": "Docker Compose", "topic": "docker", "aliases": ["compose.yaml", "docker compose"], "def": "A tool that runs a multi-container application described in compose.yaml (services, networks, volumes) with docker compose up." },
    { "term": "Healthcheck", "topic": "docker", "aliases": ["HEALTHCHECK", "service_healthy"], "def": "A command run inside a container to report it healthy or not. Compose can wait for a dependency to be healthy (depends_on with condition: service_healthy) before starting a service." },

    { "term": "Message broker", "topic": "messaging", "aliases": ["broker"], "def": "A server that accepts messages from producers and holds them until consumers take them, decoupling the two in time and load; RabbitMQ and Kafka are examples." },
    { "term": "Exchange", "topic": "messaging", "aliases": ["RabbitMQ exchange", "fanout", "topic exchange"], "def": "Where RabbitMQ producers publish. An exchange routes each message to zero or more queues according to its type (direct, topic, fanout, headers) and the queues' bindings." },
    { "term": "Binding", "topic": "messaging", "aliases": ["routing key"], "def": "A rule linking a RabbitMQ exchange to a queue, usually with a routing key or pattern. A message no binding matches is dropped, or returned if published as mandatory." },
    { "term": "Acknowledgement", "topic": "messaging", "aliases": ["ack", "nack"], "def": "A consumer's signal that it has finished with a message, so the broker may delete it. Ack after the work is done; an unacknowledged message is redelivered if the consumer dies." },
    { "term": "Dead-letter queue", "topic": "messaging", "aliases": ["DLQ", "dead letter"], "def": "Where messages go when they are rejected, expire or fail too often, so they can be inspected and replayed instead of blocking the queue or being lost." },
    { "term": "Topic (Kafka)", "topic": "messaging", "aliases": ["Kafka topic"], "def": "A named, append-only log of records split into partitions. Consumers read it at their own pace, and records are kept for the retention period whether or not anyone read them." },
    { "term": "Partition", "topic": "messaging", "aliases": ["partition key"], "def": "One ordered log inside a Kafka topic. Records with the same key go to the same partition, the only place Kafka guarantees order; partitions are also the unit of parallelism." },
    { "term": "Offset", "topic": "messaging", "aliases": ["committed offset"], "def": "A record's position in a Kafka partition. A consumer group commits the offset it has processed up to, so after a restart it carries on from there." },
    { "term": "Consumer group", "topic": "messaging", "aliases": ["group id"], "def": "Kafka consumers sharing a group id that divide a topic's partitions between them, each partition read by one member. Members beyond the number of partitions sit idle." },
    { "term": "Consumer lag", "topic": "messaging", "aliases": ["lag"], "def": "How far a consumer group is behind the newest record in each partition (the log-end offset minus the committed offset). Lag that keeps growing means consumers cannot keep up." },
    { "term": "Rebalance", "topic": "messaging", "aliases": ["rebalancing"], "def": "Kafka reassigning a group's partitions when a member joins, leaves or misses its heartbeats. Consumption pauses meanwhile, and work that was not committed may be redone." },
    { "term": "At-least-once delivery", "topic": "messaging", "aliases": ["at least once", "at-most-once"], "def": "Every message is delivered, possibly more than once, because it is acknowledged only after processing. Consumers must therefore be idempotent. At-most-once is the opposite trade: no duplicates, but messages can be lost." },
    { "term": "Exactly-once semantics", "topic": "messaging", "aliases": ["exactly once"], "def": "Each message's effect happening once. Kafka provides it inside Kafka (idempotent producers and transactions); end to end it still takes idempotent consumers or an outbox." },
    { "term": "Transactional outbox", "topic": "messaging", "aliases": ["outbox pattern", "dual write"], "def": "Writing an event to an outbox table in the same database transaction as the state change, then publishing from that table, so the change and the message cannot get out of step (the dual-write problem)." },
    { "term": "Idempotency", "topic": "integration", "aliases": ["idempotent", "idempotent consumer"], "def": "An operation is idempotent if doing it several times has the same effect as doing it once. Retries, redeliveries and double clicks are only safe against idempotent handlers." },
    { "term": "Idempotency key", "topic": "integration", "aliases": ["Idempotency-Key"], "def": "A unique id the client sends with a request and reuses on every retry, so the server can recognise a repeat and return the first result instead of acting twice." },
    { "term": "Backpressure", "topic": "messaging", "aliases": ["back-pressure", "flow control"], "def": "A slow consumer signalling upstream so producers slow down, instead of queues and buffers growing until memory runs out or latency explodes. Bounded queues and prefetch limits are common forms." },
    { "term": "Prefetch", "topic": "messaging", "aliases": ["basic.qos", "prefetch count"], "def": "How many unacknowledged messages RabbitMQ pushes to one consumer at a time. A small prefetch spreads work fairly; an unlimited one lets a single consumer hoard the queue." },
    { "term": "Retention", "topic": "messaging", "aliases": ["retention.ms"], "def": "How long, or how much, Kafka keeps records in a topic before deleting old segments, regardless of whether anyone has read them." },
    { "term": "Log compaction", "topic": "messaging", "aliases": ["compacted topic"], "def": "A Kafka topic setting that keeps at least the latest record for every key and removes older ones, so the topic works as a changelog of current state." },
    { "term": "Poison message", "topic": "messaging", "aliases": ["poison pill"], "def": "A message that makes its consumer fail every time. Without a retry limit and a dead-letter queue it is redelivered forever and holds up the messages behind it." },

    { "term": "API gateway", "topic": "integration", "aliases": ["gateway"], "def": "A single entry point in front of backend services that handles cross-cutting concerns such as routing, authentication, rate limiting and logging; Kong is a common example." },
    { "term": "Enterprise service bus", "topic": "integration", "aliases": ["ESB"], "def": "A central integration layer that connects applications by routing and transforming messages with enterprise integration patterns. Newer setups favour lighter gateways and brokers, but ESBs remain common in large companies." },
    { "term": "Circuit breaker", "topic": "integration", "def": "A wrapper around calls to a dependency that, after repeated failures, fails fast for a cool-down period instead of waiting on timeouts, then lets a trial call through to see whether it has recovered." },
    { "term": "Exponential backoff", "topic": "integration", "aliases": ["backoff", "jitter", "retry"], "def": "Retrying a failed call after waits that grow each time (1 s, 2 s, 4 s...), with random jitter so many clients do not retry in lockstep. Retry only transient errors and idempotent operations." },
    { "term": "Timeout", "topic": "integration", "def": "The longest a caller waits for an answer before giving up. Every network call needs one, and an outer timeout must allow for the inner calls and their retries." },
    { "term": "Correlation id", "topic": "integration", "aliases": ["trace id", "traceparent"], "def": "An id attached to a request and passed to every service and message it causes, so the logs and traces of one user action can be found together." },
    { "term": "Content-based router", "topic": "integration", "aliases": ["router"], "def": "An integration pattern that sends each message to a destination chosen from what it contains, such as an order's country or type." },
    { "term": "Message translator", "topic": "integration", "aliases": ["translator"], "def": "An integration pattern that converts a message from one system's format into another's, so neither system has to change." },
    { "term": "Splitter", "topic": "integration", "def": "An integration pattern that breaks a message holding many items into one message per item." },
    { "term": "Aggregator", "topic": "integration", "def": "An integration pattern that collects related messages (matched by a correlation id) and combines them into one once a completion condition is met, such as a count or a timeout." },
    { "term": "Webhook", "topic": "integration", "def": "An HTTP callback: a service calls a URL you registered when an event happens. Verify its signature, answer quickly and process it idempotently, because senders retry." },
    { "term": "502 Bad Gateway", "topic": "integration", "aliases": ["502"], "def": "A proxy or gateway got an invalid response, or none at all, from the upstream server, for example because the backend crashed or refused the connection." },
    { "term": "504 Gateway Timeout", "topic": "integration", "aliases": ["504"], "def": "A proxy or gateway gave up waiting for the upstream server to answer within its timeout." },
    { "term": "Structured logging", "topic": "integration", "aliases": ["structured logs"], "def": "Logging events as named fields (JSON or key-value pairs) instead of free text, so logs can be filtered and counted, such as every error for one order id." },

    { "term": "Continuous integration", "topic": "cicd", "aliases": ["CI"], "def": "Merging everyone's changes into the main branch often, with every push built and tested automatically, so breakages show up within minutes." },
    { "term": "Continuous delivery", "topic": "cicd", "aliases": ["CD", "continuous deployment"], "def": "Keeping the main branch always releasable with an automated pipeline to deploy it. Continuous deployment goes further and releases every passing change automatically." },
    { "term": "Pipeline", "topic": "cicd", "aliases": ["workflow", "GitHub Actions"], "def": "The automated sequence of jobs (build, test, scan, deploy) that runs on a change, defined as code, such as a GitHub Actions workflow file." },
    { "term": "Build artifact", "topic": "cicd", "aliases": ["artifact"], "def": "A file a pipeline produces and keeps, such as a build output, test report or container image, so later jobs and releases use exactly what was tested." },
    { "term": "Build matrix", "topic": "cicd", "aliases": ["matrix"], "def": "Running the same job over combinations of parameters, such as operating systems and runtime versions, declared once in the pipeline." },
    { "term": "Blue-green deployment", "topic": "cicd", "aliases": ["blue/green"], "def": "Running the new version beside the old one and switching all traffic over at once, keeping the old one ready to switch straight back." },
    { "term": "Canary release", "topic": "cicd", "aliases": ["canary"], "def": "Sending a small share of traffic to a new version and watching its errors and latency before rolling it out to everyone." },
    { "term": "Feature flag", "topic": "cicd", "aliases": ["feature toggle"], "def": "A runtime switch that turns a code path on or off without a deploy, separating deploying code from releasing a feature." },
    { "term": "Rollback", "topic": "cicd", "def": "Returning production to the previous known-good version after a bad release. It should be one fast, rehearsed step." },
    { "term": "Flaky test", "topic": "cicd", "aliases": ["flaky"], "def": "A test that sometimes passes and sometimes fails on the same code, usually because of timing, ordering or shared state. It erodes trust in CI and should be fixed or quarantined." },
    { "term": "SLO", "topic": "cicd", "aliases": ["service level objective", "error budget"], "def": "A target for a measured indicator, such as 99.9% of requests succeeding in under 300 ms over 30 days. What the target allows to fail is the error budget." },

    { "term": "Commit", "topic": "git", "def": "A snapshot of the whole tracked tree with an author, a message and its parent commit(s), identified by a hash of its contents." },
    { "term": "Branch", "topic": "git", "def": "A movable name pointing at a commit; committing on the branch moves it forward. Branches are cheap, which is why Git workflows use so many." },
    { "term": "HEAD", "topic": "git", "aliases": ["detached HEAD"], "def": "Git's pointer to what is checked out: normally a branch name, or a commit directly in detached HEAD state." },
    { "term": "Merge", "topic": "git", "aliases": ["merge commit"], "def": "Combining two lines of history, recorded as a merge commit with two parents unless the target can simply fast-forward." },
    { "term": "Fast-forward", "topic": "git", "aliases": ["fast forward"], "def": "A merge where the target branch has no commits of its own since the branches split, so Git just moves its pointer forward and makes no merge commit." },
    { "term": "Rebase", "topic": "git", "def": "Replaying your commits on top of another base commit, which gives them new hashes and a linear history. Do not rebase commits others have already pulled." },
    { "term": "Interactive rebase", "topic": "git", "aliases": ["rebase -i", "autosquash", "squash"], "def": "git rebase -i: editing a series of commits before sharing them by reordering, squashing, rewording or dropping them; --autosquash folds fixup! commits into their targets." },
    { "term": "Merge conflict", "topic": "git", "aliases": ["conflict"], "def": "When two branches change the same lines differently, Git stops and marks both versions in the file for you to resolve, then you add the file and continue." },
    { "term": "Reflog", "topic": "git", "def": "Git's local record of where HEAD and each branch pointed over time; it is how you recover commits after a bad reset or rebase." },
    { "term": "Staging area", "topic": "git", "aliases": ["git add"], "def": "Where you assemble the next commit with git add, so you can commit some changes and leave others for later." },
    { "term": "Cherry-pick", "topic": "git", "def": "Applying the change made by an existing commit onto the current branch as a new commit." },
    { "term": "git bisect", "topic": "git", "aliases": ["bisect"], "def": "A binary search through history for the commit that introduced a bug: you mark commits good or bad (or let a test script do it) until one is left." },
    { "term": "Force push with lease", "topic": "git", "aliases": ["--force-with-lease"], "def": "git push --force-with-lease overwrites the remote branch only if it still points where you last saw it, so you cannot silently erase someone else's new commits." },

    { "term": "Shell", "topic": "linux", "aliases": ["bash"], "def": "The command interpreter (bash, zsh, PowerShell) that runs commands, expands variables and wildcards, and connects programs with pipes and redirections." },
    { "term": "Pipe", "topic": "linux", "def": "The | operator, which connects one command's standard output to the next command's standard input so small tools can be combined." },
    { "term": "Standard streams", "topic": "linux", "aliases": ["stdin", "stdout", "stderr"], "def": "Every process starts with standard input (0), standard output (1) and standard error (2). 2>&1 sends errors to wherever the output is going." },
    { "term": "Exit code", "topic": "linux", "aliases": ["exit status"], "def": "The number a process returns when it ends: 0 means success and anything else failure. Scripts read it with $? or stop on failure with set -e." },
    { "term": "File permissions", "topic": "linux", "aliases": ["chmod", "rwx"], "def": "Read, write and execute bits for the owner, the group and everyone else (rwxr-x--- is 750), changed with chmod and chown. A directory needs x to be entered." },
    { "term": "Process", "topic": "linux", "aliases": ["PID"], "def": "A running program with its own process id, memory and open files. ps and top list them." },
    { "term": "Signal", "topic": "linux", "aliases": ["SIGTERM", "SIGKILL", "kill"], "def": "A short asynchronous notice to a process: SIGTERM asks it to exit cleanly, SIGKILL ends it and cannot be caught, and SIGHUP often means reload." },
    { "term": "cron", "topic": "linux", "aliases": ["crontab"], "def": "The scheduler that runs commands at times given by five fields (minute, hour, day of month, month, day of week); 0 3 * * * is 03:00 every day. Jobs run with a minimal environment." },
    { "term": "systemd", "topic": "linux", "aliases": ["systemctl", "journalctl", "unit file"], "def": "The Linux service manager: unit files describe services and timers, systemctl starts, stops and enables them, and journalctl shows their logs." },
    { "term": "Inode", "topic": "linux", "def": "The filesystem record holding a file's metadata and where its data lives, but not its name. A disk can run out of inodes with space free, and a deleted file that is still open keeps using space." },
    { "term": "Environment variable", "topic": "linux", "aliases": ["env var"], "def": "A named string a process passes to the processes it starts, such as PATH or a connection string; in a shell, export turns a variable into one." },
    { "term": "PATH", "topic": "linux", "def": "The environment variable listing, in order, the directories the shell searches for a command's program." },
    { "term": "SSH key", "topic": "linux", "aliases": ["authorized_keys", "ssh-keygen"], "def": "A key pair for logging in over SSH: the public key goes in the server's ~/.ssh/authorized_keys and the private key stays with you, ideally protected by a passphrase." },

    { "term": "Modal editing", "topic": "editors", "aliases": ["Normal mode", "Insert mode"], "def": "Vim's design where keys mean different things in different modes: Normal mode moves and operates on text, Insert mode types, Visual mode selects and Command-line mode runs : commands." },
    { "term": "Text object", "topic": "editors", "aliases": ["text objects"], "def": "A Vim selection described by structure, such as iw (inner word), i\" (inside quotes) or ap (a paragraph), used after an operator: ci\" changes the text inside the quotes." },
    { "term": "Dot repeat", "topic": "editors", "aliases": ["dot command"], "def": "In Vim, . repeats the last change, so an edit made once can be applied again anywhere with one key." },

    { "term": "Regular expression", "topic": "regex", "aliases": ["regex"], "def": "A pattern language for matching text: literals plus character classes like \\d, quantifiers like + and {2,5}, anchors like ^ and $, groups and alternation." },
    { "term": "Capture group", "topic": "regex", "aliases": ["named group"], "def": "Part of a pattern in parentheses whose matched text is kept, by number or by name ((?<year>\\d{4})), for use in code or in a replacement." },
    { "term": "Lookaround", "topic": "regex", "aliases": ["lookahead", "lookbehind"], "def": "Zero-width assertions that check what comes after ((?=...)) or before ((?<=...)) the current position without consuming any text." },
    { "term": "Lazy quantifier", "topic": "regex", "aliases": ["greedy", "non-greedy"], "def": "A greedy quantifier (*, +) matches as much as it can and gives back only as needed; a lazy one (*?, +?) matches as little as it can." },
    { "term": "Catastrophic backtracking", "topic": "regex", "aliases": ["ReDoS", "backtracking"], "def": "Exponential run time when a backtracking engine tries every way nested or overlapping quantifiers can split an input that fails, as with (a+)+$. Simplify the pattern and set a match timeout." },
    { "term": "Anchor", "topic": "regex", "aliases": ["word boundary"], "def": "A zero-width position in a pattern: ^ and $ match the start and end (of the string, or of each line in multiline mode) and \\b matches a word boundary." },

    { "term": "Primary key", "topic": "sql", "def": "The column or columns that uniquely identify each row of a table. It is never null and is normally backed by an index." },
    { "term": "Foreign key", "topic": "sql", "def": "A column whose values must match a key in another table, so the database refuses rows that point at nothing." },
    { "term": "Index", "topic": "sql", "aliases": ["B-tree", "database index"], "def": "A separate sorted structure (usually a B-tree) that lets the database find rows by a column's value without scanning the whole table, at the cost of slower writes and extra space." },
    { "term": "JOIN", "topic": "sql", "aliases": ["inner join", "left join"], "def": "Combining rows from two tables on a condition. INNER JOIN keeps only matching pairs; LEFT JOIN keeps every row from the left table and fills the missing right side with NULL." },
    { "term": "NULL", "topic": "sql", "def": "SQL's marker for a missing or unknown value. Comparing anything with NULL gives unknown, so test it with IS NULL; COUNT(column) skips NULLs." },
    { "term": "Normalization", "topic": "sql", "aliases": ["normal form", "denormalization"], "def": "Organising tables so each fact is stored once, moving repeated data into related tables, which prevents update anomalies. Denormalising later is a deliberate trade for read speed." },
    { "term": "Transaction", "topic": "sql", "def": "A group of statements that succeed or fail as one unit: either all of their changes are committed or none are." },
    { "term": "ACID", "topic": "sql", "def": "Atomicity, consistency, isolation and durability: a transaction applies completely or not at all, keeps the rules intact, is not disturbed by concurrent ones, and survives a crash once committed." },
    { "term": "Isolation level", "topic": "sql", "aliases": ["read committed", "serializable"], "def": "How much concurrent transactions see of each other's changes, from Read Uncommitted to Serializable. Lower levels allow anomalies such as non-repeatable reads in exchange for less blocking." },
    { "term": "N+1 query", "topic": "efcore", "aliases": ["N+1 problem", "n plus one"], "def": "Running one query for a list and then one more per item, so 100 rows cost 101 round trips. Fix it with a join, eager loading (Include) or one batched query." },
    { "term": "Query plan", "topic": "sql", "aliases": ["execution plan", "EXPLAIN", "EXPLAIN QUERY PLAN"], "def": "The steps the database chose to run a query, such as index seeks, scans and join methods, shown by EXPLAIN. It is where a slow query is diagnosed." },
    { "term": "SARGable", "topic": "sql", "def": "A condition the database can answer with an index seek, such as created_at >= @day. Wrapping the column in a function, as in YEAR(created_at) = 2026, usually forces a scan." },
    { "term": "GROUP BY", "topic": "sql", "aliases": ["HAVING", "aggregate"], "def": "Collapsing rows that share values into one row per group so aggregates such as COUNT and SUM are computed per group; HAVING then filters the groups." },
    { "term": "Window function", "topic": "sql", "aliases": ["OVER", "ROW_NUMBER", "PARTITION BY"], "def": "A function computed over rows related to the current one, written with OVER (PARTITION BY ... ORDER BY ...), such as ROW_NUMBER or a running SUM. Unlike GROUP BY it keeps every row." },
    { "term": "SQL injection", "topic": "sql", "aliases": ["injection"], "def": "An attack where user input pasted into SQL text changes the query. Prevent it with parameters, never by building SQL with string concatenation." },
    { "term": "Deadlock", "topic": "sql", "def": "Two or more transactions each holding a lock another needs, so none can continue. The database picks one as the victim and aborts it; the application should retry." },

    { "term": "DbContext", "topic": "efcore", "def": "EF Core's unit of work: it tracks the entities it loaded and saves their changes in one transaction with SaveChanges. Use one short-lived instance per request or operation." },
    { "term": "Change tracking", "topic": "efcore", "aliases": ["AsNoTracking"], "def": "EF Core remembering the original values of the entities it loaded, so SaveChanges writes only what changed. AsNoTracking skips it for read-only queries." },
    { "term": "Migration", "topic": "efcore", "aliases": ["migrations"], "def": "A generated, versioned description of a schema change, applied in order and recorded in a history table, so every database can be brought to the same version." },
    { "term": "Eager loading", "topic": "efcore", "aliases": ["Include"], "def": "Loading related entities in the same query with Include, avoiding the N+1 queries of lazy loading." },
    { "term": "Lazy loading", "topic": "efcore", "def": "Loading a navigation property automatically the first time it is read. Convenient, but inside a loop it silently becomes N+1 queries." },
    { "term": "Optimistic concurrency", "topic": "efcore", "aliases": ["concurrency token", "rowversion", "DbUpdateConcurrencyException"], "def": "Detecting conflicting edits by checking, when saving, that a version column still holds the value that was read; EF Core throws DbUpdateConcurrencyException when it does not." },
    { "term": "IQueryable", "topic": "efcore", "aliases": ["IQueryable<T>"], "def": "A query that has not run yet and is translated to SQL when enumerated. Filtering after it has become an IEnumerable happens in memory, after every row was loaded." },

    { "term": "Deferred execution", "topic": "csharp", "aliases": ["lazy evaluation"], "def": "A LINQ query does not run when it is written but each time it is enumerated, so it sees the data as it is then. Call ToList() to run it once and keep the results." },
    { "term": "LINQ", "topic": "csharp", "aliases": ["Language Integrated Query"], "def": "C#'s query operators (Where, Select, GroupBy, OrderBy and more) over in-memory sequences (IEnumerable) or translated to another language such as SQL (IQueryable)." },
    { "term": "async/await", "topic": "csharp", "aliases": ["async", "await"], "def": "C# syntax for asynchronous code: await hands the thread back while an operation such as I/O is pending, and the method resumes when it completes. It is about not blocking, not about running in parallel." },
    { "term": "Task", "topic": "csharp", "aliases": ["Task<T>"], "def": "A .NET object for an operation that completes in the future, with a result (Task<T>) or an exception. Await it; calling .Result or .Wait() blocks a thread and can deadlock." },
    { "term": "CancellationToken", "topic": "csharp", "aliases": ["cancellation"], "def": "A token passed into long or asynchronous operations so the caller can ask them to stop, for example when the HTTP request was aborted." },
    { "term": "Value type", "topic": "csharp", "aliases": ["struct", "reference type"], "def": "A value type (int, a struct) holds its data directly and is copied on assignment; a reference type (a class) is a reference to an object, so copies share the same object." },
    { "term": "Nullable reference types", "topic": "csharp", "aliases": ["nullable"], "def": "A C# compiler feature where string means never null and string? means may be null, with warnings wherever code could dereference null." },
    { "term": "Record", "topic": "csharp", "aliases": ["record type"], "def": "A C# type with value-based equality, a readable ToString and with-expressions for changed copies, ideal for immutable data such as DTOs and events." },
    { "term": "Generics", "topic": "csharp", "aliases": ["generic type"], "def": "Types and methods with type parameters (List<T>, Max<T>), so one implementation serves many types with compile-time type safety." },
    { "term": "Interface", "topic": "csharp", "def": "A contract of members a type promises to implement, so code can depend on a capability (IComparer<T>) rather than on a concrete class." },
    { "term": "Dependency injection", "topic": "csharp", "aliases": ["DI", "service lifetime", "scoped"], "def": "Giving an object its dependencies from outside, usually through its constructor, instead of creating them inside, so they can be swapped and tested. ASP.NET Core's container offers singleton, scoped and transient lifetimes." },
    { "term": "Garbage collector", "topic": "csharp", "aliases": ["GC", "garbage collection"], "def": "The .NET runtime component that reclaims the memory of objects nothing references any more. It works in generations, so short-lived objects are cheap." },
    { "term": "IDisposable", "topic": "csharp", "aliases": ["using statement", "Dispose"], "def": "The interface for objects holding resources that must be released promptly, such as files and connections; a using statement or declaration calls Dispose even when an exception is thrown." },
    { "term": "Exception", "topic": "csharp", "aliases": ["throw", "try/catch"], "def": "An object thrown to signal an error, unwinding the call stack to the nearest matching catch. Catch only what you can handle, and rethrow with throw; to keep the stack trace." },
    { "term": "Middleware", "topic": "csharp", "aliases": ["request pipeline"], "def": "A component in the ASP.NET Core request pipeline that handles a request and calls the next one, in order: exception handling, routing, authentication, authorization, then the endpoint." },
    { "term": "Race condition", "topic": "csharp", "aliases": ["data race"], "def": "A bug where the result depends on the timing of concurrent operations, such as two requests both reading a balance before either writes it back." },
    { "term": "Thread pool starvation", "topic": "csharp", "aliases": ["sync over async"], "def": "When thread-pool threads are all blocked, often by sync-over-async calls such as .Result, new work has to wait and the app stalls under load." },
    { "term": "Stack trace", "topic": "fundamentals", "aliases": ["call stack"], "def": "The list of calls in progress when an exception was thrown, innermost first, with files and line numbers. The first line from your own code is usually the place to look." },

    { "term": "Virtual environment", "topic": "python", "aliases": ["venv"], "def": "An isolated Python environment with its own installed packages, created with python -m venv .venv, so projects do not fight over versions." },
    { "term": "List comprehension", "topic": "python", "aliases": ["comprehension"], "def": "A compact expression that builds a list from an iterable with an optional filter: [x * 2 for x in xs if x > 0]." },
    { "term": "Generator", "topic": "python", "aliases": ["yield"], "def": "A function using yield that produces values lazily, one at a time, so a sequence can be processed without holding it all in memory." },
    { "term": "Decorator", "topic": "python", "def": "A function that takes a function and returns a wrapped one, applied with @name above a def, for cross-cutting concerns such as caching, retries or timing." },
    { "term": "GIL", "topic": "python", "aliases": ["global interpreter lock"], "def": "CPython's global interpreter lock lets only one thread run Python bytecode at a time, so threads help I/O-bound work but not CPU-bound work (use processes). Optional free-threaded builds exist from Python 3.13." },
    { "term": "Mutable default argument", "topic": "python", "def": "A default such as def f(items=[]) is created once, when the function is defined, and shared by every call, so changes leak between calls. Default to None and create the list inside." },
    { "term": "Type hints", "topic": "python", "aliases": ["type annotations", "mypy"], "def": "Annotations such as def total(xs: list[float]) -> float that document types for readers and checkers such as mypy. Python does not enforce them at run time." },

    { "term": "DataFrame", "topic": "datascience", "aliases": ["pandas"], "def": "pandas' two-dimensional table of labelled columns, each a typed Series, with an index labelling the rows." },
    { "term": "Vectorization", "topic": "datascience", "aliases": ["vectorized"], "def": "Applying an operation to whole arrays at once (df[\"a\"] * 2) instead of looping in Python, so it runs in optimised native code, often a hundred times faster." },
    { "term": "Broadcasting", "topic": "datascience", "def": "NumPy's rules for combining arrays of different shapes by stretching dimensions of size 1, so an array can be added to a scalar or a row to every row of a matrix." },
    { "term": "Overfitting", "topic": "datascience", "def": "A model learning the noise in its training data: it scores well there and badly on new data. A held-out test set or cross-validation reveals it." },
    { "term": "Train/test split", "topic": "datascience", "aliases": ["test set", "cross-validation"], "def": "Holding back part of the data that the model never sees while training, to measure how well it does on data it has not seen." },
    { "term": "Percentile", "topic": "datascience", "aliases": ["p95", "p99", "median"], "def": "The value below which a given share of observations fall; the median is the 50th. p99 latency is what the slowest 1% of requests exceed, which an average hides." },

    { "term": "Big O notation", "topic": "dsa", "aliases": ["Big-O", "time complexity", "complexity"], "def": "How an algorithm's time or memory grows with the input size, ignoring constant factors: O(1), O(log n), O(n), O(n log n), O(n²)." },
    { "term": "Hash table", "topic": "dsa", "aliases": ["hash map", "Dictionary"], "def": "A structure storing key-value pairs in buckets chosen by the key's hash, giving O(1) lookup, insert and delete on average. Keys need consistent equality and hash codes." },
    { "term": "Binary search", "topic": "dsa", "def": "Finding a value in a sorted array by halving the range each step, in O(log n): a million items take about 20 comparisons." },
    { "term": "Stack", "topic": "dsa", "aliases": ["LIFO"], "def": "A last-in, first-out collection (push and pop at one end), used for undo, parsing and the call stack." },
    { "term": "Queue", "topic": "dsa", "aliases": ["FIFO"], "def": "A first-in, first-out collection: add at the back, take from the front. Used for breadth-first search and work lists." },
    { "term": "Recursion", "topic": "dsa", "aliases": ["recursive", "base case"], "def": "A function solving a problem by calling itself on smaller instances until it reaches a base case. Each call uses stack space, so very deep recursion overflows the stack." },
    { "term": "Breadth-first search", "topic": "dsa", "aliases": ["BFS"], "def": "Exploring a graph level by level with a queue, which finds the shortest path in an unweighted graph." },
    { "term": "Depth-first search", "topic": "dsa", "aliases": ["DFS"], "def": "Exploring a graph by following one path as deep as it goes before backtracking, using recursion or a stack." },
    { "term": "Dynamic programming", "topic": "dsa", "aliases": ["memoization"], "def": "Solving a problem by combining the answers to overlapping subproblems, each computed once and stored in a table or memo." },
    { "term": "Heap", "topic": "dsa", "aliases": ["priority queue", "PriorityQueue"], "def": "A tree-shaped structure that always exposes its smallest (or largest) item in O(1) and inserts or removes in O(log n). .NET's PriorityQueue is one." },
    { "term": "Two pointers", "topic": "dsa", "def": "Walking two indexes through a sequence (from both ends, or at different speeds) to solve problems such as pair sums in O(n) instead of O(n²)." },

    { "term": "SOLID", "topic": "design", "def": "Five object-oriented design principles: single responsibility, open/closed, Liskov substitution, interface segregation and dependency inversion." },
    { "term": "Single responsibility principle", "topic": "design", "aliases": ["SRP"], "def": "A class or module should have one reason to change, so unrelated changes do not collide in the same code." },
    { "term": "Coupling", "topic": "design", "aliases": ["loose coupling"], "def": "How much one module depends on another's internals. Loosely coupled parts can change independently." },
    { "term": "Cohesion", "topic": "design", "def": "How closely the parts of a module belong together. A highly cohesive module does one coherent job." },
    { "term": "Code smell", "topic": "design", "aliases": ["smell"], "def": "A surface sign in code, such as a long method, duplicated logic or a class that knows too much, that often points to a deeper design problem worth refactoring." },
    { "term": "Refactoring", "topic": "design", "aliases": ["refactor"], "def": "Changing code's structure without changing its behaviour, in small safe steps backed by tests." },
    { "term": "Unit test", "topic": "design", "aliases": ["unit tests"], "def": "An automated test of one small piece of behaviour in isolation, fast enough to run on every change." },
    { "term": "Test double", "topic": "design", "aliases": ["mock", "stub", "fake"], "def": "A stand-in for a real dependency in a test: a stub returns canned answers, a mock also checks how it was called, and a fake is a working lightweight version such as an in-memory repository." },
    { "term": "DRY", "topic": "design", "aliases": ["don't repeat yourself"], "def": "Don't repeat yourself: every piece of knowledge should live in one authoritative place. Merging code that merely looks alike can be worse than the duplication." },
    { "term": "YAGNI", "topic": "design", "aliases": ["you aren't gonna need it"], "def": "You aren't gonna need it: do not build features or abstractions until a real need for them appears." },

    { "term": "Variable", "topic": "fundamentals", "def": "A named place that holds a value, which the program can read and change." },
    { "term": "Function", "topic": "fundamentals", "aliases": ["method", "parameter", "return value"], "def": "A named, reusable block of code that takes parameters and may return a value." },
    { "term": "Loop", "topic": "fundamentals", "aliases": ["for loop", "while loop", "foreach"], "def": "Code that repeats: for when you know the count, while until a condition changes, foreach over each item of a collection." },
    { "term": "Off-by-one error", "topic": "fundamentals", "aliases": ["off by one"], "def": "A bug where a loop or index goes one step too far or stops one short, typically from mixing up < and <= or counting from 1 instead of 0." },
    { "term": "Boolean", "topic": "fundamentals", "aliases": ["bool"], "def": "A value that is either true or false, produced by comparisons and combined with and, or and not." },
    { "term": "Variable scope", "topic": "fundamentals", "aliases": ["block scope"], "def": "The region of code where a name is visible: a variable declared inside a block cannot be used outside it." },

    { "term": "Event loop", "topic": "typescript", "def": "How JavaScript runs asynchronous code on one thread: after each task it runs every queued microtask (promise callbacks), then takes the next task such as a timer or I/O callback." },
    { "term": "Promise", "topic": "typescript", "def": "An object for a value that arrives later and ends up either fulfilled or rejected; then, catch and await consume it." },
    { "term": "Microtask", "topic": "typescript", "aliases": ["queueMicrotask"], "def": "A callback queued by a promise (or queueMicrotask) that runs as soon as the current task finishes, before any timer or I/O callback." },
    { "term": "Closure", "topic": "typescript", "def": "A function together with the variables it captured where it was created, which stay alive as long as the function does." },
    { "term": "Type narrowing", "topic": "typescript", "aliases": ["narrowing", "type guard"], "def": "TypeScript refining a union type inside a branch after a check such as typeof x === \"string\", a comparison of a discriminant field, or in." },
    { "term": "Union type", "topic": "typescript", "aliases": ["discriminated union"], "def": "A TypeScript type that is one of several (string | number); it must be narrowed before using members only some of them have." },
    { "term": "Strict equality", "topic": "typescript", "aliases": ["==="], "def": "=== compares without converting types, unlike ==, which coerces (0 == \"\" is true). Use === by default." },
    { "term": "unknown", "topic": "typescript", "aliases": ["any"], "def": "Like any, unknown accepts every value, but any switches type checking off while unknown forces a check before use, which makes it the safe type for untrusted input." }
  ]
}
