{
  "title": "Compare semantic versions",
  "summary": "Order release and pre-release versions exactly as Semantic Versioning 2.0 says.",
  "language": "csharp",
  "difficulty": "hard",
  "minutes": 15,
  "tags": [
    "parsing",
    "comparison",
    "versions"
  ],
  "prompt": [
    "Your deploy tool must pick the newest package version. Write",
    "`int CompareVersions(string a, string b)` that returns a negative number when `a` is older, zero when",
    "they have the same precedence, and a positive number when `a` is newer, following SemVer 2.0:",
    "",
    "- A version is `MAJOR.MINOR.PATCH`, optionally followed by `-prerelease` and/or `+build`.",
    "- Compare `MAJOR`, `MINOR`, `PATCH` **numerically** (`1.10.0` is newer than `1.9.0`).",
    "- A pre-release is older than the plain release: `1.0.0-rc.1 < 1.0.0`.",
    "- Pre-release identifiers (split on `.`) compare left to right: numeric identifiers numerically,",
    "  others by ASCII order, and **a numeric identifier is always lower than a non-numeric one**.",
    "  If all shared identifiers are equal, the version with fewer identifiers is older.",
    "- Build metadata (`+...`) is ignored: `1.0.0+build.1` and `1.0.0+build.2` compare equal.",
    "- Anything without exactly three numeric core parts (`\"1.2\"`, `\"1.2.x\"`, `\"\"`) throws `FormatException`.",
    "",
    "The spec's own example, oldest first:",
    "",
    "```text",
    "1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0",
    "```"
  ],
  "starter": [
    "int CompareVersions(string a, string b)",
    "{",
    "    return string.CompareOrdinal(a, b);",
    "}"
  ],
  "solution": [
    "int CompareVersions(string a, string b)",
    "{",
    "    var (coreA, preA) = ParseVersion(a);",
    "    var (coreB, preB) = ParseVersion(b);",
    "    for (var i = 0; i < 3; i++)",
    "        if (coreA[i] != coreB[i]) return coreA[i].CompareTo(coreB[i]);",
    "",
    "    // A release (no pre-release) outranks any pre-release of the same core.",
    "    if (preA.Length == 0 || preB.Length == 0) return preB.Length.CompareTo(preA.Length);",
    "",
    "    for (var i = 0; i < Math.Min(preA.Length, preB.Length); i++)",
    "    {",
    "        var x = preA[i];",
    "        var y = preB[i];",
    "        var xNumeric = x.All(char.IsAsciiDigit);",
    "        var yNumeric = y.All(char.IsAsciiDigit);",
    "        var c = (xNumeric, yNumeric) switch",
    "        {",
    "            (true, true) => decimal.Parse(x).CompareTo(decimal.Parse(y)),",
    "            (true, false) => -1,",
    "            (false, true) => 1,",
    "            _ => string.CompareOrdinal(x, y),",
    "        };",
    "        if (c != 0) return c;",
    "    }",
    "    return preA.Length.CompareTo(preB.Length);",
    "}",
    "",
    "(long[] Core, string[] Pre) ParseVersion(string version)",
    "{",
    "    var v = version;",
    "    var plus = v.IndexOf('+');",
    "    if (plus >= 0) v = v[..plus];",
    "    var dash = v.IndexOf('-');",
    "    var core = dash >= 0 ? v[..dash] : v;",
    "    var pre = dash >= 0 ? v[(dash + 1)..].Split('.') : Array.Empty<string>();",
    "    var parts = core.Split('.');",
    "    if (parts.Length != 3 || !parts.All(p => p.Length > 0 && p.All(char.IsAsciiDigit)))",
    "        throw new FormatException($\"'{version}' is not MAJOR.MINOR.PATCH\");",
    "    if (pre.Any(p => p.Length == 0))",
    "        throw new FormatException($\"'{version}' has an empty pre-release identifier\");",
    "    return (parts.Select(long.Parse).ToArray(), pre);",
    "}"
  ],
  "template": [
    "{{CODE}}",
    "int DojoCmp(string a, string b) => Math.Sign(CompareVersions(a, b));",
    "Dojo.Try(\"core versions\", () =>",
    "{",
    "    Dojo.Eq(\"1.9.0 < 1.10.0 (numeric, not text)\", -1, DojoCmp(\"1.9.0\", \"1.10.0\"));",
    "    Dojo.Eq(\"2.0.0 > 1.99.99\", 1, DojoCmp(\"2.0.0\", \"1.99.99\"));",
    "    Dojo.Eq(\"equal versions compare 0\", 0, DojoCmp(\"3.4.5\", \"3.4.5\"));",
    "});",
    "Dojo.Try(\"pre-releases\", () =>",
    "{",
    "    Dojo.Eq(\"1.0.0-rc.1 < 1.0.0 (pre-release is older)\", -1, DojoCmp(\"1.0.0-rc.1\", \"1.0.0\"));",
    "    Dojo.Eq(\"1.0.0 > 1.0.0-alpha\", 1, DojoCmp(\"1.0.0\", \"1.0.0-alpha\"));",
    "    Dojo.Eq(\"1.0.0-beta.2 < 1.0.0-beta.11 (numeric identifiers)\", -1, DojoCmp(\"1.0.0-beta.2\", \"1.0.0-beta.11\"));",
    "    Dojo.Eq(\"1.0.0-alpha.1 < 1.0.0-alpha.beta (numeric below text)\", -1, DojoCmp(\"1.0.0-alpha.1\", \"1.0.0-alpha.beta\"));",
    "    Dojo.Eq(\"1.0.0-alpha < 1.0.0-alpha.1 (fewer identifiers is older)\", -1, DojoCmp(\"1.0.0-alpha\", \"1.0.0-alpha.1\"));",
    "    Dojo.Eq(\"1.0.0-1 < 1.0.0-alpha\", -1, DojoCmp(\"1.0.0-1\", \"1.0.0-alpha\"));",
    "});",
    "Dojo.Try(\"build metadata is ignored\", () =>",
    "{",
    "    Dojo.Eq(\"1.0.0+build.1 == 1.0.0+build.2\", 0, DojoCmp(\"1.0.0+build.1\", \"1.0.0+build.2\"));",
    "    Dojo.Eq(\"1.0.0-rc.1+exp.sha.5114f85 == 1.0.0-rc.1\", 0, DojoCmp(\"1.0.0-rc.1+exp.sha.5114f85\", \"1.0.0-rc.1\"));",
    "});",
    "Dojo.Try(\"sorting the spec example\", () =>",
    "{",
    "    var dojoList = new List<string> { \"1.10.0\", \"1.0.0-beta.11\", \"1.0.0\", \"2.0.0\", \"1.0.0-alpha.beta\", \"1.0.0-rc.1\", \"1.0.0-alpha\", \"1.9.0\", \"1.0.0-beta.2\", \"1.0.0-alpha.1\", \"1.0.0-beta\" };",
    "    dojoList.Sort((x, y) => CompareVersions(x, y));",
    "    Dojo.Eq(\"oldest to newest\", new List<string> { \"1.0.0-alpha\", \"1.0.0-alpha.1\", \"1.0.0-alpha.beta\", \"1.0.0-beta\", \"1.0.0-beta.2\", \"1.0.0-beta.11\", \"1.0.0-rc.1\", \"1.0.0\", \"1.9.0\", \"1.10.0\", \"2.0.0\" }, dojoList);",
    "});",
    "Dojo.Throws<FormatException>(\"\\\"1.2\\\" is rejected\", () => CompareVersions(\"1.2\", \"1.2.0\"));",
    "Dojo.Throws<FormatException>(\"\\\"1.2.x\\\" is rejected\", () => CompareVersions(\"1.2.0\", \"1.2.x\"));"
  ],
  "wrong": [
    [
      "int CompareVersions(string a, string b)",
      "{",
      "    string Strip(string v) => v.Split('+')[0];",
      "    var pa = Strip(a).Split('-', 2);",
      "    var pb = Strip(b).Split('-', 2);",
      "    var ca = pa[0].Split('.').Select(int.Parse).ToArray();",
      "    var cb = pb[0].Split('.').Select(int.Parse).ToArray();",
      "    if (ca.Length != 3 || cb.Length != 3) throw new FormatException();",
      "    for (var i = 0; i < 3; i++)",
      "        if (ca[i] != cb[i]) return ca[i].CompareTo(cb[i]);",
      "    if (pa.Length == 1 || pb.Length == 1) return pb.Length.CompareTo(pa.Length);",
      "    return string.CompareOrdinal(pa[1], pb[1]);",
      "}"
    ],
    [
      "int CompareVersions(string a, string b)",
      "{",
      "    var ca = a.Split('+')[0].Split('-')[0];",
      "    var cb = b.Split('+')[0].Split('-')[0];",
      "    if (ca.Split('.').Length != 3 || cb.Split('.').Length != 3) throw new FormatException();",
      "    var c = string.CompareOrdinal(ca, cb);",
      "    if (c != 0) return c;",
      "    return string.CompareOrdinal(a.Split('+')[0], b.Split('+')[0]);",
      "}"
    ]
  ],
  "hints": [
    "Strip `+build` first, then split off the pre-release at the first `-`, then split the core on `.`.",
    "No pre-release beats any pre-release: handle 'one side has none' before comparing identifiers.",
    "Per identifier: both numeric -> compare as numbers; one numeric -> it is lower; else `string.CompareOrdinal`. If all match, the shorter list is lower."
  ]
}
