{
  "title": "Parse a duration string",
  "summary": "Turn config values like \"1h30m15s\" into a TimeSpan and reject sloppy input.",
  "language": "csharp",
  "difficulty": "easy",
  "minutes": 8,
  "tags": [
    "parsing",
    "config",
    "time"
  ],
  "prompt": [
    "Timeouts in your service config are written like `\"1h30m15s\"`, `\"45s\"` or `\"2d\"`. Write",
    "`TimeSpan ParseDuration(string text)`.",
    "",
    "- Units are `d` (days), `h`, `m` and `s`, each preceded by a whole number of digits: `\"90m\"` is 90 minutes.",
    "- Each unit appears **at most once** and **in that order** (d, h, m, s). Any unit may be left out, but at least one must be present.",
    "- No spaces, signs or decimals.",
    "- Anything else throws `FormatException`: `\"\"`, `\"1h30\"` (a number with no unit), `\"30m1h\"` (wrong order),",
    "  `\"1h1h\"`, `\"5x\"`, `\"h\"`.",
    "",
    "```text",
    "\"1h30m15s\" -> 01:30:15      \"1d2h\" -> 1.02:00:00      \"0s\" -> 00:00:00",
    "```"
  ],
  "starter": [
    "TimeSpan ParseDuration(string text)",
    "{",
    "    return TimeSpan.Zero;",
    "}"
  ],
  "solution": [
    "TimeSpan ParseDuration(string text)",
    "{",
    "    var match = System.Text.RegularExpressions.Regex.Match(text, @\"^(?:(\\d+)d)?(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$\");",
    "    if (text.Length == 0 || !match.Success) throw new FormatException($\"'{text}' is not a duration like 1h30m\");",
    "    long Part(int group) => match.Groups[group].Success ? long.Parse(match.Groups[group].Value) : 0;",
    "    return TimeSpan.FromDays(Part(1)) + TimeSpan.FromHours(Part(2)) + TimeSpan.FromMinutes(Part(3)) + TimeSpan.FromSeconds(Part(4));",
    "}"
  ],
  "template": [
    "{{CODE}}",
    "Dojo.Eq(\"\\\"1h30m15s\\\"\", new TimeSpan(1, 30, 15), ParseDuration(\"1h30m15s\"));",
    "Dojo.Eq(\"\\\"45s\\\"\", TimeSpan.FromSeconds(45), ParseDuration(\"45s\"));",
    "Dojo.Eq(\"\\\"90m\\\" is not normalised away\", TimeSpan.FromMinutes(90), ParseDuration(\"90m\"));",
    "Dojo.Eq(\"\\\"1d2h\\\"\", TimeSpan.FromHours(26), ParseDuration(\"1d2h\"));",
    "Dojo.Eq(\"\\\"0s\\\"\", TimeSpan.Zero, ParseDuration(\"0s\"));",
    "Dojo.Throws<FormatException>(\"\\\"\\\" is rejected\", () => ParseDuration(\"\"));",
    "Dojo.Throws<FormatException>(\"\\\"1h30\\\" (number without unit) is rejected\", () => ParseDuration(\"1h30\"));",
    "Dojo.Throws<FormatException>(\"\\\"30m1h\\\" (wrong order) is rejected\", () => ParseDuration(\"30m1h\"));",
    "Dojo.Throws<FormatException>(\"\\\"1h1h\\\" (repeated unit) is rejected\", () => ParseDuration(\"1h1h\"));",
    "Dojo.Throws<FormatException>(\"\\\"5x\\\" (unknown unit) is rejected\", () => ParseDuration(\"5x\"));",
    "Dojo.Throws<FormatException>(\"\\\"h\\\" (unit without number) is rejected\", () => ParseDuration(\"h\"));"
  ],
  "wrong": [
    [
      "TimeSpan ParseDuration(string text)",
      "{",
      "    var total = TimeSpan.Zero;",
      "    var found = false;",
      "    foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(text, @\"(\\d+)([dhms])\"))",
      "    {",
      "        found = true;",
      "        var n = long.Parse(m.Groups[1].Value);",
      "        total += m.Groups[2].Value switch",
      "        {",
      "            \"d\" => TimeSpan.FromDays(n),",
      "            \"h\" => TimeSpan.FromHours(n),",
      "            \"m\" => TimeSpan.FromMinutes(n),",
      "            _ => TimeSpan.FromSeconds(n),",
      "        };",
      "    }",
      "    if (!found) throw new FormatException(text);",
      "    return total;",
      "}"
    ],
    [
      "TimeSpan ParseDuration(string text)",
      "{",
      "    var match = System.Text.RegularExpressions.Regex.Match(text, @\"^(?:(\\d+)d)?(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$\");",
      "    if (!match.Success) throw new FormatException(text);",
      "    long Part(int group) => match.Groups[group].Success ? long.Parse(match.Groups[group].Value) : 0;",
      "    return new TimeSpan((int)Part(1), (int)Part(2) % 24, (int)Part(3) % 60, (int)Part(4) % 60);",
      "}"
    ]
  ],
  "hints": [
    "One anchored regular expression with four optional groups, in order, describes every valid input.",
    "`^(?:(\\d+)d)?(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$` also matches the empty string, so reject that separately.",
    "Add the parts with `TimeSpan.FromDays`, `FromHours`, ... so `90m` stays 90 minutes."
  ]
}
