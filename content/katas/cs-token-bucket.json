{
  "title": "Token-bucket rate limiter",
  "summary": "Allow short bursts but enforce an average request rate, with a clock you can control.",
  "language": "csharp",
  "difficulty": "medium",
  "minutes": 12,
  "tags": [
    "rate limiting",
    "time",
    "classes"
  ],
  "prompt": [
    "Your public API allows bursts of up to 5 requests and then about 1 request per second. Write",
    "`class TokenBucket`:",
    "",
    "```csharp",
    "long now = 0;",
    "var bucket = new TokenBucket(capacity: 5, refillPerSecond: 1.0, nowMs: () => now);",
    "bucket.TryTake();   // true: the bucket starts full",
    "```",
    "",
    "- `TokenBucket(int capacity, double refillPerSecond, Func<long> nowMs)`: `nowMs` returns the current time in",
    "  milliseconds. **Always read time through it**, never `DateTime.Now`: the tests move the clock by hand.",
    "- The bucket starts with `capacity` tokens and refills **continuously** at `refillPerSecond`",
    "  (half a second at 1 token/s adds 0.5 tokens; fractions accumulate).",
    "- It never holds more than `capacity` tokens, however long it sits idle.",
    "- `bool TryTake(int count = 1)`: if at least `count` tokens are available, remove them and return `true`;",
    "  otherwise return `false` and **remove nothing**. `count` below 1 throws `ArgumentOutOfRangeException`."
  ],
  "starter": [
    "class TokenBucket",
    "{",
    "    public TokenBucket(int capacity, double refillPerSecond, Func<long> nowMs) { }",
    "",
    "    public bool TryTake(int count = 1) => true;",
    "}"
  ],
  "solution": [
    "class TokenBucket",
    "{",
    "    readonly int capacity;",
    "    readonly double refillPerSecond;",
    "    readonly Func<long> nowMs;",
    "    double tokens;",
    "    long last;",
    "",
    "    public TokenBucket(int capacity, double refillPerSecond, Func<long> nowMs)",
    "    {",
    "        ArgumentOutOfRangeException.ThrowIfLessThan(capacity, 1);",
    "        this.capacity = capacity;",
    "        this.refillPerSecond = refillPerSecond;",
    "        this.nowMs = nowMs;",
    "        tokens = capacity;",
    "        last = nowMs();",
    "    }",
    "",
    "    public bool TryTake(int count = 1)",
    "    {",
    "        ArgumentOutOfRangeException.ThrowIfLessThan(count, 1);",
    "        var now = nowMs();",
    "        tokens = Math.Min(capacity, tokens + (now - last) * refillPerSecond / 1000.0);",
    "        last = now;",
    "        if (tokens < count) return false;",
    "        tokens -= count;",
    "        return true;",
    "    }",
    "}"
  ],
  "template": [
    "long dojoNow = 0;",
    "Dojo.Try(\"bursts and refills\", () =>",
    "{",
    "    var dojoB = new TokenBucket(5, 1.0, () => dojoNow);",
    "    var dojoBurst = Enumerable.Range(0, 6).Select(_ => dojoB.TryTake()).ToList();",
    "    Dojo.Eq(\"starts full: 5 allowed, the 6th refused\", new List<bool> { true, true, true, true, true, false }, dojoBurst);",
    "    dojoNow += 1000;",
    "    Dojo.Check(\"one second later, one more is allowed\", dojoB.TryTake(), \"\");",
    "    Dojo.Check(\"...and only one\", !dojoB.TryTake(), \"\");",
    "    dojoNow += 500;",
    "    Dojo.Check(\"half a token is not enough\", !dojoB.TryTake(), \"\");",
    "    dojoNow += 500;",
    "    Dojo.Check(\"two halves make a token (fractions accumulate)\", dojoB.TryTake(), \"\");",
    "});",
    "Dojo.Try(\"never more than capacity\", () =>",
    "{",
    "    dojoNow = 0;",
    "    var dojoB = new TokenBucket(3, 2.0, () => dojoNow);",
    "    dojoB.TryTake(3);",
    "    dojoNow += 60_000;",
    "    var dojoAfterIdle = Enumerable.Range(0, 4).Select(_ => dojoB.TryTake()).ToList();",
    "    Dojo.Eq(\"a minute idle still gives only 3\", new List<bool> { true, true, true, false }, dojoAfterIdle);",
    "});",
    "Dojo.Try(\"a refused take costs nothing\", () =>",
    "{",
    "    dojoNow = 0;",
    "    var dojoB = new TokenBucket(4, 1.0, () => dojoNow);",
    "    dojoB.TryTake(2);",
    "    Dojo.Check(\"TryTake(3) with 2 left is refused\", !dojoB.TryTake(3), \"\");",
    "    Dojo.Check(\"the 2 tokens are still there\", dojoB.TryTake(2), \"\");",
    "});",
    "Dojo.Throws<ArgumentOutOfRangeException>(\"TryTake(0) is rejected\", () => new TokenBucket(1, 1, () => 0).TryTake(0));",
    "{{CODE}}"
  ],
