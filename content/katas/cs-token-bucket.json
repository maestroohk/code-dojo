  "hints": [
    "Keep two fields: the tokens you had at the last call (a `double`) and when that was.",
    "On every `TryTake`, first add `elapsedMs * refillPerSecond / 1000` tokens, cap at `capacity`, and remember the new time.",
    "Only subtract when there are enough tokens; a refused request must leave the count unchanged."
  ]
}
