#!/usr/bin/env python3
# crumb-collector: starts a helper and never collects its exit status (it never calls wait()).
# The finished helper stays in the process table as a zombie for as long as this parent lives.
import os
import time

if os.fork() == 0:
    os._exit(0)          # the helper finishes at once
while True:
    time.sleep(60)       # ...and the parent never calls os.wait()
