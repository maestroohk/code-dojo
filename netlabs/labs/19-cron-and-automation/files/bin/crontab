#!/bin/bash
# crontab for minicron: the same options as the classic command.
#   crontab -l          list my crontab
#   crontab -r          remove it (no confirmation!)
#   crontab FILE        install FILE as my crontab (after a syntax check)
#   crontab -           install what arrives on standard input
#   crontab -e          edit it (needs a full-screen terminal)
#   -u USER             act on another user's crontab (root only)
spool=/var/spool/cron/crontabs
user=$(id -un)
action=
file=
while [ $# -gt 0 ]; do
  case "$1" in
    -u) user=$2; shift 2 ;;
    -l|-r|-e|-i) action=$1; shift ;;
    -) file=-; shift ;;
    -*) echo "crontab: invalid option -- '${1#-}'" >&2; echo "usage: crontab [-u user] { -l | -r | -e | file | - }" >&2; exit 1 ;;
    *) file=$1; shift ;;
  esac
done
tab=$spool/$user
mkdir -p "$spool"

install_tab() {   # $1: a temporary file holding the new crontab
  if ! python3 /usr/local/sbin/minicron --check < "$1"; then
    echo "errors in crontab file, can't install." >&2
    rm -f "$1"
    return 1
  fi
  mv "$1" "$tab" && chmod 600 "$tab"
}

case "$action" in
  -l)
    if [ -s "$tab" ]; then cat "$tab"; else echo "no crontab for $user" >&2; exit 1; fi ;;
  -r|-i)
    if [ -e "$tab" ]; then rm -f "$tab"; else echo "no crontab for $user" >&2; exit 1; fi ;;
  -e)
    echo "crontab: -e opens a full-screen editor, and this terminal is line based." >&2
    echo "         Add a job in one line:   (crontab -l; echo '*/5 * * * * /path/to/job') | crontab -" >&2
    echo "         Remove one:              crontab -l | grep -v 'some-job' | crontab -" >&2
    echo "         Or write a file and install it:  crontab -l > /tmp/my.cron; ...; crontab /tmp/my.cron" >&2
    exit 1 ;;
  *)
    if [ -z "$file" ]; then echo "usage: crontab [-u user] { -l | -r | -e | file | - }" >&2; exit 1; fi
    tmp=$(mktemp)
    if [ "$file" = - ]; then cat > "$tmp"; elif [ -r "$file" ]; then cat "$file" > "$tmp"; else echo "crontab: $file: No such file or directory" >&2; rm -f "$tmp"; exit 1; fi
    install_tab "$tmp" ;;
esac
