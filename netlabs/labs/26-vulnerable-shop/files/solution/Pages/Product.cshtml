@page "/products/{id:int}"
@model Shop.Pages.ProductModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>@Model.Name · Lamp Shop</title>
  <link rel="stylesheet" href="/site.css">
</head>
<body>
<nav><a href="/">Lamp Shop</a> <a href="/account">Account</a> <a href="/login">Sign in</a> <a href="/logout">Sign out</a></nav>
<main>
  <h1>@Model.Name</h1>
  <p>@Model.Description</p>
  <p class="price">@Model.Price</p>

  <h2>Reviews</h2>
  @foreach (var r in Model.Reviews)
  {
    <article class="review" id="review-@r.Id">
      <header><strong>@r.Author</strong> <time>@r.Date</time></header>
      @* Razor HTML-encodes @r.Body: <script> arrives as &lt;script&gt; and shows as text. If formatting is ever
         needed again, run the HTML through an allow-list sanitizer (for example the HtmlSanitizer package) before
         Html.Raw, never Html.Raw on what a user typed. *@
      <div class="body">@r.Body</div>
    </article>
  }

  @if (Model.SignedInAs is not null)
  {
    <form id="review-form">
      <label>Your review <textarea name="body" rows="3"></textarea></label>
      <button>Post review</button>
    </form>
  }
  else
  {
    <p><a href="/login?next=/products/@Model.Id">Sign in</a> to write a review.</p>
  }
</main>
<script nonce="@Shop.Csp.Nonce(HttpContext)">
  const form = document.getElementById('review-form');
  if (form) form.addEventListener('submit', async e => {
    e.preventDefault();
    const res = await fetch('/api/reviews', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: @Model.Id, body: form.body.value })
    });
    if (res.ok) location.reload(); else alert('Could not post the review.');
  });
  document.body.dataset.ready = '1';
</script>
</body>
</html>
