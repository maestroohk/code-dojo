#!/bin/bash
# listen (on the attacker host): a web server on port 8000 that serves ~/www and logs every request it gets
# to ~/listen.log. It runs in the background; run `listen` again to see whether it is up, `listen stop` to stop it.
mkdir -p /root/www
if [ "${1:-}" = "stop" ]; then pkill -f 'http.server 8000' && echo "listen: stopped"; exit 0; fi
if pgrep -f 'http.server 8000' >/dev/null; then
  echo "listen: already serving /root/www on http://attacker:8000/  (requests: tail ~/listen.log)"
  exit 0
fi
nohup python3 -u -m http.server 8000 --directory /root/www >> /root/listen.log 2>&1 &
sleep 0.5
echo "listen: serving /root/www on http://attacker:8000/ ; every request is logged to ~/listen.log"
echo "        watch it with: tail -n 20 ~/listen.log   (or tail -f ~/listen.log in a second terminal)"
