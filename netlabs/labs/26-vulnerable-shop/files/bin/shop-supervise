#!/bin/bash
# Keeps the shop running: starts the newest build as the shopsvc user, and starts it again whenever it stops
# (shop-rebuild stops it after a successful build). Started once by /lab/init/shop.sh.
token=$(cat /opt/dojo/deploy-token)
while true; do
  if [ ! -f /work/build/current/Shop.dll ]; then sleep 2; continue; fi
  echo "=== $(date '+%F %T') starting the shop" >> /work/logs/shop.log
  cd /work/build/current
  env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/shopsvc DOTNET_CLI_TELEMETRY_OPTOUT=1 \
      ASPNETCORE_URLS=http://0.0.0.0:8080 ASPNETCORE_ENVIRONMENT=Production DEPLOY_TOKEN="$token" \
      setpriv --reuid=shopsvc --regid=shopsvc --init-groups dotnet /work/build/current/Shop.dll >> /work/logs/shop.log 2>&1 &
  echo $! > /run/shop.pid
  wait $!
  echo "=== $(date '+%F %T') the shop stopped" >> /work/logs/shop.log
  sleep 1
done
