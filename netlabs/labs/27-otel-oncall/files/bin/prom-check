#!/bin/bash
# prom-check 'PROMQL' 'JQ_FILTER'  -  an instant query whose .data.result passes jq -e FILTER.
# prom-check --api PATH 'JQ_FILTER'  -  any other API path (rules, alerts, targets), filter on .data.
if [ "$1" = --api ]; then
  out=$(curl -s -m 10 "http://prometheus:9090/api/v1/$2")
  printf '%s' "$out" | jq -e ".data | $3" >/dev/null 2>&1
else
  out=$(curl -sG -m 10 http://prometheus:9090/api/v1/query --data-urlencode "query=$1")
  printf '%s' "$out" | jq -e ".data.result | $2" >/dev/null 2>&1
fi
