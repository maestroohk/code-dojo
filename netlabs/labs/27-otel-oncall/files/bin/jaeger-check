#!/bin/bash
# jaeger-check SERVICE SECONDS 'JQ_FILTER' [OPERATION]
# Fetches SERVICE's spans from the last SECONDS (the `spans` helper, Jaeger API v3) and tests the array
# with jq -e FILTER. Each span: { trace, span, parent, service, resource, scope, name, kind, status, ms, attrs,
# types } (types: each attribute's OTLP value type, e.g. "intValue", "stringValue").
if [ $# -lt 3 ]; then echo "usage: jaeger-check SERVICE SECONDS JQ_FILTER [OPERATION]" >&2; exit 2; fi
NUM_TRACES=${NUM_TRACES:-100} spans "$1" "$2" "$4" --json | jq -e "$3" >/dev/null 2>&1
