#!/bin/bash
# The shop's customers: about three requests a second, a mix of browsing, product pages and checkouts.
# Wait until the shop can reach its database (PostgreSQL loads its data on first start).
until curl -sf -m 5 -o /dev/null http://shop:8080/api/products; do sleep 2; done
payments=(card card card paypal voucher)
while true; do
  r=$((RANDOM % 10))
  if [ $r -lt 3 ]; then
    curl -s -m 5 -o /dev/null http://shop:8080/api/products
  elif [ $r -lt 7 ]; then
    curl -s -m 5 -o /dev/null "http://shop:8080/api/products/$((1 + RANDOM % 40))"
  else
    lines=$((1 + RANDOM % 3)); items=""
    for i in $(seq 1 $lines); do items="$items${items:+,}{\"sku\":$((1 + RANDOM % 40)),\"qty\":$((1 + RANDOM % 3))}"; done
    curl -s -m 5 -o /dev/null -H 'content-type: application/json' -X POST http://shop:8080/api/checkout \
      -d "{\"customer\":$((1000 + RANDOM % 4000)),\"payment\":\"${payments[RANDOM % 5]}\",\"items\":[$items]}"
  fi
  sleep 0.3
done
