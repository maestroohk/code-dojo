#!/bin/bash
# promq 'PROMQL'  -  run an instant query against Prometheus and print one line per series:
#   {labels}  value
# It is curl + jq on the HTTP API (GET /api/v1/query), nothing more:
#   curl -sG http://prometheus:9090/api/v1/query --data-urlencode 'query=up' | jq
if [ $# -lt 1 ]; then echo "usage: promq 'PROMQL'" >&2; exit 2; fi
out=$(curl -sG -m 10 http://prometheus:9090/api/v1/query --data-urlencode "query=$1")
if [ "$(printf '%s' "$out" | jq -r .status 2>/dev/null)" != success ]; then
  printf '%s\n' "$out" | jq -r '.error // .' 2>/dev/null || printf '%s\n' "$out"; exit 1
fi
printf '%s' "$out" | jq -r '.data.result[] | "\(.metric | del(.__name__) | to_entries | map("\(.key)=\"\(.value)\"") | join(", ") | "{" + . + "}")  \(.value[1])"'
