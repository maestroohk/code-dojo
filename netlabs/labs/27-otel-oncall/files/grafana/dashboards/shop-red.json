{
  "uid": "shop-red",
  "title": "Shop: RED overview",
  "tags": ["shop", "red", "slo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      { "name": "service", "type": "query", "datasource": { "type": "prometheus", "uid": "prom" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count, job)", "refId": "svc" },
        "definition": "label_values(http_server_request_duration_seconds_count, job)",
        "current": { "text": "shop", "value": "shop" }, "refresh": 2, "includeAll": false }
    ]
  },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Rate: requests per second by route", "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$service\"}[1m]))", "legendFormat": "{{http_route}}" } ] },
    { "id": 2, "type": "timeseries", "title": "Errors: share of 5xx responses by route", "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$service\", http_response_status_code=~\"5..\"}[1m])) / sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$service\"}[1m]))", "legendFormat": "{{http_route}}" } ] },
    { "id": 3, "type": "timeseries", "title": "Duration: p95 latency by route", "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "exemplar": true, "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"$service\"}[1m])))", "legendFormat": "{{http_route}}" } ] },
    { "id": 4, "type": "timeseries", "title": "Checkout error budget burn rate (SLO 99.9%)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "x", "min": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 } ] },
        "custom": { "thresholdsStyle": { "mode": "line" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"shop\", http_route=\"/api/checkout\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"shop\", http_route=\"/api/checkout\"}[5m]))) / 0.001", "legendFormat": "burn rate, 5m window" },
        { "refId": "B", "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"shop\", http_route=\"/api/checkout\", http_response_status_code=~\"5..\"}[1h])) / sum(rate(http_server_request_duration_seconds_count{job=\"shop\", http_route=\"/api/checkout\"}[1h]))) / 0.001", "legendFormat": "burn rate, 1h window" } ] },
    { "id": 5, "type": "timeseries", "title": "Orders by payment method and outcome", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (app_payment_method, app_order_status) (rate(app_orders_total[1m]))", "legendFormat": "{{app_payment_method}} {{app_order_status}}" } ] },
    { "id": 6, "type": "stat", "title": "Series behind app_orders_total", "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 500 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "count(app_orders_total)", "legendFormat": "series" } ] },
    { "id": 7, "type": "logs", "title": "Shop errors (Loki)", "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "refId": "A", "expr": "{service_name=~\"shop|inventory\"} | detected_level=~\"error|warn\"" } ] }
  ]
}
