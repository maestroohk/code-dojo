# Settings for the shop service (the storefront API). Saving this file restarts the shop.
# The OpenTelemetry SDK reads the OTEL_* variables itself (see the SDK's environment variable docs).
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=lab
INVENTORY_URL=http://inventory:8080
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__System=Warning
