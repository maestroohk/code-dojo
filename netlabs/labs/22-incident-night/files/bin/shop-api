#!/usr/bin/env python3
"""shop-api: Byte & Biscuit's web shop. Reads /etc/shop/shop.conf, opens a session store on the data disk,
then serves HTTP on the configured port. GET /health answers OK."""
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "/etc/shop/shop.conf"
DATA = "/srv/shop/data"


def read_config(path):
    conf = {}
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                key, value = (p.strip() for p in line.split("=", 1))
                conf[key] = value
    return conf


class Shop(BaseHTTPRequestHandler):
    server_version = "shop-api/2.4"

    def log_message(self, fmt, *args):
        sys.stdout.write("%s %s\n" % (self.address_string(), fmt % args))
        sys.stdout.flush()

    def do_GET(self):
        if self.path == "/health":
            body, code = b"OK\n", 200
        elif self.path == "/":
            body, code = ("Byte & Biscuit shop. Flavour of the day: %s\n" % FLAVOUR).encode(), 200
        else:
            body, code = b"not found\n", 404
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


print("shop-api 2.4 starting, reading %s" % CONF, flush=True)
conf = read_config(CONF)
port = int(conf.get("port", "0"))
if not 1 <= port <= 65535:
    raise ValueError("port %d in %s is out of range (1-65535)" % (port, CONF))
FLAVOUR = conf.get("flavour_of_the_day", "plain")

# The session store: a file per worker on the data disk. A full disk stops the shop here.
os.makedirs(os.path.join(DATA, "sessions"), exist_ok=True)
with open(os.path.join(DATA, "sessions", "worker-%d.session" % os.getpid()), "w") as f:
    f.write("x" * 65536)

server = ThreadingHTTPServer(("0.0.0.0", port), Shop)
print("shop-api listening on port %d" % port, flush=True)
server.serve_forever()
