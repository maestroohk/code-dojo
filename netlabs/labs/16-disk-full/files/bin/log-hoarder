#!/bin/bash
# log-hoarder: Gary's debug logger. It opened a 10 MB debug log, then Gary deleted the file to "free space".
# The process never closed it, so the space stays in use until the process lets go.
f=/srv/data/logs/gary-debug.log
head -c 10M /dev/zero > "$f"
exec 4>>"$f"
rm -f "$f"
while :; do
  sleep 5 4>&-
done
