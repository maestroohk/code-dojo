#!/bin/bash
# api-check PATH JQ_FILTER [JSON_BODY]
# Calls the RabbitMQ management API (http://rabbit:15672/api/PATH, as guest) and tests the answer with
# jq -e FILTER. With a body it POSTs (publish, get), otherwise it GETs. Exit code 0 when the filter is true.
#   api-check queues/%2F/orders.dlq '.messages == 0'
if [ $# -lt 2 ]; then echo "usage: api-check PATH JQ_FILTER [JSON_BODY]" >&2; exit 2; fi
url="http://rabbit:15672/api/$1"
if [ -n "$3" ]; then
  out=$(curl -s -m 10 -u guest:guest -H 'content-type: application/json' -X POST "$url" -d "$3")
else
  out=$(curl -s -m 10 -u guest:guest "$url")
fi
if [ -z "$out" ]; then echo "api-check: no answer from $url" >&2; exit 1; fi
printf '%s' "$out" | jq -e "$2" >/dev/null 2>&1
