#!/bin/bash
# group-lag GROUP [TOPIC]: the total lag (sum of the LAG column) of consumer group GROUP on TOPIC
# (default: orders). Prints "none" when the group has no committed offsets on that topic.
if [ -z "$1" ]; then echo "usage: group-lag GROUP [TOPIC]" >&2; exit 2; fi
kafka-consumer-groups.sh --bootstrap-server kafka:9092 --describe --group "$1" 2>/dev/null \
  | awk -v t="${2:-orders}" '$2 == t && $6 ~ /^[0-9]+$/ { s += $6; n++ } END { if (n) print s; else print "none" }'
