#!/usr/bin/python3
"""crumbd: the Crumb Of The Day server. Every TCP connection gets one crumb of wisdom."""
import random, socket, sys, time

CONF = "/etc/crumbd/crumbd.conf"
CRUMBS = ["Never trust a biscuit that doesn't crumble.", "Dunk responsibly.", "A custard cream a day keeps the bugs away.",
          "There is no problem a ginger snap cannot make slightly better.", "Always read the logs. Then read them again."]


def config():
    conf = {"listen": "127.0.0.1", "port": "7000"}
    for line in open(CONF):
        line = line.split("#")[0].strip()
        if "=" in line:
            k, v = (x.strip() for x in line.split("=", 1))
            conf[k] = v
    return conf


def log(msg):
    with open("/var/log/crumbd.log", "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


c = config()
try:
    port = int(c["port"])
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((c["listen"], port))
    s.listen(16)
except (OSError, ValueError) as e:
    log(f"cannot start: {e}")
    sys.exit(1)
log(f"listening on {c['listen']}:{port}")
while True:
    conn, addr = s.accept()
    with conn:
        conn.sendall(f"crumbd 1.4.2 says: {random.choice(CRUMBS)}\n".encode())
