#!/bin/sh
### BEGIN INIT INFO
# Provides:          crumbd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Crumb Of The Day server
### END INIT INFO
PIDFILE=/run/crumbd.pid
running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
case "$1" in
  start)
    if running; then echo "crumbd is already running"; exit 0; fi
    echo "Starting crumbd"
    nohup /usr/sbin/crumbd >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if ! running; then echo "crumbd failed to start, see /var/log/crumbd.log" >&2; rm -f "$PIDFILE"; exit 1; fi
    ;;
  stop)
    if running; then echo "Stopping crumbd"; kill "$(cat "$PIDFILE")"; sleep 1; fi
    rm -f "$PIDFILE"
    ;;
  restart) "$0" stop; "$0" start ;;
  status)
    if running; then echo "crumbd is running (pid $(cat "$PIDFILE"))"; else echo "crumbd is not running"; exit 3; fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
