#!/bin/sh
# The step container has no network (--network none), but a Kubernetes node needs an address and a default
# route. A dummy interface gives it both, and packets sent "out" through it go nowhere. The official `dind`
# helper then prepares cgroups for a nested runtime, and the container's command (sleep infinity) runs.
# The cluster itself starts on demand: dojo-cluster up.
if ! ip link show dojo0 >/dev/null 2>&1; then
  ip link add dojo0 type dummy && ip addr add 10.77.0.2/24 dev dojo0 && ip link set dojo0 up \
    && ip route add default via 10.77.0.1 dev dojo0 onlink 2>/dev/null
fi
exec dind "$@"
