#!/bin/bash
# The step's one-node Kubernetes cluster (k3s), started on demand.
#   dojo-cluster up       start it (when it is not running) and wait until the node, CoreDNS and the default
#                         service account are ready; prints how long it took
#   dojo-cluster up --gateway-api   the same, then install the Gateway API CRDs (no controller)
#   dojo-cluster status   is it up?
#   dojo-cluster log      the last lines of the k3s server log
# Trimmed for a laptop: no ingress controller, load balancer, metrics-server, Helm controller or
# cloud controller; SQLite instead of etcd. The kubelet never garbage-collects images (they cannot be pulled
# again: there is no network) and evicts nothing for a nearly full disk.
set -e -o pipefail
LOG=/var/log/k3s.log
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export PATH=/var/lib/rancher/k3s/data/cni:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/k3s/bin:/opt/k3s/bin/aux

running() { pgrep -x k3s-server >/dev/null 2>&1 || pgrep -f '^/usr/local/bin/k3s server' >/dev/null 2>&1; }

up() {
  local t0=$SECONDS
  if ! running; then
    [ "$(id -u)" = 0 ] || exec sudo -E "$0" "$@"
    echo "dojo: starting Kubernetes $(cat /opt/dojo/k3s-version) (k3s)..."
    mkdir -p /var/lib/rancher/k3s/agent/images
    ln -sf /opt/dojo/seed/*.tar /var/lib/rancher/k3s/agent/images/
    echo 'nameserver 10.77.0.1' > /etc/rancher/k3s/resolv.conf
    setsid nohup /usr/local/bin/k3s server \
      --node-name dojo --node-ip 10.77.0.2 --flannel-iface dojo0 \
      --disable traefik,metrics-server,servicelb \
      --disable-cloud-controller --disable-helm-controller \
      --write-kubeconfig-mode 644 --resolv-conf /etc/rancher/k3s/resolv.conf \
      --kubelet-arg image-gc-high-threshold=100 --kubelet-arg image-gc-low-threshold=99 \
      --kube-proxy-arg conntrack-max-per-core=0 \
      --kubelet-arg maximum-dead-containers-per-container=3 \
      --kubelet-arg 'eviction-hard=memory.available<20Mi,nodefs.available<1%,imagefs.available<1%' \
      > "$LOG" 2>&1 < /dev/null &
  fi
  # One deadline for the whole start (a busy laptop can be slow), checked by every wait below.
  local deadline=$((SECONDS + 240))
  left() { [ $SECONDS -lt $deadline ]; }
  until [ -s "$KUBECONFIG" ] && kubectl get --raw /readyz >/dev/null 2>&1; do
    left || fail "the API server did not come up"; running || fail "k3s stopped"; sleep 0.25
  done
  echo "dojo: the API server answers ($((SECONDS - t0)) s); waiting for the node..."
  until [ "$(kubectl get node dojo -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ]; do
    left || fail "the node is not Ready"; sleep 0.5
  done
  echo "dojo: node dojo is Ready ($((SECONDS - t0)) s); waiting for CoreDNS..."
  until kubectl -n default get serviceaccount default >/dev/null 2>&1; do left || fail "no default service account"; sleep 0.25; done
  until [ "$(kubectl -n kube-system get deploy coredns -o jsonpath='{.status.availableReplicas}' 2>/dev/null)" = 1 ]; do
    left || fail "CoreDNS is not ready"; sleep 0.5
  done
  echo "dojo: Kubernetes $(cat /opt/dojo/k3s-version) is up ($((SECONDS - t0)) s)."
}

# The reason goes last: the page shows the end of a failed setup's output.
fail() { echo "The k3s log ends with:" >&2; tail -n 15 "$LOG" | cut -c1-200 >&2; echo "dojo: the cluster did not start after $((SECONDS - t0)) s: $1." >&2; exit 1; }

# The Gateway API CRDs (standard channel), for the lessons that write Gateways and HTTPRoutes. There is no
# gateway controller in this cluster: the objects are validated and stored, but no proxy serves them.
gateway_api() {
  kubectl apply --server-side -f /opt/dojo/gateway-api-v1.7.0.yaml >/dev/null
  kubectl wait --for=condition=Established --timeout=60s crd/gateways.gateway.networking.k8s.io crd/httproutes.gateway.networking.k8s.io >/dev/null
  echo "dojo: Gateway API v1.7.0 CRDs installed."
}

case "${1:-}" in
  up) up "$@"; if [ "${2:-}" = --gateway-api ]; then gateway_api; fi ;;
  gateway-api) gateway_api ;;
  status) if running && kubectl get --raw /readyz >/dev/null 2>&1; then echo "up"; else echo "down"; exit 1; fi ;;
  log) tail -n "${2:-40}" "$LOG" ;;
  *) echo "usage: dojo-cluster up|status|log" >&2; exit 2 ;;
esac
