# code-dojo shell: a readable prompt with the Git branch, and friendly stand-ins for full-screen programs
# while the shell runs in the dojo's line-based in-page terminal (DOJO_LINE_TERM=1).
[ -f /usr/lib/git-core/git-sh-prompt ] && . /usr/lib/git-core/git-sh-prompt
[ -f /usr/share/bash-completion/completions/git ] && . /usr/share/bash-completion/completions/git
GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWUNTRACKEDFILES=1
GIT_PS1_SHOWSTASHSTATE=1
if [ "$(id -u)" = 0 ]; then _dojo_mark='#'; _dojo_user='\[\e[1;31m\]\u'; else _dojo_mark='$'; _dojo_user='\[\e[1;32m\]\u'; fi
PS1="${_dojo_user}@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;35m\]\$(__git_ps1 ' (%s)' 2>/dev/null)\[\e[0m\]${_dojo_mark} "
alias ls='ls --color=auto'
alias ll='ls -la'
alias grep='grep --color=auto'
export HISTCONTROL=ignoredups
shopt -s histappend

# The stand-ins (nano/vim open the page's editor, pagers print, top prints once) are shared with the live labs.
if [ "${DOJO_LINE_TERM:-}" = 1 ] && [ -f /usr/local/lib/dojo/dojo-linerc ]; then
  . /usr/local/lib/dojo/dojo-linerc
fi
