# Terraform and OpenTofu CLI configuration for the dojo (TF_CLI_CONFIG_FILE and TOFU_CLI_CONFIG_FILE point here).
# The step containers have no network, so providers come from a filesystem mirror baked into the image, the way an
# air-gapped company network does it. There is no "direct" block: a provider that is not in the mirror fails at
# `terraform init` with a clear message instead of trying the internet.
provider_installation {
  filesystem_mirror {
    path = "/usr/local/share/terraform/plugins"
  }
}

# No calls home to check for a newer version.
disable_checkpoint = true
