#!/usr/bin/env python3
# dojo-tfstate: a small remote state server for the Terraform lessons, speaking Terraform's (and OpenTofu's) "http"
# backend protocol. Step containers have no network, so there is no S3 bucket or Azure storage account to keep state
# in; this stands in for one on http://127.0.0.1:8300. It behaves like the real thing where it matters:
#   GET    /state/<name>   the latest state (404 when there is none yet)
#   POST   /state/<name>   save a new state; refused with 423/409 unless ?ID= is the current lock's ID
#   LOCK   /state/<name>   take the lock (body: Terraform's lock info JSON); 423 plus the holder's lock info if taken
#   UNLOCK /state/<name>   release it (body: the lock info; force-unlock sends the ID)
#   DELETE /state/<name>   delete the state (workspace delete)
# Every saved state is also kept as a numbered version (like S3 bucket versioning), in /var/lib/dojo-tfstate/<name>/.
# A lock is a file, so a lock left by a process that died stays until someone force-unlocks it: exactly what happens
# with an S3 .tflock object or an Azure blob lease.
#
#   dojo-tfstate start     start it in the background (idempotent), wait until it answers
#   dojo-tfstate stop
#   dojo-tfstate serve     run in the foreground
import json, os, sys, time, signal, subprocess, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

ROOT = os.environ.get("DOJO_TFSTATE_DIR", "/var/lib/dojo-tfstate")
PORT = int(os.environ.get("DOJO_TFSTATE_PORT", "8300"))
PIDFILE = "/run/dojo-tfstate.pid"


def folder(name):
    safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in name) or "default"
    p = os.path.join(ROOT, safe)
    os.makedirs(p, exist_ok=True)
    return p


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


class Handler(BaseHTTPRequestHandler):
    server_version = "dojo-tfstate/1"

    def log_message(self, fmt, *args):
        with open(os.path.join(ROOT, "access.log"), "a") as f:
            f.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), fmt % args))

    def name(self):
        parts = urlparse(self.path).path.strip("/").split("/", 1)
        return parts[1] if len(parts) == 2 and parts[0] == "state" else None

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(n) if n else b""

    def reply(self, code, data=b"", ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if data:
            self.wfile.write(data)

    def do_GET(self):
        n = self.name()
        if n is None:
            return self.reply(404)
        data = read(os.path.join(folder(n), "terraform.tfstate"))
        return self.reply(200, data) if data else self.reply(404)

    def do_POST(self):
        n = self.name()
        if n is None:
            return self.reply(404)
        d = folder(n)
        lock = read(os.path.join(d, "lock.json"))
        given = parse_qs(urlparse(self.path).query).get("ID", [""])[0]
        if lock:
            held = json.loads(lock).get("ID", "")
            if given != held:
                return self.reply(423, lock)
        data = self.body()
        versions = sorted(int(x.split(".")[0]) for x in os.listdir(d) if x.endswith(".tfstate") and x[0].isdigit())
        nxt = (versions[-1] + 1) if versions else 1
        with open(os.path.join(d, "%04d.tfstate" % nxt), "wb") as f:
            f.write(data)
        tmp = os.path.join(d, "terraform.tfstate.tmp")
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, os.path.join(d, "terraform.tfstate"))
        return self.reply(200)

    def do_DELETE(self):
        n = self.name()
        if n is None:
            return self.reply(404)
        p = os.path.join(folder(n), "terraform.tfstate")
        if os.path.exists(p):
            os.remove(p)
        return self.reply(200)

    def do_LOCK(self):
        n = self.name()
        if n is None:
            return self.reply(404)
        p = os.path.join(folder(n), "lock.json")
        data = self.body()
        try:
            fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            return self.reply(423, read(p) or b"{}")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        return self.reply(200)

    def do_UNLOCK(self):
        n = self.name()
        if n is None:
            return self.reply(404)
        p = os.path.join(folder(n), "lock.json")
        lock = read(p)
        if not lock:
            return self.reply(200)
        try:
            want = json.loads(self.body() or b"{}").get("ID", "")
        except ValueError:
            want = ""
        if want and want != json.loads(lock).get("ID", ""):
            return self.reply(409, lock)
        os.remove(p)
        return self.reply(200)


def alive():
    try:
        urllib.request.urlopen("http://127.0.0.1:%d/health" % PORT, timeout=0.5)
    except urllib.error.HTTPError:
        return True
    except Exception:
        return False
    return True


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "serve"
    os.makedirs(ROOT, exist_ok=True)
    if cmd == "serve":
        ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
    elif cmd == "start":
        if alive():
            return
        log = open(os.path.join(ROOT, "server.log"), "a")
        p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"], stdout=log, stderr=log,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        with open(PIDFILE, "w") as f:
            f.write(str(p.pid))
        for _ in range(50):
            if alive():
                return
            time.sleep(0.1)
        sys.exit("dojo-tfstate did not start; see %s/server.log" % ROOT)
    elif cmd == "stop":
        pid = read(PIDFILE)
        if pid:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except ProcessLookupError:
                pass
            os.remove(PIDFILE)
    else:
        sys.exit("usage: dojo-tfstate start|stop|serve")


if __name__ == "__main__":
    main()
