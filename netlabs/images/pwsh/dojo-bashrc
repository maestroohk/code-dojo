# code-dojo pwsh image: the learner's terminal is PowerShell. The in-page terminal starts an interactive bash
# (server/NetLabs.cs ShellBoot, inside a real pty); under DOJO_LINE_TERM=1 it hands over to PowerShell at once,
# through dojo-repl.ps1 (a line-based prompt: the console host's own line editor redraws every key with cursor
# moves, which the page cannot show). Ctrl+C stops PowerShell, so a fresh session starts; `exit` really exits.
# Typing `bash` inside PowerShell gives a plain bash (DOJO_IN_PWSH stops it handing over again).
if [ "$(id -u)" = 0 ]; then _dojo_user='\[\e[1;31m\]\u'; _dojo_mark='#'; else _dojo_user='\[\e[1;32m\]\u'; _dojo_mark='$'; fi
PS1="${_dojo_user}@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]${_dojo_mark} "
alias ls='ls --color=auto'
alias ll='ls -la'
export HISTCONTROL=ignoredups

if [ "${DOJO_LINE_TERM:-}" = 1 ]; then
  [ -f /usr/local/lib/dojo/dojo-linerc ] && . /usr/local/lib/dojo/dojo-linerc
  if [ -z "${DOJO_IN_PWSH:-}" ] && command -v pwsh >/dev/null 2>&1; then
    export DOJO_IN_PWSH=1 DOJO_EXIT_MARK="/tmp/.dojo-pwsh-exit-$$"
    rm -f "$DOJO_EXIT_MARK"
    while :; do
      pwsh -NoLogo -Command '. /usr/local/lib/dojo/dojo-repl.ps1'
      _dojo_rc=$?
      if [ -f "$DOJO_EXIT_MARK" ]; then rm -f "$DOJO_EXIT_MARK"; exit "$_dojo_rc"; fi
      printf '\n\033[33m[PowerShell stopped (Ctrl+C or a crash). A fresh session starts: variables and functions from before are gone, files stay.]\033[0m\n'
    done
  fi
fi
