#!/bin/sh
# Git's editor in the dojo shell. The in-page terminal is line based, so a full-screen editor cannot draw in it.
# When Git already prepared a message (merge, revert, amend, rebase todo), keep it as it is; when the message is
# empty (a plain "git commit"), say how to give it on the command line instead.
if [ -n "$1" ] && grep -qv '^[[:space:]]*\(#.*\)\{0,1\}$' "$1" 2>/dev/null; then exit 0; fi
echo 'dojo: this terminal cannot open a full-screen editor. Give the message on the command line:' >&2
echo '      git commit -m "Short summary"' >&2
exit 1
