#!/bin/sh
# Starts the inner Docker Engine in the background (through the official image's `dind` helper, which sets up
# cgroups and mounts for nesting), then runs the container's command (sleep infinity). Unix socket only: the
# container has no network, and the learner talks to dockerd as a member of the docker group.
mkdir -p /var/log
dind dockerd --host=unix:///var/run/docker.sock --group docker > /var/log/dockerd.log 2>&1 &
exec "$@"
