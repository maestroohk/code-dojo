# code-dojo shell: a readable prompt with the Git branch, and friendly stand-ins for full-screen programs
# while the shell runs in the dojo's line-based in-page terminal (DOJO_LINE_TERM=1).
# A copy of netlabs/images/shell/dojo-bashrc (each image folder is its own build context), plus the
# Docker / kubectl completions for the container images.
[ -f /usr/lib/git-core/git-sh-prompt ] && . /usr/lib/git-core/git-sh-prompt
[ -f /usr/share/git-core/git-prompt.sh ] && . /usr/share/git-core/git-prompt.sh
[ -f /usr/share/bash-completion/completions/git ] && . /usr/share/bash-completion/completions/git
command -v docker >/dev/null 2>&1 && . <(docker completion bash 2>/dev/null)
command -v kubectl >/dev/null 2>&1 && . <(kubectl completion bash 2>/dev/null) && complete -o default -F __start_kubectl k
GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWUNTRACKEDFILES=1
GIT_PS1_SHOWSTASHSTATE=1
if [ "$(id -u)" = 0 ]; then _dojo_mark='#'; _dojo_user='\[\e[1;31m\]\u'; else _dojo_mark='$'; _dojo_user='\[\e[1;32m\]\u'; fi
PS1="${_dojo_user}@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;35m\]\$(__git_ps1 ' (%s)' 2>/dev/null)\[\e[0m\]${_dojo_mark} "
alias ls='ls --color=auto'
alias ll='ls -la'
alias grep='grep --color=auto'
export HISTCONTROL=ignoredups
shopt -s histappend

if [ "${DOJO_LINE_TERM:-}" = 1 ]; then
  _dojo_fullscreen() {
    echo "dojo: '$1' needs a full-screen terminal, and this one is line based." >&2
    echo "      $2" >&2
    return 1
  }
  # Vim's Ex mode (-e / -es) and --version need no screen, so they run for real: vim -es -c '%s/a/b/g' -c x file
  vim() {
    local a
    for a in "$@"; do case $a in -e|-E|-es|-Es|-se|-sE|--version|-h|--help) command vim "$@"; return ;; esac; done
    _dojo_fullscreen vim "Run Vim's commands without the screen: vim -es -c '%s/old/new/g' -c x file (or use sed -i)."
  }
  vi() { vim "$@"; }
  nano() { _dojo_fullscreen nano "Edit with sed -i, or write the file with: cat > file <<'EOF' ... EOF"; }
  tmux() { _dojo_fullscreen tmux "Run long jobs in the background with &, and check them with jobs."; }
  top() { command top -b -n 1 "$@" | head -n 30; }
  htop() { top; }
  less() {
    local files=() x
    for x in "$@"; do case $x in -*) ;; *) files+=("$x") ;; esac; done
    if [ ${#files[@]} -eq 0 ]; then cat; else cat -- "${files[@]}"; fi
  }
  more() { less "$@"; }
fi
