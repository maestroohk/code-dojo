#!/bin/sh
# Waits for the inner Docker Engine, then loads the pre-seeded images (alpine:3.24, busybox:1.37) so the
# scenarios can build and run without a network. Every Docker scenario script starts with it.
# Usage: dojo-docker-up            (all seeds)
#        dojo-docker-up busybox    (only the named seeds)
i=0
until docker info >/dev/null 2>&1; do
  i=$((i + 1))
  if [ "$i" -gt 240 ]; then
    echo "dojo: the Docker Engine inside this container did not start. Its log:" >&2
    tail -n 30 /var/log/dockerd.log >&2
    exit 1
  fi
  sleep 0.25
done
if [ $# -eq 0 ]; then set -- $(cd /opt/dojo/seed && ls *.tar | sed 's/\.tar$//'); fi
for s in "$@"; do docker load -q -i "/opt/dojo/seed/$s.tar" >/dev/null || exit 1; done
