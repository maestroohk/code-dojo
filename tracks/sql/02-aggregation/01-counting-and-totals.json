    {
      "type": "code",
      "title": "Survey report",
      "prompt": [
        "Return three columns about the satisfaction survey:",
        "",
        "- **answered**: how many rides have a rating",
        "- **skipped**: how many rides have no rating",
        "- **avg_rating**: the average rating, rounded to 2 decimals",
        "",
        "Table: `rides(id, bike, rider_id, start_station, end_station, started, minutes, fare, plan, rating)`. `rating` (1 to 5) is NULL when the rider skipped the survey; `plan` is `'member'` or `'casual'`."
      ],
      "starter": "-- Write your query below\n",
      "solution": [
        "SELECT COUNT(rating) AS answered,",
        "       COUNT(*) - COUNT(rating) AS skipped,",
        "       ROUND(AVG(rating), 2) AS avg_rating",
        "FROM rides;"
      ],
      "setup": [
        "CREATE TABLE rides (id INTEGER PRIMARY KEY, bike TEXT, rider_id INTEGER, start_station TEXT, end_station TEXT, started TEXT, minutes INTEGER, fare REAL, plan TEXT, rating INTEGER);",
