      "title": "Length bands",
      "prompt": [
        "Group rides into bands and count them. Return **band** and **rides** where band is:",
        "",
        "- `short` under 10 minutes",
        "- `medium` 10 to 29 minutes",
        "- `long` 30 minutes or more",
        "",
        "Table: `rides(id, bike, rider_id, start_station, end_station, started, minutes, fare, plan, rating)`. `rating` (1 to 5) is NULL when the rider skipped the survey; `plan` is `'member'` or `'casual'`."
      ],
      "starter": "-- Write your query below\n",
      "solution": [
        "SELECT CASE WHEN minutes < 10 THEN 'short'",
        "            WHEN minutes < 30 THEN 'medium'",
        "            ELSE 'long' END AS band,",
        "       COUNT(*) AS rides",
        "FROM rides",
        "GROUP BY band;"
