      "starter": "-- Write your query below\n",
      "solution": [
        "SELECT substr(started, 1, 10) AS day,",
        "       COUNT(*) AS rides,",
        "       SUM(CASE WHEN minutes >= 30 THEN 1 ELSE 0 END) AS long_rides,",
        "       SUM(CASE WHEN plan = 'casual' THEN fare ELSE 0 END) AS casual_revenue,",
