{
  "title": "Boss: The Help Desk",
  "summary": "Disconnected edits, concurrency tokens and bulk clean-up on a ticket system.",
  "minutes": 18,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "The help desk",
      "body": [
        "Support staff assign and close tickets from their browsers, often at the same moment. The tests give you this model (it is not yours to change):",
        "",
        "```csharp",
        "class Ticket { int Id; string Title; string Status = \"open\"; string? Assignee; int Version; }   // Version is a concurrency token",
        "```",
        "",
        "Four tickets exist: 1 \"Printer jam\" (open), 2 \"VPN down\" (closed), 3 \"New laptop\" (open, assigned to ana), 4 \"Old ticket\" (closed). All start at version 0.",
        "",
        "Each step adds a method; keep the earlier ones."
      ]
    },
    {
      "type": "code",
      "title": "Assigning",
      "prompt": "Write `string Assign(DeskDb db, int id, string person, int version)`: the browser sends the version it showed the user. Set the `Assignee`, bump `Version` to `version + 1`, save. Return `\"ok\"`, `\"missing\"` or `\"conflict\"` (the ticket changed since that version).",
      "starter": [
        "string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    return \"\";",
        "}"
      ],
      "solution": [
        "string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    var ticket = db.Tickets.Find(id);",
        "    if (ticket is null) return \"missing\";",
        "    db.Entry(ticket).Property(t => t.Version).OriginalValue = version;",
        "    ticket.Assignee = person;",
        "    ticket.Version = version + 1;",
        "    try",
        "    {",
        "        db.SaveChanges();",
        "        return \"ok\";",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return \"conflict\";",
        "    }",
        "}"
      ],
      "template": [
        "using (var seed = new DeskDb())",
        "{",
        "    seed.Database.EnsureCreated();",
        "    seed.Tickets.AddRange(",
        "        new Ticket { Title = \"Printer jam\" },",
        "        new Ticket { Title = \"VPN down\", Status = \"closed\" },",
        "        new Ticket { Title = \"New laptop\", Assignee = \"ana\" },",
        "        new Ticket { Title = \"Old ticket\", Status = \"closed\" });",
        "    seed.SaveChanges();",
        "}",
        "",
        "    await Dojo.TryAsync(\"assigning\", async () =>",
        "    {",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"ana takes ticket 1 at v0\", \"ok\", Assign(dojoDb, 1, \"ana\", 0));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"ben, also looking at v0, conflicts\", \"conflict\", Assign(dojoDb, 1, \"ben\", 0));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"ben at v1 succeeds\", \"ok\", Assign(dojoDb, 1, \"ben\", 1));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"ticket 9 is missing\", \"missing\", Assign(dojoDb, 9, \"ana\", 0));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"ticket 1 now\", \"ben v2\", dojoDb.Tickets.Where(t => t.Id == 1).Select(t => t.Assignee + \" v\" + t.Version).Single());",
        "    });",
        "{{CODE}}",
        "class Ticket",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public string Status { get; set; } = \"open\";",
        "    public string? Assignee { get; set; }",
        "    public int Version { get; set; }",
        "}",
        "",
        "class DeskDb : DbContext",
        "{",
        "    public DbSet<Ticket> Tickets => Set<Ticket>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=desk.db\");",
        "    protected override void OnModelCreating(ModelBuilder model)",
        "        => model.Entity<Ticket>().Property(t => t.Version).IsConcurrencyToken();",
        "}"
      ],
      "hints": [
        "Same pattern as the documents lesson: set the token's `OriginalValue` to the version the user saw."
      ]
    },
    {
      "type": "code",
      "title": "Closing without loading",
      "prompt": "Add `bool Close(DeskDb db, int id)`: mark a ticket `\"closed\"` with a **single** `UPDATE` and no `SELECT`, by attaching a stub. Because `Version` is a concurrency token, the stub's version (0) is checked: closing a ticket that has been edited since (version above 0) must return `false`, as must closing a ticket that does not exist. Otherwise return `true`.",
      "starter": [
        "    bool Close(DeskDb db, int id)",
        "    {",
        "        return false;",
        "    }",
        "",
        "    string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    var ticket = db.Tickets.Find(id);",
        "    if (ticket is null) return \"missing\";",
        "    db.Entry(ticket).Property(t => t.Version).OriginalValue = version;",
        "    ticket.Assignee = person;",
        "    ticket.Version = version + 1;",
        "    try",
        "    {",
        "        db.SaveChanges();",
        "        return \"ok\";",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return \"conflict\";",
        "    }",
        "}"
      ],
      "solution": [
        "bool Close(DeskDb db, int id)",
        "{",
        "    var stub = new Ticket { Id = id, Status = \"?\" };",
        "    db.Tickets.Attach(stub);",
        "    stub.Status = \"closed\";",
        "    try",
        "    {",
        "        return db.SaveChanges() == 1;",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return false;",
        "    }",
        "}",
        "",
        "string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    var ticket = db.Tickets.Find(id);",
        "    if (ticket is null) return \"missing\";",
        "    db.Entry(ticket).Property(t => t.Version).OriginalValue = version;",
        "    ticket.Assignee = person;",
        "    ticket.Version = version + 1;",
        "    try",
        "    {",
        "        db.SaveChanges();",
        "        return \"ok\";",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return \"conflict\";",
        "    }",
        "}"
      ],
      "template": [
        "using (var seed = new DeskDb())",
        "{",
        "    seed.Database.EnsureCreated();",
        "    seed.Tickets.AddRange(",
        "        new Ticket { Title = \"Printer jam\" },",
        "        new Ticket { Title = \"VPN down\", Status = \"closed\" },",
        "        new Ticket { Title = \"New laptop\", Assignee = \"ana\" },",
        "        new Ticket { Title = \"Old ticket\", Status = \"closed\" });",
        "    seed.SaveChanges();",
        "}",
        "",
        "    await Dojo.TryAsync(\"closing\", async () =>",
        "    {",
        "        using (var dojoDb = new DeskDb()) Assign(dojoDb, 3, \"cy\", 0);",
        "        using (var dojoDb = new DeskDb())",
        "        {",
        "            var dojoSql = new List<string>();",
        "            DeskDb.OnCommand = s => dojoSql.Add(s);",
        "            Dojo.Eq(\"closing ticket 1 (v0) works\", true, Close(dojoDb, 1));",
        "            DeskDb.OnCommand = null;",
        "            Dojo.Check(\"...with one UPDATE and no SELECT\", dojoSql.Count == 1 && dojoSql[0].StartsWith(\"UPDATE\"), string.Join(\" | \", dojoSql));",
        "        }",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"closing ticket 3 (edited, v1) is refused\", false, Close(dojoDb, 3));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"closing ticket 9 (missing) is refused\", false, Close(dojoDb, 9));",
        "        using (var dojoDb = new DeskDb()) Dojo.Eq(\"statuses\", \"closed closed open closed\", string.Join(\" \", dojoDb.Tickets.OrderBy(t => t.Id).Select(t => t.Status)));",
        "    });",
        "{{CODE}}",
        "class Ticket",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public string Status { get; set; } = \"open\";",
        "    public string? Assignee { get; set; }",
        "    public int Version { get; set; }",
        "}",
        "",
        "class DeskDb : DbContext",
        "{",
        "    public static Action<string>? OnCommand;",
        "    public DbSet<Ticket> Tickets => Set<Ticket>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=desk.db\")",
        "        .LogTo((id, level) => id == RelationalEventId.CommandExecuted, e => OnCommand?.Invoke(((CommandExecutedEventData)e).Command.CommandText));",
        "    protected override void OnModelCreating(ModelBuilder model)",
        "        => model.Entity<Ticket>().Property(t => t.Version).IsConcurrencyToken();",
        "}"
      ],
      "hints": [
        "`new Ticket { Id = id, Status = \"?\" }`, `Attach`, then set `Status = \"closed\"`: only `Status` is modified.",
        "A missing row also makes the `UPDATE` match 0 rows: EF Core reports that as a `DbUpdateConcurrencyException` too."
      ]
    },
    {
      "type": "code",
      "title": "The nightly purge",
      "prompt": [
        "Add `int Purge(DeskDb db, List<int> keep)` that, in **one transaction** and **without loading** any ticket:",
        "",
        "1. assigns every open, unassigned ticket to `\"triage\"` and bumps its `Version` by 1 (`ExecuteUpdate` with two `SetProperty` calls),",
        "2. deletes every closed ticket whose id is **not** in `keep` (`ExecuteDelete`),",
        "3. commits and returns how many were deleted."
      ],
      "starter": [
        "    int Purge(DeskDb db, List<int> keep)",
        "    {",
        "        return 0;",
        "    }",
        "",
        "    bool Close(DeskDb db, int id)",
        "{",
        "    var stub = new Ticket { Id = id, Status = \"?\" };",
        "    db.Tickets.Attach(stub);",
        "    stub.Status = \"closed\";",
        "    try",
        "    {",
        "        return db.SaveChanges() == 1;",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return false;",
        "    }",
        "}",
        "",
        "string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    var ticket = db.Tickets.Find(id);",
        "    if (ticket is null) return \"missing\";",
        "    db.Entry(ticket).Property(t => t.Version).OriginalValue = version;",
        "    ticket.Assignee = person;",
        "    ticket.Version = version + 1;",
        "    try",
        "    {",
        "        db.SaveChanges();",
        "        return \"ok\";",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return \"conflict\";",
        "    }",
        "}"
      ],
      "solution": [
        "int Purge(DeskDb db, List<int> keep)",
        "{",
        "    using var tx = db.Database.BeginTransaction();",
        "    db.Tickets.Where(t => t.Status == \"open\" && t.Assignee == null)",
        "        .ExecuteUpdate(s => s.SetProperty(t => t.Assignee, \"triage\").SetProperty(t => t.Version, t => t.Version + 1));",
        "    var removed = db.Tickets.Where(t => t.Status == \"closed\" && !keep.Contains(t.Id)).ExecuteDelete();",
        "    tx.Commit();",
        "    return removed;",
        "}",
        "",
        "bool Close(DeskDb db, int id)",
        "{",
        "    var stub = new Ticket { Id = id, Status = \"?\" };",
        "    db.Tickets.Attach(stub);",
        "    stub.Status = \"closed\";",
        "    try",
        "    {",
        "        return db.SaveChanges() == 1;",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return false;",
        "    }",
        "}",
        "",
        "string Assign(DeskDb db, int id, string person, int version)",
        "{",
        "    var ticket = db.Tickets.Find(id);",
        "    if (ticket is null) return \"missing\";",
        "    db.Entry(ticket).Property(t => t.Version).OriginalValue = version;",
        "    ticket.Assignee = person;",
        "    ticket.Version = version + 1;",
        "    try",
        "    {",
        "        db.SaveChanges();",
        "        return \"ok\";",
        "    }",
        "    catch (DbUpdateConcurrencyException)",
        "    {",
        "        db.ChangeTracker.Clear();",
        "        return \"conflict\";",
        "    }",
        "}"
      ],
      "template": [
        "using (var seed = new DeskDb())",
        "{",
        "    seed.Database.EnsureCreated();",
        "    seed.Tickets.AddRange(",
        "        new Ticket { Title = \"Printer jam\" },",
        "        new Ticket { Title = \"VPN down\", Status = \"closed\" },",
        "        new Ticket { Title = \"New laptop\", Assignee = \"ana\" },",
        "        new Ticket { Title = \"Old ticket\", Status = \"closed\" });",
        "    seed.SaveChanges();",
        "}",
        "",
        "    await Dojo.TryAsync(\"purging\", async () =>",
        "    {",
        "        using (var dojoDb = new DeskDb())",
        "        {",
        "            var dojoSql = new List<string>();",
        "            DeskDb.OnCommand = s => dojoSql.Add(s);",
        "            Dojo.Eq(\"deletes one closed ticket, keeping ticket 2\", 1, Purge(dojoDb, [2]));",
        "            DeskDb.OnCommand = null;",
        "            Dojo.Check(\"no ticket was loaded\", !dojoSql.Any(s => s.TrimStart().StartsWith(\"SELECT\")), string.Join(\" | \", dojoSql));",
        "        }",
        "        using (var dojoDb = new DeskDb())",
        "        {",
        "            Dojo.Eq(\"what is left\", \"1:triage:v1 2:-:v0 3:ana:v0\", string.Join(\" \", dojoDb.Tickets.OrderBy(t => t.Id).Select(t => t.Id + \":\" + (t.Assignee ?? \"-\") + \":v\" + t.Version)));",
        "            Dojo.Eq(\"the bumped version protects against stale edits\", \"conflict\", Assign(dojoDb, 1, \"ben\", 0));",
        "        }",
        "    });",
        "{{CODE}}",
        "class Ticket",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public string Status { get; set; } = \"open\";",
        "    public string? Assignee { get; set; }",
        "    public int Version { get; set; }",
        "}",
        "",
        "class DeskDb : DbContext",
        "{",
        "    public static Action<string>? OnCommand;",
        "    public DbSet<Ticket> Tickets => Set<Ticket>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=desk.db\")",
        "        .LogTo((id, level) => id == RelationalEventId.CommandExecuted, e => OnCommand?.Invoke(((CommandExecutedEventData)e).Command.CommandText));",
        "    protected override void OnModelCreating(ModelBuilder model)",
        "        => model.Entity<Ticket>().Property(t => t.Version).IsConcurrencyToken();",
        "}"
      ],
      "require": [
        {
          "pattern": "ExecuteUpdate",
          "message": "Uses ExecuteUpdate"
        },
        {
          "pattern": "ExecuteDelete",
          "message": "Uses ExecuteDelete"
        }
      ],
      "hints": [
        "`.ExecuteUpdate(s => s.SetProperty(t => t.Assignee, \"triage\").SetProperty(t => t.Version, t => t.Version + 1))`",
        "`!keep.Contains(t.Id)` translates to `NOT IN (...)`."
      ]
    }
  ]
}
