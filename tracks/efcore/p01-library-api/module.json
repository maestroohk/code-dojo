{
  "kind": "project",
  "title": "Library API",
  "summary": "Build a lending library's REST API on ASP.NET Core and EF Core with SQLite, one stage at a time: a model and context, relationships, paged queries with projections, loans protected by change tracking and concurrency tokens, a performance pass that removes N+1 queries, and a final boss. Every stage starts your server and tests it over HTTP.",
  "level": "After EF Core modules 1 to 5 and the C# Tasks API project. Stage 5 uses module 7.",
  "skills": [
    "DbContext and DI",
    "Relationships",
    "Projections and paging",
    "Change tracking",
    "Concurrency tokens",
    "N+1 and keyset paging",
    "Bulk updates"
  ],
  "blueprint": {
