{
  "title": "Boss: The Blog",
  "summary": "One-to-one settings, one-to-many posts and comments, many-to-many tags: build them, fill them, load them.",
  "minutes": 18,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "A blog engine",
      "body": "A blog has one settings record, many posts; each post has many comments and many tags; tags are shared between posts. Each step adds to your code, so keep everything: each solution is the whole program so far."
    },
    {
      "type": "code",
      "title": "The model",
      "prompt": [
        "Write the entities and context:",
        "",
        "- `Blog`: `Id`, `Name`, an optional one-to-one `BlogSettings? Settings`, `List<Post> Posts`",
        "- `BlogSettings`: `Id`, `string Theme` (default `\"light\"`), `int BlogId`, `Blog Blog`",
        "- `Post`: `Id`, `Title`, `int BlogId`, `Blog Blog`, `List<Tag> Tags`, `List<Comment> Comments`",
        "- `Tag`: `Id`, `Name`, `List<Post> Posts` (many-to-many with skip navigations)",
        "- `Comment`: `Id`, `Text`, `int PostId`, `Post Post`",
        "- `BlogDb`: `Blogs`, `Posts`, `Tags`, `Comments`, `Data Source=blog.db`"
      ],
      "starter": [
        "class Blog",
        "{",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "}"
      ],
      "solution": [
        "class Blog",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public BlogSettings? Settings { get; set; }",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class BlogSettings",
        "{",
        "    public int Id { get; set; }",
        "    public string Theme { get; set; } = \"light\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "}",
        "",
        "class Post",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "    public List<Tag> Tags { get; set; } = [];",
        "    public List<Comment> Comments { get; set; } = [];",
        "}",
        "",
        "class Tag",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class Comment",
        "{",
        "    public int Id { get; set; }",
        "    public string Text { get; set; } = \"\";",
        "    public int PostId { get; set; }",
        "    public Post Post { get; set; } = null!;",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "    public DbSet<Blog> Blogs => Set<Blog>();",
        "    public DbSet<Post> Posts => Set<Post>();",
        "    public DbSet<Tag> Tags => Set<Tag>();",
        "    public DbSet<Comment> Comments => Set<Comment>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=blog.db\");",
        "}"
      ],
      "template": [
        "await Dojo.TryAsync(\"the model\", async () =>",
        "{",
        "    using var dojoDb = new BlogDb();",
        "    var dojoSql = dojoDb.Database.GenerateCreateScript();",
        "    Dojo.Check(\"settings are one per blog (unique BlogId)\", dojoSql.Contains(\"CREATE UNIQUE INDEX\") && dojoSql.Contains(\"ON \\\"BlogSettings\\\" (\\\"BlogId\\\")\"), dojoSql);",
        "    Dojo.Check(\"posts point at blogs\", dojoSql.Contains(\"REFERENCES \\\"Blogs\\\" (\\\"Id\\\")\"), dojoSql);",
        "    Dojo.Check(\"a PostTag join table exists\", dojoSql.Contains(\"CREATE TABLE \\\"PostTag\\\"\"), dojoSql);",
        "    Dojo.Check(\"comments point at posts\", dojoSql.Contains(\"REFERENCES \\\"Posts\\\" (\\\"Id\\\")\"), dojoSql);",
        "});",
        "{{CODE}}"
      ],
      "hints": [
        "`BlogSettings` holds the foreign key `BlogId`, which makes it the dependent of the one-to-one.",
        "Collections on both `Post.Tags` and `Tag.Posts` give a many-to-many."
      ]
    },
    {
      "type": "code",
      "title": "Writing",
      "prompt": [
        "Add two methods at the **top**:",
        "",
        "- `Blog CreateBlog(BlogDb db, string name, string theme)` creates a blog **with** its settings in one save, and returns it.",
        "- `Post Publish(BlogDb db, int blogId, string title, params string[] tags)` creates a post on that blog with those tags. A tag that already exists (by name) must be **reused**, not duplicated; repeated names in `tags` count once. Save, and return the post."
      ],
      "starter": [
        "    Blog CreateBlog(BlogDb db, string name, string theme) => new();",
        "",
        "    Post Publish(BlogDb db, int blogId, string title, params string[] tags) => new();",
        "",
        "    class Blog",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public BlogSettings? Settings { get; set; }",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class BlogSettings",
        "{",
        "    public int Id { get; set; }",
        "    public string Theme { get; set; } = \"light\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "}",
        "",
        "class Post",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "    public List<Tag> Tags { get; set; } = [];",
        "    public List<Comment> Comments { get; set; } = [];",
        "}",
        "",
        "class Tag",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class Comment",
        "{",
        "    public int Id { get; set; }",
        "    public string Text { get; set; } = \"\";",
        "    public int PostId { get; set; }",
        "    public Post Post { get; set; } = null!;",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "    public DbSet<Blog> Blogs => Set<Blog>();",
        "    public DbSet<Post> Posts => Set<Post>();",
        "    public DbSet<Tag> Tags => Set<Tag>();",
        "    public DbSet<Comment> Comments => Set<Comment>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=blog.db\");",
        "}"
      ],
      "solution": [
        "Blog CreateBlog(BlogDb db, string name, string theme)",
        "{",
        "    var blog = new Blog { Name = name, Settings = new BlogSettings { Theme = theme } };",
        "    db.Blogs.Add(blog);",
        "    db.SaveChanges();",
        "    return blog;",
        "}",
        "",
        "Post Publish(BlogDb db, int blogId, string title, params string[] tags)",
        "{",
        "    var post = new Post { Title = title, BlogId = blogId };",
        "    foreach (var name in tags.Distinct())",
        "        post.Tags.Add(db.Tags.SingleOrDefault(t => t.Name == name) ?? new Tag { Name = name });",
        "    db.Posts.Add(post);",
        "    db.SaveChanges();",
        "    return post;",
        "}",
        "",
        "class Blog",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public BlogSettings? Settings { get; set; }",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class BlogSettings",
        "{",
        "    public int Id { get; set; }",
        "    public string Theme { get; set; } = \"light\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "}",
        "",
        "class Post",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "    public List<Tag> Tags { get; set; } = [];",
        "    public List<Comment> Comments { get; set; } = [];",
        "}",
        "",
        "class Tag",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class Comment",
        "{",
        "    public int Id { get; set; }",
        "    public string Text { get; set; } = \"\";",
        "    public int PostId { get; set; }",
        "    public Post Post { get; set; } = null!;",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "    public DbSet<Blog> Blogs => Set<Blog>();",
        "    public DbSet<Post> Posts => Set<Post>();",
        "    public DbSet<Tag> Tags => Set<Tag>();",
        "    public DbSet<Comment> Comments => Set<Comment>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=blog.db\");",
        "}"
      ],
      "template": [
        "await Dojo.TryAsync(\"writing\", async () =>",
        "{",
        "    using (var dojoDb = new BlogDb())",
        "    {",
        "        dojoDb.Database.EnsureCreated();",
        "        var dojoBlog = CreateBlog(dojoDb, \"Notes\", \"dark\");",
        "        Dojo.Eq(\"the blog gets id 1\", 1, dojoBlog.Id);",
        "        Publish(dojoDb, 1, \"Hello\", \"intro\", \"meta\");",
        "        Publish(dojoDb, 1, \"EF Core\", \"dotnet\", \"intro\", \"dotnet\");",
        "    }",
        "    using (var dojoDb = new BlogDb())",
        "    {",
        "        Dojo.Eq(\"the settings were saved\", \"dark\", dojoDb.Blogs.Where(b => b.Id == 1).Select(b => b.Settings!.Theme).Single());",
        "        Dojo.Eq(\"three distinct tags\", new List<string> { \"dotnet\", \"intro\", \"meta\" }, dojoDb.Tags.OrderBy(t => t.Name).Select(t => t.Name).ToList());",
        "        Dojo.Eq(\"intro is on two posts\", 2, dojoDb.Tags.Where(t => t.Name == \"intro\").Select(t => t.Posts.Count).Single());",
        "        Dojo.Eq(\"EF Core has two tags\", 2, dojoDb.Posts.Where(p => p.Title == \"EF Core\").Select(p => p.Tags.Count).Single());",
        "    }",
        "});",
        "{{CODE}}"
      ],
      "hints": [
        "`new Blog { Name = name, Settings = new BlogSettings { Theme = theme } }`: adding the blog adds the settings.",
        "For each distinct name: `db.Tags.SingleOrDefault(t => t.Name == name) ?? new Tag { Name = name }`."
      ]
    },
    {
      "type": "code",
      "title": "Reading",
      "prompt": [
        "Add `List<string> Digest(BlogDb db, int blogId)` at the top: one line per post of that blog, ordered by title, like",
        "",
        "```text",
        "EF Core [dotnet,intro] 2",
        "```",
        "",
        "the title, the post's tag names in alphabetical order inside brackets, and the number of comments. Load the posts with their tags and comments using `Include`."
      ],
      "starter": [
        "    List<string> Digest(BlogDb db, int blogId) => [];",
        "",
        "    Blog CreateBlog(BlogDb db, string name, string theme)",
        "{",
        "    var blog = new Blog { Name = name, Settings = new BlogSettings { Theme = theme } };",
        "    db.Blogs.Add(blog);",
        "    db.SaveChanges();",
        "    return blog;",
        "}",
        "",
        "Post Publish(BlogDb db, int blogId, string title, params string[] tags)",
        "{",
        "    var post = new Post { Title = title, BlogId = blogId };",
        "    foreach (var name in tags.Distinct())",
        "        post.Tags.Add(db.Tags.SingleOrDefault(t => t.Name == name) ?? new Tag { Name = name });",
        "    db.Posts.Add(post);",
        "    db.SaveChanges();",
        "    return post;",
        "}",
        "",
        "class Blog",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public BlogSettings? Settings { get; set; }",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class BlogSettings",
        "{",
        "    public int Id { get; set; }",
        "    public string Theme { get; set; } = \"light\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "}",
        "",
        "class Post",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "    public List<Tag> Tags { get; set; } = [];",
        "    public List<Comment> Comments { get; set; } = [];",
        "}",
        "",
        "class Tag",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class Comment",
        "{",
        "    public int Id { get; set; }",
        "    public string Text { get; set; } = \"\";",
        "    public int PostId { get; set; }",
        "    public Post Post { get; set; } = null!;",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "    public DbSet<Blog> Blogs => Set<Blog>();",
        "    public DbSet<Post> Posts => Set<Post>();",
        "    public DbSet<Tag> Tags => Set<Tag>();",
        "    public DbSet<Comment> Comments => Set<Comment>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=blog.db\");",
        "}"
      ],
      "solution": [
        "List<string> Digest(BlogDb db, int blogId) =>",
        "    db.Posts.Where(p => p.BlogId == blogId)",
        "        .Include(p => p.Tags)",
        "        .Include(p => p.Comments)",
        "        .OrderBy(p => p.Title)",
        "        .ToList()",
        "        .Select(p => $\"{p.Title} [{string.Join(\",\", p.Tags.Select(t => t.Name).Order())}] {p.Comments.Count}\")",
        "        .ToList();",
        "",
        "Blog CreateBlog(BlogDb db, string name, string theme)",
        "{",
        "    var blog = new Blog { Name = name, Settings = new BlogSettings { Theme = theme } };",
        "    db.Blogs.Add(blog);",
        "    db.SaveChanges();",
        "    return blog;",
        "}",
        "",
        "Post Publish(BlogDb db, int blogId, string title, params string[] tags)",
        "{",
        "    var post = new Post { Title = title, BlogId = blogId };",
        "    foreach (var name in tags.Distinct())",
        "        post.Tags.Add(db.Tags.SingleOrDefault(t => t.Name == name) ?? new Tag { Name = name });",
        "    db.Posts.Add(post);",
        "    db.SaveChanges();",
        "    return post;",
        "}",
        "",
        "class Blog",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public BlogSettings? Settings { get; set; }",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class BlogSettings",
        "{",
        "    public int Id { get; set; }",
        "    public string Theme { get; set; } = \"light\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "}",
        "",
        "class Post",
        "{",
        "    public int Id { get; set; }",
        "    public string Title { get; set; } = \"\";",
        "    public int BlogId { get; set; }",
        "    public Blog Blog { get; set; } = null!;",
        "    public List<Tag> Tags { get; set; } = [];",
        "    public List<Comment> Comments { get; set; } = [];",
        "}",
        "",
        "class Tag",
        "{",
        "    public int Id { get; set; }",
        "    public string Name { get; set; } = \"\";",
        "    public List<Post> Posts { get; set; } = [];",
        "}",
        "",
        "class Comment",
        "{",
        "    public int Id { get; set; }",
        "    public string Text { get; set; } = \"\";",
        "    public int PostId { get; set; }",
        "    public Post Post { get; set; } = null!;",
        "}",
        "",
        "class BlogDb : DbContext",
        "{",
        "    public DbSet<Blog> Blogs => Set<Blog>();",
        "    public DbSet<Post> Posts => Set<Post>();",
        "    public DbSet<Tag> Tags => Set<Tag>();",
        "    public DbSet<Comment> Comments => Set<Comment>();",
        "    protected override void OnConfiguring(DbContextOptionsBuilder options) => options.UseSqlite(\"Data Source=blog.db\");",
        "}"
      ],
      "template": [
        "await Dojo.TryAsync(\"reading\", async () =>",
        "{",
        "    using (var dojoDb = new BlogDb())",
        "    {",
        "        dojoDb.Database.EnsureCreated();",
        "        CreateBlog(dojoDb, \"Notes\", \"dark\");",
        "        CreateBlog(dojoDb, \"Other\", \"light\");",
        "        var dojoHello = Publish(dojoDb, 1, \"Hello\", \"meta\", \"intro\");",
        "        var dojoEf = Publish(dojoDb, 1, \"EF Core\", \"intro\", \"dotnet\");",
        "        Publish(dojoDb, 2, \"Elsewhere\");",
        "        dojoDb.Comments.AddRange(new Comment { PostId = dojoEf.Id, Text = \"nice\" }, new Comment { PostId = dojoEf.Id, Text = \"thanks\" });",
        "        dojoDb.SaveChanges();",
        "    }",
        "    using (var dojoDb = new BlogDb())",
        "        Dojo.Eq(\"the digest of blog 1\", new List<string> { \"EF Core [dotnet,intro] 2\", \"Hello [intro,meta] 0\" }, Digest(dojoDb, 1));",
        "    using (var dojoDb = new BlogDb())",
        "        Dojo.Eq(\"the digest of blog 2\", new List<string> { \"Elsewhere [] 0\" }, Digest(dojoDb, 2));",
        "});",
        "{{CODE}}"
      ],
      "require": [
        {
          "pattern": "\\.Include\\s*\\(",
          "message": "Loads related data with Include"
        }
      ],
      "hints": [
        "Two `Include`s, one for `Tags` and one for `Comments`, then `ToList()`.",
        "Format in memory: `string.Join(\",\", p.Tags.Select(t => t.Name).Order())`."
      ]
    }
