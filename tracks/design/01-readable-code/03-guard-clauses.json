      ],
      "answer": "ABCinvalid"
    },
    {
      "type": "mcq",
      "prompt": "Which statement about guard clauses is **false**?",
      "options": [
        "A method should only have one `return` statement, so guards are bad style",
        "Guards put the special cases first and the main path last",
        "Guards reduce nesting",
        "A guard can `throw` instead of `return`"
      ],
      "answer": 0,
      "explain": "\"Single exit\" was a rule for languages without automatic cleanup. In C#, early returns are clear and safe (`using` and `finally` still run)."
    },
    {
      "type": "blanks",
      "prompt": "Turn the nested check into guards.",
      "code": [
        "string Access(User? user)",
        "{",
        "    if (user __1__ null) return \"login\";",
        "    if (__2__user.IsActive) return \"disabled\";",
        "    __3__ \"welcome\";",
        "}"
      ],
      "blanks": [
        "==",
        "!",
        "return"
      ],
      "bank": [
        "!=",
        "else",
        "?"
      ]
    },
    {
      "type": "code",
      "mode": "fix",
      "title": "Flatten the arrow",
      "prompt": [
        "`Discount` works but is nested four deep. Rewrite it with **guard clauses** so no `else` remains. Behaviour must not change:",
        "",
        "- a `null` customer gets 0",
        "- a customer with no orders gets 0",
        "- a VIP gets 20",
        "- anyone else with more than 10 orders gets 10, otherwise 5",
        "",
        "`Customer` is a record with `IsVip` and `Orders`, provided by the tests."
      ],
      "starter": [
        "int Discount(Customer? c)",
        "{",
        "    if (c != null)",
        "    {",
        "        if (c.Orders > 0)",
        "        {",
        "            if (c.IsVip)",
        "            {",
        "                return 20;",
        "            }",
        "            else",
        "            {",
        "                if (c.Orders > 10) return 10;",
        "                else return 5;",
        "            }",
        "        }",
        "        else return 0;",
        "    }",
        "    else return 0;",
        "}"
      ],
      "solution": [
        "int Discount(Customer? c)",
        "{",
        "    if (c == null) return 0;",
        "    if (c.Orders == 0) return 0;",
        "    if (c.IsVip) return 20;",
        "    if (c.Orders > 10) return 10;",
        "    return 5;",
        "}"
      ],
      "template": [
        "{{CODE}}",
        "Dojo.Eq(\"null customer\", 0, Discount(null));",
        "Dojo.Eq(\"no orders\", 0, Discount(new Customer(true, 0)));",
        "Dojo.Eq(\"VIP\", 20, Discount(new Customer(true, 3)));",
        "Dojo.Eq(\"regular with 11 orders\", 10, Discount(new Customer(false, 11)));",
        "Dojo.Eq(\"regular with 10 orders\", 5, Discount(new Customer(false, 10)));",
        "record Customer(bool IsVip, int Orders);"
      ],
      "forbid": [
        {
          "pattern": "\\belse\\b",
          "message": "No else left"
        }
      ],
      "hints": [
        "Start with `if (c == null) return 0;`.",
        "Each nested `if` becomes one line at the top level; the last case is a plain `return 5;`."
      ]
    },
    {
      "type": "code",
      "mode": "write",
      "title": "Guard the arguments",
      "prompt": [
        "`Split` divides a bill between people. Add guard clauses at the top:",
        "",
        "- `total < 0` throws `ArgumentOutOfRangeException`",
        "- `people <= 0` throws `ArgumentOutOfRangeException`",
        "",
        "then return the share rounded to 2 decimals (`Math.Round(total / people, 2)`)."
      ],
      "starter": [
        "decimal Split(decimal total, int people)",
        "{",
        "    return Math.Round(total / people, 2);",
        "}"
      ],
      "solution": [
        "decimal Split(decimal total, int people)",
        "{",
        "    if (total < 0) throw new ArgumentOutOfRangeException(nameof(total));",
        "    if (people <= 0) throw new ArgumentOutOfRangeException(nameof(people));",
        "    return Math.Round(total / people, 2);",
        "}"
      ],
      "template": [
        "{{CODE}}",
        "Dojo.Eq(\"100 between 3\", 33.33m, Split(100m, 3));",
        "Dojo.Eq(\"0 between 2\", 0m, Split(0m, 2));",
        "Dojo.Throws<ArgumentOutOfRangeException>(\"negative total\", () => Split(-1m, 2));",
        "Dojo.Throws<ArgumentOutOfRangeException>(\"zero people\", () => Split(10m, 0));",
        "Dojo.Throws<ArgumentOutOfRangeException>(\"negative people\", () => Split(10m, -2));"
      ]
    }
  ]
}
