{
  "title": "Mini integration platform",
  "summary": "Build a whole platform in one ASP.NET Core program: fake backends, an integration layer that routes, transforms, validates, maps errors, times out and retries, and a gateway with tokens, scopes, rate limits, logging, an API product and honest metrics. Every stage is tested over real HTTP.",
  "kind": "project",
  "level": "After the Integration modules 1 to 6 (and the Tasks API project for minimal APIs).",
  "skills": [
    "Minimal APIs",
    "HttpClient",
    "JSON transforms",
    "Validation",
    "Error contracts",
    "Timeouts and retries",
    "Idempotency",
    "OAuth client credentials",
    "Scopes",
    "Rate limiting",
    "Middleware"
  ],
  "blueprint": {
    "layers": [
      "Consumer",
      "Gateway",
      "Integration",
      "Backend"
    ],
    "parts": [
      {
        "id": "consumer",
        "label": "Consumer apps",
        "layer": "Consumer",
        "stage": 1,
        "note": "The tests: a shop app, a reader app, a partner."
      },
      {
        "id": "backends",
        "label": "/backend/books · stock · orders",
        "layer": "Backend",
        "stage": 1,
        "note": "Fake systems with magic failing inputs."
      },
      {
        "id": "route",
        "label": "GET /api/books/{isbn}",
        "layer": "Integration",
        "stage": 2,
        "note": "New outbound request, JSON transform, no header leaks."
      },
      {
        "id": "contract",
        "label": "Contract + validation",
        "layer": "Integration",
        "stage": 3,
        "note": "/api/openapi.json, 400 with details, POST /api/orders."
      },
      {
        "id": "errors",
        "label": "Error contract + trace ids",
        "layer": "Integration",
        "stage": 4,
        "note": "404/502/504/500 with traceId; 1 s timeout."
      },
      {
        "id": "retry",
        "label": "Retries + idempotency",
        "layer": "Integration",
        "stage": 5,
        "note": "Stock retried with backoff; Idempotency-Key on orders."
      },
      {
        "id": "token",
        "label": "POST /gateway/token",
        "layer": "Gateway",
        "stage": 6,
        "note": "Client credentials, scopes."
      },
      {
        "id": "authz",
        "label": "Token + scope check",
        "layer": "Gateway",
        "stage": 6,
        "note": "401 vs 403, request log."
      },
      {
        "id": "limit",
        "label": "Token-bucket rate limit",
        "layer": "Gateway",
        "stage": 7,
        "note": "429 with Retry-After, per application."
      },
      {
        "id": "product",
        "label": "API product /partner/v1",
        "layer": "Gateway",
        "stage": 8,
        "note": "Two services, one base path, one subscription."
      },
      {
        "id": "ops",
        "label": "/health · /metrics",
        "layer": "Gateway",
        "stage": 8,
        "note": "Counts handled errors as errors."
      }
    ],
    "flow": [
      [
        "consumer",
        "token"
      ],
      [
        "consumer",
        "authz"
      ],
      [
        "authz",
        "limit"
      ],
      [
        "limit",
        "route"
      ],
      [
        "limit",
        "product"
      ],
      [
        "product",
        "route"
      ],
      [
        "route",
        "contract"
      ],
      [
        "contract",
        "errors"
      ],
      [
        "errors",
        "retry"
      ],
      [
        "retry",
        "backends"
      ],
      [
        "route",
        "backends"
      ],
      [
        "authz",
        "ops"
      ]
    ]
  }
}
