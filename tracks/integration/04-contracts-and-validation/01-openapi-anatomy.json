{
  "title": "Anatomy of an OpenAPI contract",
  "summary": "Paths, operations, operationIds, parameters, schemas and responses: read a contract like a consumer would.",
  "minutes": 12,
  "kind": "lesson",
  "steps": [
    {
      "type": "learn",
      "title": "What a contract says",
      "body": [
        "An **OpenAPI** document (formerly Swagger) describes an HTTP API precisely enough for humans **and** tools:",
        "",
        "```yaml",
        "openapi: 3.1.1",
        "info: { title: Catalogue API, version: 1.0.0 }",
        "servers: [ { url: /catalogue/v1 } ]",
        "paths:",
        "  /books/{isbn}:                 # a path",
        "    get:                         # an operation = path + method",
        "      operationId: getBook       # its unique, stable name",
        "      parameters:",
        "        - { name: isbn, in: path, required: true,",
        "            schema: { type: string, pattern: \"^97[89][0-9]{10}$\" } }",
        "      responses:",
        "        \"200\": { description: The book, content: { application/json: { schema: { $ref: \"#/components/schemas/Book\" } } } }",
        "        \"400\": { description: Invalid ISBN, ... }",
        "        \"404\": { description: No such book, ... }",
        "components:",
        "  schemas:",
        "    Book: { type: object, required: [isbn, title, price], properties: { ... } }",
        "```",
        "",
        "Write new contracts as **OpenAPI 3.1** (its schemas are real JSON Schema 2020-12). You will still meet 3.0 files in older services, where a value that may be null is written `nullable: true` instead of `type: [string, \"null\"]`; 3.2 (2025) adds streaming and is what ASP.NET Core 11 generates by default.",
        "",
        "The same file feeds the developer portal's documentation, the gateway's import, mock servers, generated routes and tests."
      ]
    },
    {
      "type": "mcq",
      "prompt": "Why does every operation need a unique `operationId`?",
      "options": [
        "Tools use it as the operation's stable name: generated routes (`direct:getBook`), client method names, gateway resources and logs",
        "It is the URL the client calls",
        "It sets the HTTP method",
        "OpenAPI requires it to be a number"
      ],
      "answer": 0,
      "explain": "Paths can change in a new version; the operationId is how code and tooling refer to \"the get-book operation\". Name it like a method: verb + noun."
    },
    {
      "type": "learn",
      "title": "Parameters, bodies and schemas",
      "body": [
        "- **Parameters** live `in` the `path`, the `query`, a `header` or a `cookie`. Path parameters are always `required: true`.",
        "- A **request body** (`requestBody`) carries JSON for `POST`, `PUT`, `PATCH`.",
        "- **Schemas** (JSON Schema) describe shapes: `type` (`object`, `array`, `string`, `integer`, `number`, `boolean`),",
        "  `required`, `properties`, `items`, and rules such as `pattern`, `minLength`, `minimum`, `maximum`, `enum`.",
        "- `$ref: \"#/components/schemas/Book\"` reuses a schema defined once under `components`.",
        "- **Responses** are listed per status code. A good contract lists every error too, all with one `Error` shape:",
        "  ```json",
        "  { \"code\": \"BOOK_NOT_FOUND\", \"message\": \"No book with that ISBN\", \"traceId\": \"4f1c...\" }",
        "  ```"
      ]
    },
    {
      "type": "match",
      "prompt": "Match each keyword to what it means.",
      "pairs": [
        [
          "`required: [isbn, title]`",
          "These properties must be present"
        ],
        [
          "`pattern`",
          "A string must match this regular expression"
        ],
        [
          "`$ref`",
          "Use a schema defined elsewhere in the document"
        ],
        [
          "`enum`",
          "The value must be one of a fixed list"
        ],
        [
          "`servers`",
          "The base URL the paths are relative to"
        ]
      ]
    },
    {
      "type": "sort",
      "prompt": "Where does each value travel?",
      "buckets": [
        "Path",
        "Query",
        "Header",
        "Body"
      ],
      "items": [
        [
          "The ISBN in `GET /books/9780134757599`",
          0
        ],
        [
          "`q=refactoring` in a search",
          1
        ],
        [
          "`Idempotency-Key: 7f3a...`",
          2
        ],
        [
          "The order JSON in `POST /orders`",
          3
        ],
        [
          "`page=2` for paging",
          1
        ],
        [
          "`Authorization: Bearer ...`",
          2
        ]
      ]
    },
    {
      "type": "blanks",
      "prompt": "Complete the parameter definition: a required query parameter `q` of at least 2 characters.",
      "code": [
        "parameters:",
        "  - name: q",
        "    in: __1__",
        "    __2__: true",
        "    schema:",
        "      type: string",
        "      __3__: 2"
      ],
      "blanks": [
        "query",
        "required",
        "minLength"
      ],
      "bank": [
        "path",
        "body",
        "optional",
        "minimum",
        "length"
      ],
      "explain": "`minimum` is for numbers; `minLength` for strings. Query parameters are optional unless marked `required: true`."
    },
    {
      "type": "predict",
      "prompt": "What does this print?",
      "code": [
        "using System.Text.Json;",
        "",
        "var doc = JsonDocument.Parse(\"\"\"",
        "{\"paths\":{\"/books/{isbn}\":{\"get\":{\"operationId\":\"getBook\"},\"parameters\":[]},",
        "          \"/orders\":{\"post\":{\"operationId\":\"createOrder\"},\"get\":{\"operationId\":\"listOrders\"}}}}",
        "\"\"\");",
        "var methods = new[] { \"get\", \"put\", \"post\", \"delete\", \"patch\" };",
        "foreach (var path in doc.RootElement.GetProperty(\"paths\").EnumerateObject())",
        "    foreach (var op in path.Value.EnumerateObject().Where(o => methods.Contains(o.Name)))",
        "        Console.WriteLine($\"{op.Name.ToUpper()} {path.Name} -> {op.Value.GetProperty(\"operationId\").GetString()}\");"
      ],
      "answer": [
        "GET /books/{isbn} -> getBook",
        "POST /orders -> createOrder",
        "GET /orders -> listOrders"
      ],
      "explain": "A path item can hold non-operation keys such as `parameters` and `summary`, so filter by HTTP method names."
    },
    {
      "type": "code",
      "title": "List the operations",
      "prompt": [
        "Write `List<string> Operations(string openApiJson)` returning one line per operation, in document order:",
        "`\"{METHOD} {path} {operationId}\"` with the method in upper case, for example `\"GET /books/{isbn} getBook\"`.",
        "",
        "- Only `get`, `put`, `post`, `delete`, `patch`, `head` and `options` keys are operations; skip `parameters`, `summary` and anything else.",
        "- An operation without an `operationId` is a contract bug: return `\"{METHOD} {path} (missing operationId)\"`.",
        "",
        "The tests use the catalogue contract from this lesson plus a broken one."
      ],
      "starter": [
        "using System.Text.Json;",
        "",
        "List<string> Operations(string openApiJson)",
        "{",
        "    return new List<string>();",
        "}"
      ],
      "solution": [
        "using System.Text.Json;",
        "",
        "List<string> Operations(string openApiJson)",
        "{",
        "    var methods = new HashSet<string> { \"get\", \"put\", \"post\", \"delete\", \"patch\", \"head\", \"options\" };",
        "    using var doc = JsonDocument.Parse(openApiJson);",
        "    var result = new List<string>();",
        "    foreach (var path in doc.RootElement.GetProperty(\"paths\").EnumerateObject())",
        "        foreach (var op in path.Value.EnumerateObject())",
        "        {",
        "            if (!methods.Contains(op.Name)) continue;",
        "            var id = op.Value.TryGetProperty(\"operationId\", out var o) ? o.GetString() : \"(missing operationId)\";",
        "            result.Add($\"{op.Name.ToUpperInvariant()} {path.Name} {id}\");",
        "        }",
        "    return result;",
        "}"
      ],
      "hints": [
        "`EnumerateObject()` over `paths`, then over each path item.",
        "A `HashSet<string>` of method names filters out `parameters` and `summary`."
      ],
      "template": [
        "{{CODE}}",
        "var dojoContract = \"\"\"",
        "{",
        "  \"openapi\": \"3.1.1\",",
        "  \"info\": {",
        "    \"title\": \"Catalogue API\",",
        "    \"version\": \"1.0.0\"",
        "  },",
        "  \"servers\": [",
        "    {",
        "      \"url\": \"/catalogue/v1\"",
        "    }",
        "  ],",
        "  \"paths\": {",
        "    \"/books/{isbn}\": {",
        "      \"get\": {",
        "        \"operationId\": \"getBook\",",
        "        \"parameters\": [",
        "          {",
        "            \"name\": \"isbn\",",
        "            \"in\": \"path\",",
        "            \"required\": true,",
        "            \"schema\": {",
        "              \"type\": \"string\",",
        "              \"pattern\": \"^97[89][0-9]{10}$\"",
        "            }",
        "          }",
        "        ],",
        "        \"responses\": {",
        "          \"200\": {",
        "            \"description\": \"The book\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Book\"",
        "                },",
        "                \"example\": {",
        "                  \"isbn\": \"9780134757599\",",
        "                  \"title\": \"Refactoring\",",
        "                  \"price\": 44.99",
        "                }",
        "              }",
        "            }",
        "          },",
        "          \"400\": {",
        "            \"description\": \"Invalid ISBN\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Error\"",
        "                }",
        "              }",
        "            }",
        "          },",
        "          \"404\": {",
        "            \"description\": \"No such book\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Error\"",
        "                }",
        "              }",
        "            }",
        "          }",
        "        }",
        "      }",
        "    },",
        "    \"/books\": {",
        "      \"get\": {",
        "        \"operationId\": \"searchBooks\",",
        "        \"parameters\": [",
        "          {",
        "            \"name\": \"q\",",
        "            \"in\": \"query\",",
        "            \"required\": true,",
        "            \"schema\": {",
        "              \"type\": \"string\",",
        "              \"minLength\": 2",
        "            }",
        "          }",
        "        ],",
        "        \"responses\": {",
        "          \"200\": {",
        "            \"description\": \"Matches\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"type\": \"array\",",
        "                  \"items\": {",
        "                    \"$ref\": \"#/components/schemas/Book\"",
        "                  }",
        "                },",
        "                \"example\": []",
        "              }",
        "            }",
        "          }",
        "        }",
        "      }",
        "    },",
        "    \"/orders\": {",
        "      \"post\": {",
        "        \"operationId\": \"createOrder\",",
        "        \"requestBody\": {",
        "          \"required\": true,",
        "          \"content\": {",
        "            \"application/json\": {",
        "              \"schema\": {",
        "                \"$ref\": \"#/components/schemas/OrderRequest\"",
        "              }",
        "            }",
        "          }",
        "        },",
        "        \"responses\": {",
        "          \"201\": {",
        "            \"description\": \"Created\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Order\"",
        "                },",
        "                \"example\": {",
        "                  \"orderId\": \"A1\",",
        "                  \"status\": \"accepted\"",
        "                }",
        "              }",
        "            }",
        "          },",
        "          \"400\": {",
        "            \"description\": \"Invalid order\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Error\"",
        "                }",
        "              }",
        "            }",
        "          },",
        "          \"409\": {",
        "            \"description\": \"Duplicate order\",",
        "            \"content\": {",
        "              \"application/json\": {",
        "                \"schema\": {",
        "                  \"$ref\": \"#/components/schemas/Error\"",
        "                }",
        "              }",
        "            }",
        "          }",
        "        }",
        "      }",
        "    }",
        "  },",
        "  \"components\": {",
        "    \"schemas\": {",
        "      \"Book\": {",
        "        \"type\": \"object\",",
        "        \"required\": [",
        "          \"isbn\",",
        "          \"title\",",
        "          \"price\"",
        "        ],",
        "        \"properties\": {",
        "          \"isbn\": {",
        "            \"type\": \"string\"",
        "          },",
        "          \"title\": {",
        "            \"type\": \"string\"",
        "          },",
        "          \"price\": {",
        "            \"type\": \"number\",",
        "            \"minimum\": 0",
        "          }",
        "        }",
        "      },",
        "      \"OrderRequest\": {",
        "        \"type\": \"object\",",
        "        \"required\": [",
        "          \"isbn\",",
        "          \"quantity\",",
        "          \"email\"",
        "        ],",
        "        \"properties\": {",
        "          \"isbn\": {",
        "            \"type\": \"string\",",
        "            \"pattern\": \"^97[89][0-9]{10}$\"",
        "          },",
        "          \"quantity\": {",
        "            \"type\": \"integer\",",
        "            \"minimum\": 1,",
        "            \"maximum\": 10",
        "          },",
        "          \"email\": {",
        "            \"type\": \"string\",",
        "            \"pattern\": \"^[^@\\\\s]+@[^@\\\\s]+$\"",
        "          },",
        "          \"gift\": {",
        "            \"type\": \"boolean\"",
        "          }",
        "        }",
        "      },",
        "      \"Order\": {",
        "        \"type\": \"object\",",
        "        \"required\": [",
        "          \"orderId\",",
        "          \"status\"",
        "        ],",
        "        \"properties\": {",
        "          \"orderId\": {",
        "            \"type\": \"string\"",
        "          },",
        "          \"status\": {",
        "            \"type\": \"string\",",
        "            \"enum\": [",
        "              \"accepted\",",
        "              \"rejected\"",
        "            ]",
        "          }",
        "        }",
        "      },",
        "      \"Error\": {",
        "        \"type\": \"object\",",
        "        \"required\": [",
        "          \"code\",",
        "          \"traceId\"",
        "        ],",
        "        \"properties\": {",
        "          \"code\": {",
        "            \"type\": \"string\"",
        "          },",
        "          \"message\": {",
        "            \"type\": \"string\"",
        "          },",
        "          \"traceId\": {",
        "            \"type\": \"string\"",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "\"\"\";",
        "Dojo.Eq(\"catalogue operations\", new List<string> { \"GET /books/{isbn} getBook\", \"GET /books searchBooks\", \"POST /orders createOrder\" }, Operations(dojoContract));",
        "var dojoBroken = \"\"\"",
        "{\"paths\":{\"/a\":{\"summary\":\"x\",\"parameters\":[],\"delete\":{\"responses\":{}},\"put\":{\"operationId\":\"putA\"}}}}",
        "\"\"\";",
        "Dojo.Eq(\"skips non-operations, flags missing ids\", new List<string> { \"DELETE /a (missing operationId)\", \"PUT /a putA\" }, Operations(dojoBroken));"
      ]
    }
  ]
}
