    {
      "type": "code",
      "title": "Answer from the example",
      "prompt": [
        "Write `(int Status, string Body)? Mock(string openApiJson, string operationId)` that answers like mock mode:",
        "",
        "- find the operation with that `operationId` (null if none);",
        "- take its **first** response whose status code starts with `2`;",
        "- return that status and its `content.application/json.example` as compact JSON (`JsonSerializer.Serialize(element)`);",
        "- if that response has no example, return the status with body `\"\"`."
      ],
      "starter": [
        "using System.Text.Json;",
        "",
        "(int Status, string Body)? Mock(string openApiJson, string operationId)",
        "{",
        "    return null;",
        "}"
      ],
      "solution": [
        "using System.Text.Json;",
        "",
        "(int Status, string Body)? Mock(string openApiJson, string operationId)",
        "{",
        "    using var doc = JsonDocument.Parse(openApiJson);",
        "    foreach (var path in doc.RootElement.GetProperty(\"paths\").EnumerateObject())",
        "        foreach (var op in path.Value.EnumerateObject())",
        "        {",
        "            if (op.Value.ValueKind != JsonValueKind.Object) continue;",
        "            if (!op.Value.TryGetProperty(\"operationId\", out var id) || id.GetString() != operationId) continue;",
        "            foreach (var r in op.Value.GetProperty(\"responses\").EnumerateObject())",
        "            {",
        "                if (!r.Name.StartsWith(\"2\")) continue;",
        "                var status = int.Parse(r.Name);",
        "                if (r.Value.TryGetProperty(\"content\", out var c) && c.TryGetProperty(\"application/json\", out var j) && j.TryGetProperty(\"example\", out var ex))",
        "                    return (status, JsonSerializer.Serialize(ex));",
        "                return (status, \"\");",
        "            }",
        "        }",
        "    return null;",
        "}"
      ],
      "hints": [
        "Skip path-item keys that aren't objects (like a `parameters` array) before reading `operationId`.",
        "`responses` keys are strings such as `\"200\"`: check `StartsWith(\"2\")`, then `int.Parse`."
      ],
