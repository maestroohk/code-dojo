        "var dojoAll = new HashSet<string> { \"getBook\", \"searchBooks\", \"createOrder\" };",
        "Dojo.Eq(\"every operation has a route\", \"started\", Startup(dojoContract, dojoAll, \"fail\"));",
        "Dojo.Eq(\"mock mode lists the mocked operations\", \"started with mocks: createOrder, searchBooks\", Startup(dojoContract, new HashSet<string> { \"getBook\" }, \"mock\"));",
