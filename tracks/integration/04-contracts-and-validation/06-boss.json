    {
      "type": "code",
      "title": "Will v2 break v1's consumers?",
      "prompt": [
        "Write `List<string> CompareVersions(string v1Json, string v2Json)` comparing two contracts **by operationId**:",
        "",
        "- an operationId in v1 but not v2 → `\"removed operation {id}\"`;",
        "- an operation whose `{METHOD} {path}` changed → `\"{id} moved from {old} to {new}\"` (paths compared without the base path);",
        "- a status code documented in v1 for that operation but not in v2 → `\"{id} no longer returns {status}\"`.",
        "",
        "Report in v1's operation order; within an operation, status codes in v1's order. New operations in v2 are fine."
      ],
      "starter": [
        "using System.Text.Json;",
        "",
        "List<string> CompareVersions(string v1Json, string v2Json)",
        "{",
        "    return new List<string>();",
        "}"
      ],
      "solution": [
        "using System.Text.Json;",
        "",
        "List<string> CompareVersions(string v1Json, string v2Json)",
        "{",
        "    var methods = new HashSet<string> { \"get\", \"put\", \"post\", \"delete\", \"patch\" };",
        "    List<(string Id, string Where, List<string> Statuses)> Ops(string json)",
        "    {",
        "        using var doc = JsonDocument.Parse(json);",
        "        var list = new List<(string, string, List<string>)>();",
        "        foreach (var path in doc.RootElement.GetProperty(\"paths\").EnumerateObject())",
        "            foreach (var op in path.Value.EnumerateObject())",
        "                if (methods.Contains(op.Name))",
        "                    list.Add((op.Value.GetProperty(\"operationId\").GetString()!, $\"{op.Name.ToUpperInvariant()} {path.Name}\",",
        "                              op.Value.TryGetProperty(\"responses\", out var r) ? r.EnumerateObject().Select(x => x.Name).ToList() : new List<string>()));",
        "        return list;",
        "    }",
        "    var next = Ops(v2Json).ToDictionary(o => o.Id);",
        "    var result = new List<string>();",
        "    foreach (var o in Ops(v1Json))",
        "    {",
        "        if (!next.TryGetValue(o.Id, out var n)) { result.Add($\"removed operation {o.Id}\"); continue; }",
        "        if (n.Where != o.Where) result.Add($\"{o.Id} moved from {o.Where} to {n.Where}\");",
        "        foreach (var s in o.Statuses)",
        "            if (!n.Statuses.Contains(s)) result.Add($\"{o.Id} no longer returns {s}\");",
        "    }",
        "    return result;",
        "}"
      ],
      "hints": [
        "Write a local function that turns a contract into a list of (id, \"METHOD path\", statuses).",
        "Index v2's list by id, then walk v1's list in order."
      ],
      "template": [
        "{{CODE}}",
        "var dojoV1 = \"\"\"",
        "{\"paths\":{\"/books/{isbn}\":{\"get\":{\"operationId\":\"getBook\",\"responses\":{\"200\":{},\"400\":{},\"404\":{}}}},",
        "          \"/books\":{\"get\":{\"operationId\":\"searchBooks\",\"responses\":{\"200\":{}}}},",
        "          \"/orders\":{\"post\":{\"operationId\":\"createOrder\",\"responses\":{\"201\":{},\"400\":{},\"409\":{}}}}}}",
        "\"\"\";",
        "var dojoV2 = \"\"\"",
        "{\"paths\":{\"/books/{isbn}\":{\"get\":{\"operationId\":\"getBook\",\"responses\":{\"200\":{},\"404\":{},\"400\":{}}}},",
        "          \"/orders\":{\"put\":{\"operationId\":\"createOrder\",\"responses\":{\"200\":{},\"400\":{}}}},",
        "          \"/books/{isbn}/reviews\":{\"get\":{\"operationId\":\"listReviews\",\"responses\":{\"200\":{}}}}}}",
        "\"\"\";",
        "Dojo.Eq(\"every break, in v1 order\", new List<string>",
        "{",
        "    \"removed operation searchBooks\",",
        "    \"createOrder moved from POST /orders to PUT /orders\",",
        "    \"createOrder no longer returns 201\",",
        "    \"createOrder no longer returns 409\",",
        "}, CompareVersions(dojoV1, dojoV2));",
        "Dojo.Eq(\"a contract compared with itself\", new List<string>(), CompareVersions(dojoV1, dojoV1));"
      ]
    }
  ]
}
