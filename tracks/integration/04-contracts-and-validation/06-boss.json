{
  "title": "Boss: the contract gate",
  "summary": "Build the checks a pipeline runs on every contract-first integration.",
  "minutes": 35,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "The brief",
      "body": [
        "Acme's pipeline should refuse to deploy an integration whose contract is broken, whose routes don't match it,",
        "or whose new version would break consumers. You build the gate, one check at a time."
      ]
    },
    {
      "type": "code",
      "title": "Lint the contract",
      "prompt": [
        "Write `List<string> Lint(string openApiJson)` returning every problem, in document order (paths, then operations):",
        "",
        "- an operation (`get`, `put`, `post`, `delete`, `patch`) without `operationId` → `\"{METHOD} {path}: missing operationId\"`;",
        "- an `operationId` used more than once → `\"duplicate operationId {id}\"` (reported once, at its second use);",
        "- a path template parameter `{name}` that the operation does not declare in its `parameters` with `\"in\": \"path\"` → `\"{METHOD} {path}: path parameter {name} is not declared\"`;",
        "- an operation with no `4xx` response at all → `\"{METHOD} {path}: no error responses\"`."
      ],
      "starter": [
        "using System.Text.Json;",
        "using System.Text.RegularExpressions;",
        "",
        "List<string> Lint(string openApiJson)",
        "{",
        "    return new List<string>();",
        "}"
      ],
      "solution": [
        "using System.Text.Json;",
        "using System.Text.RegularExpressions;",
        "",
        "List<string> Lint(string openApiJson)",
        "{",
        "    var methods = new HashSet<string> { \"get\", \"put\", \"post\", \"delete\", \"patch\" };",
        "    var problems = new List<string>();",
        "    var ids = new HashSet<string>();",
        "    using var doc = JsonDocument.Parse(openApiJson);",
        "    foreach (var path in doc.RootElement.GetProperty(\"paths\").EnumerateObject())",
        "    {",
        "        var templateParams = Regex.Matches(path.Name, @\"\\{([^}]+)\\}\").Select(m => m.Groups[1].Value).ToList();",
        "        foreach (var op in path.Value.EnumerateObject())",
        "        {",
        "            if (!methods.Contains(op.Name)) continue;",
        "            var where = $\"{op.Name.ToUpperInvariant()} {path.Name}\";",
        "            if (!op.Value.TryGetProperty(\"operationId\", out var id)) problems.Add($\"{where}: missing operationId\");",
        "            else if (!ids.Add(id.GetString()!)) problems.Add($\"duplicate operationId {id.GetString()}\");",
        "",
        "            var declared = new HashSet<string>();",
        "            if (op.Value.TryGetProperty(\"parameters\", out var ps))",
        "                foreach (var p in ps.EnumerateArray())",
        "                    if (p.GetProperty(\"in\").GetString() == \"path\") declared.Add(p.GetProperty(\"name\").GetString()!);",
        "            foreach (var name in templateParams)",
        "                if (!declared.Contains(name)) problems.Add($\"{where}: path parameter {name} is not declared\");",
        "",
        "            var hasError = op.Value.TryGetProperty(\"responses\", out var rs) && rs.EnumerateObject().Any(r => r.Name.StartsWith(\"4\"));",
        "            if (!hasError) problems.Add($\"{where}: no error responses\");",
        "        }",
        "    }",
        "    return problems;",
        "}"
      ],
      "hints": [
        "`Regex.Matches(path.Name, @\"\\{([^}]+)\\}\")` finds the template parameters.",
        "A `HashSet<string>.Add` returning false spots a duplicate id."
      ],
