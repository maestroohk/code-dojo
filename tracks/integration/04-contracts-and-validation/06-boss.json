    {
      "type": "code",
      "title": "Route a request by the contract",
      "prompt": [
        "Write `(int Status, string? OperationId, Dictionary<string, string>? Params) Resolve(string openApiJson, string method, string path)`:",
        "",
        "- the contract's `servers[0].url` is the base path (e.g. `/catalogue/v1`); a request path that doesn't start with it → `404`;",
        "- strip the base, then match the rest against each path template (`{name}` captures a non-empty segment; literal segments compare ignoring case; segment counts must match);",
        "- a template matches and has an operation for `method` (ignore case) → `(200, operationId, params)`;",
        "- a template matched but none had that method → `(405, null, null)`; nothing matched → `(404, null, null)`.",
        "- **Literal beats parameter**: if several templates match, prefer the one with more literal segments (so `/books/search` wins over `/books/{isbn}`)."
      ],
      "starter": [
        "using System.Text.Json;",
        "",
        "(int Status, string? OperationId, Dictionary<string, string>? Params) Resolve(string openApiJson, string method, string path)",
        "{",
        "    return (404, null, null);",
        "}"
      ],
      "solution": [
        "using System.Text.Json;",
        "",
        "(int Status, string? OperationId, Dictionary<string, string>? Params) Resolve(string openApiJson, string method, string path)",
        "{",
        "    using var doc = JsonDocument.Parse(openApiJson);",
        "    var root = doc.RootElement;",
        "    var basePath = root.TryGetProperty(\"servers\", out var s) && s.GetArrayLength() > 0 ? s[0].GetProperty(\"url\").GetString()!.TrimEnd('/') : \"\";",
        "    if (!path.StartsWith(basePath + \"/\", StringComparison.OrdinalIgnoreCase) && !string.Equals(path, basePath, StringComparison.OrdinalIgnoreCase))",
        "        return (404, null, null);",
        "    var rest = path[basePath.Length..].Split('/', StringSplitOptions.RemoveEmptyEntries);",
        "",
        "    var candidates = new List<(int Literals, JsonProperty Item, Dictionary<string, string> Values)>();",
        "    foreach (var item in root.GetProperty(\"paths\").EnumerateObject())",
        "    {",
        "        var t = item.Name.Split('/', StringSplitOptions.RemoveEmptyEntries);",
        "        if (t.Length != rest.Length) continue;",
        "        var values = new Dictionary<string, string>();",
        "        var literals = 0;",
        "        var ok = true;",
        "        for (int i = 0; i < t.Length && ok; i++)",
        "        {",
        "            if (t[i].StartsWith(\"{\") && t[i].EndsWith(\"}\")) values[t[i][1..^1]] = Uri.UnescapeDataString(rest[i]);",
        "            else if (string.Equals(t[i], rest[i], StringComparison.OrdinalIgnoreCase)) literals++;",
        "            else ok = false;",
        "        }",
        "        if (ok) candidates.Add((literals, item, values));",
        "    }",
        "    if (candidates.Count == 0) return (404, null, null);",
        "    foreach (var c in candidates.OrderByDescending(c => c.Literals))",
        "        foreach (var op in c.Item.Value.EnumerateObject())",
        "            if (string.Equals(op.Name, method, StringComparison.OrdinalIgnoreCase) && op.Value.ValueKind == JsonValueKind.Object)",
        "                return (200, op.Value.GetProperty(\"operationId\").GetString(), c.Values);",
        "    return (405, null, null);",
        "}"
      ],
      "hints": [
        "Strip the base path first, then split into segments.",
        "Collect every matching template with a count of literal segments; try them from most literals to fewest."
      ],
