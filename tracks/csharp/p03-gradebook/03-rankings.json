      "require": [
        {
          "pattern": "\\.OrderByDescending\\(",
          "message": "Sorts with OrderByDescending"
        },
        {
          "pattern": "\\.ThenBy\\(",
          "message": "Breaks ties with ThenBy"
        },
        {
          "pattern": "\\.MinBy\\(",
          "message": "Finds the lowest with MinBy"
        }
      ],
      "hints": [
        "`foreach (var course in scores.GroupBy(s => s.Course).OrderBy(g => g.Key))` then sort inside: `course.OrderByDescending(s => s.Points).ThenBy(s => s.Student).ToList()`.",
        "`var cutoff = ranked.Take(3).Last().Points;` then loop over `ranked.TakeWhile(s => s.Points >= cutoff)`.",
        "Rank: `1 + ranked.Count(other => other.Points > s.Points)`. Lowest: `ranked.MinBy(s => s.Points)!`."
      ]
    }
  ]
