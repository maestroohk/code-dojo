        "    .OrderBy(a => a.Student)",
        "    .ToList();",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Averages:\");",
        "foreach (var a in averages)",
        "    Console.WriteLine($\"{a.Student}: {a.Average:F1} {Letter(a.Average)}\");",
        "",
        "Score? TryParseScore(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 3) return null;",
        "    if (!int.TryParse(parts[2], out var points)) return null;",
        "    if (points < 0 || points > 100) return null;",
        "    return new Score(parts[0].Trim(), parts[1].Trim(), points);",
        "}",
        "",
        "string Letter(double average) => average switch",
        "{",
        "    >= 90 => \"A\",",
        "    >= 80 => \"B\",",
        "    >= 70 => \"C\",",
        "    >= 60 => \"D\",",
        "    _ => \"F\"",
        "};",
        "",
        "record Score(string Student, string Course, int Points);"
      ],
      "solution": [
        "var lines = new List<string>();",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "    lines.Add(line);",
        "",
        "var rows = lines",
        "    .Where(l => !string.IsNullOrWhiteSpace(l))",
        "    .Where(l => !l.StartsWith(\"student,\"))",
        "    .ToList();",
        "",
        "var scores = rows",
        "    .Select(TryParseScore)",
        "    .OfType<Score>()",
        "    .ToList();",
        "",
        "Console.WriteLine($\"Scores: {scores.Count}, skipped: {rows.Count - scores.Count}\");",
        "",
        "var averages = scores",
        "    .GroupBy(s => s.Student)",
        "    .Select(g => new { Student = g.Key, Average = g.Average(s => s.Points) })",
        "    .OrderBy(a => a.Student)",
        "    .ToList();",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Averages:\");",
        "foreach (var a in averages)",
        "    Console.WriteLine($\"{a.Student}: {a.Average:F1} {Letter(a.Average)}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Rankings:\");",
        "foreach (var course in scores.GroupBy(s => s.Course).OrderBy(g => g.Key))",
        "{",
        "    var ranked = course",
        "        .OrderByDescending(s => s.Points)",
        "        .ThenBy(s => s.Student)",
        "        .ToList();",
        "",
        "    var cutoff = ranked.Take(3).Last().Points;",
        "",
        "    Console.WriteLine(course.Key);",
        "    foreach (var s in ranked.TakeWhile(s => s.Points >= cutoff))",
        "    {",
        "        var rank = 1 + ranked.Count(other => other.Points > s.Points);",
        "        Console.WriteLine($\"  {rank}. {s.Student} {s.Points}\");",
        "    }",
        "",
        "    var lowest = ranked.MinBy(s => s.Points)!;",
        "    Console.WriteLine($\"  lowest: {lowest.Student} {lowest.Points}\");",
        "}",
        "",
        "Score? TryParseScore(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 3) return null;",
        "    if (!int.TryParse(parts[2], out var points)) return null;",
        "    if (points < 0 || points > 100) return null;",
        "    return new Score(parts[0].Trim(), parts[1].Trim(), points);",
        "}",
        "",
        "string Letter(double average) => average switch",
        "{",
        "    >= 90 => \"A\",",
        "    >= 80 => \"B\",",
        "    >= 70 => \"C\",",
        "    >= 60 => \"D\",",
        "    _ => \"F\"",
        "};",
        "",
        "record Score(string Student, string Course, int Points);"
      ],
