{
  "kind": "project",
  "title": "Gradebook",
  "summary": "Build a gradebook that reads raw score lines and prints averages, letter grades, course rankings with ties, a credit-weighted GPA and a histogram report. Every stage is one LINQ idea you watch working on real data.",
  "level": "After module 6. Uses records, switch expressions and LINQ.",
  "skills": [
    "Where and Select",
    "TryParse and OfType",
    "GroupBy and Average",
    "Switch expressions",
    "OrderBy, ThenBy, Take",
    "MinBy and MaxBy",
    "Join and GroupJoin",
    "Range, Except and text histograms"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Parsing",
      "Model",
      "Queries",
      "Output"
    ],
    "parts": [
      {
        "id": "stdin",
        "label": "stdin lines",
        "layer": "Input",
        "stage": 1
      },
      {
        "id": "parse",
        "label": "TryParseScore + OfType",
        "layer": "Parsing",
        "stage": 1,
        "note": "Where / Select, bad rows skipped"
      },
      {
        "id": "score",
        "label": "Score record",
        "layer": "Model",
        "stage": 1
      },
      {
        "id": "averages",
        "label": "Averages + letters",
        "layer": "Queries",
        "stage": 2,
        "note": "GroupBy, Average, switch"
      },
      {
        "id": "report",
        "label": "Printed report",
        "layer": "Output",
        "stage": 2
      },
      {
        "id": "rankings",
        "label": "Course rankings",
        "layer": "Queries",
        "stage": 3,
        "note": "OrderByDescending, ThenBy, ties, MinBy"
      },
      {
        "id": "sections",
        "label": "[courses] section",
        "layer": "Parsing",
        "stage": 4,
        "note": "TakeWhile / SkipWhile"
      },
      {
        "id": "course",
        "label": "Course record",
        "layer": "Model",
        "stage": 4
      },
      {
        "id": "gpa",
        "label": "Weighted GPA",
        "layer": "Queries",
        "stage": 4,
        "note": "Join, Sum; GroupJoin for unscored"
      },
      {
        "id": "missing",
        "label": "Missing coursework",
        "layer": "Queries",
        "stage": 5,
        "note": "Except"
      },
      {
        "id": "bands",
        "label": "Score bands",
        "layer": "Output",
        "stage": 5,
        "note": "Range, new string"
