        "        .ToList();",
        "",
        "    var cutoff = ranked.Take(3).Last().Points;",
        "",
        "    Console.WriteLine(course.Key);",
        "    foreach (var s in ranked.TakeWhile(s => s.Points >= cutoff))",
        "    {",
        "        var rank = 1 + ranked.Count(other => other.Points > s.Points);",
        "        Console.WriteLine($\"  {rank}. {s.Student} {s.Points}\");",
        "    }",
        "",
        "    var lowest = ranked.MinBy(s => s.Points)!;",
        "    Console.WriteLine($\"  lowest: {lowest.Student} {lowest.Points}\");",
        "}",
        "",
        "if (courses.Count > 0)",
        "{",
        "    var gpas = scores",
        "        .Join(courses,",
        "            s => s.Course,",
        "            c => c.Name,",
        "            (s, c) => new { s.Student, c.Credits, Points = GradePoints(Letter(s.Points)) })",
        "        .GroupBy(x => x.Student)",
        "        .Select(g => new",
        "        {",
        "            Student = g.Key,",
        "            Credits = g.Sum(x => x.Credits),",
        "            Gpa = (double)g.Sum(x => x.Points * x.Credits) / g.Sum(x => x.Credits)",
        "        })",
        "        .OrderByDescending(x => x.Gpa)",
        "        .ThenBy(x => x.Student)",
        "        .ToList();",
        "",
        "    Console.WriteLine();",
        "    Console.WriteLine(\"GPA:\");",
        "    foreach (var g in gpas)",
        "        Console.WriteLine($\"{g.Student}: {g.Gpa:F2} ({g.Credits} credits)\");",
        "}",
        "",
        "Score? TryParseScore(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 3) return null;",
        "    if (!int.TryParse(parts[2], out var points)) return null;",
        "    if (points < 0 || points > 100) return null;",
        "    return new Score(parts[0].Trim(), parts[1].Trim(), points);",
        "}",
        "",
        "Course? TryParseCourse(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 2) return null;",
        "    if (!int.TryParse(parts[1], out var credits) || credits <= 0) return null;",
        "    return new Course(parts[0].Trim(), credits);",
        "}",
        "",
        "string Letter(double average) => average switch",
        "{",
        "    >= 90 => \"A\",",
        "    >= 80 => \"B\",",
        "    >= 70 => \"C\",",
        "    >= 60 => \"D\",",
        "    _ => \"F\"",
        "};",
        "",
        "int GradePoints(string letter) => letter switch",
        "{",
        "    \"A\" => 4,",
        "    \"B\" => 3,",
        "    \"C\" => 2,",
        "    \"D\" => 1,",
        "    _ => 0",
        "};",
        "",
        "record Score(string Student, string Course, int Points);",
        "",
        "record Course(string Name, int Credits);"
      ],
      "solution": [
        "var lines = new List<string>();",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "    lines.Add(line);",
        "",
        "var scoreLines = lines",
        "    .TakeWhile(l => l.Trim() != \"[courses]\")",
        "    .ToList();",
        "",
        "var courses = lines",
        "    .SkipWhile(l => l.Trim() != \"[courses]\")",
        "    .Skip(1)",
        "    .Where(l => !string.IsNullOrWhiteSpace(l))",
        "    .Select(TryParseCourse)",
        "    .OfType<Course>()",
        "    .ToList();",
        "",
        "var rows = scoreLines",
        "    .Where(l => !string.IsNullOrWhiteSpace(l))",
        "    .Where(l => !l.StartsWith(\"student,\"))",
        "    .ToList();",
        "",
        "var scores = rows",
        "    .Select(TryParseScore)",
        "    .OfType<Score>()",
        "    .ToList();",
        "",
        "Console.WriteLine($\"Scores: {scores.Count}, skipped: {rows.Count - scores.Count}\");",
        "",
        "var averages = scores",
        "    .GroupBy(s => s.Student)",
        "    .Select(g => new { Student = g.Key, Average = g.Average(s => s.Points) })",
        "    .OrderBy(a => a.Student)",
        "    .ToList();",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Averages:\");",
        "foreach (var a in averages)",
        "    Console.WriteLine($\"{a.Student}: {a.Average:F1} {Letter(a.Average)}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Rankings:\");",
        "foreach (var course in scores.GroupBy(s => s.Course).OrderBy(g => g.Key))",
        "{",
        "    var ranked = course",
        "        .OrderByDescending(s => s.Points)",
        "        .ThenBy(s => s.Student)",
        "        .ToList();",
        "",
        "    var cutoff = ranked.Take(3).Last().Points;",
        "",
        "    Console.WriteLine(course.Key);",
        "    foreach (var s in ranked.TakeWhile(s => s.Points >= cutoff))",
        "    {",
        "        var rank = 1 + ranked.Count(other => other.Points > s.Points);",
        "        Console.WriteLine($\"  {rank}. {s.Student} {s.Points}\");",
        "    }",
        "",
        "    var lowest = ranked.MinBy(s => s.Points)!;",
        "    Console.WriteLine($\"  lowest: {lowest.Student} {lowest.Points}\");",
        "}",
        "",
        "if (courses.Count > 0)",
        "{",
        "    var gpas = scores",
        "        .Join(courses,",
        "            s => s.Course,",
        "            c => c.Name,",
        "            (s, c) => new { s.Student, c.Credits, Points = GradePoints(Letter(s.Points)) })",
        "        .GroupBy(x => x.Student)",
        "        .Select(g => new",
        "        {",
        "            Student = g.Key,",
        "            Credits = g.Sum(x => x.Credits),",
        "            Gpa = (double)g.Sum(x => x.Points * x.Credits) / g.Sum(x => x.Credits)",
        "        })",
        "        .OrderByDescending(x => x.Gpa)",
        "        .ThenBy(x => x.Student)",
        "        .ToList();",
        "",
        "    Console.WriteLine();",
        "    Console.WriteLine(\"GPA:\");",
        "    foreach (var g in gpas)",
        "        Console.WriteLine($\"{g.Student}: {g.Gpa:F2} ({g.Credits} credits)\");",
        "",
        "    var unscored = courses",
        "        .GroupJoin(scores,",
        "            c => c.Name,",
        "            s => s.Course,",
        "            (c, matches) => new { c.Name, Count = matches.Count() })",
        "        .Where(x => x.Count == 0)",
        "        .Select(x => x.Name)",
        "        .ToList();",
        "",
        "    Console.WriteLine($\"Courses with no scores: {(unscored.Count == 0 ? \"none\" : string.Join(\", \", unscored))}\");",
        "}",
        "",
        "Score? TryParseScore(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 3) return null;",
        "    if (!int.TryParse(parts[2], out var points)) return null;",
        "    if (points < 0 || points > 100) return null;",
        "    return new Score(parts[0].Trim(), parts[1].Trim(), points);",
        "}",
        "",
        "Course? TryParseCourse(string line)",
        "{",
        "    var parts = line.Split(',');",
        "    if (parts.Length != 2) return null;",
        "    if (!int.TryParse(parts[1], out var credits) || credits <= 0) return null;",
        "    return new Course(parts[0].Trim(), credits);",
        "}",
        "",
        "string Letter(double average) => average switch",
        "{",
        "    >= 90 => \"A\",",
        "    >= 80 => \"B\",",
        "    >= 70 => \"C\",",
        "    >= 60 => \"D\",",
        "    _ => \"F\"",
        "};",
        "",
        "int GradePoints(string letter) => letter switch",
        "{",
        "    \"A\" => 4,",
        "    \"B\" => 3,",
        "    \"C\" => 2,",
        "    \"D\" => 1,",
        "    _ => 0",
        "};",
        "",
        "record Score(string Student, string Course, int Points);",
        "",
        "record Course(string Name, int Credits);"
      ],
