        "            (c, matches) => new { c.Name, Count = matches.Count() })",
        "        .Where(x => x.Count == 0)",
        "        .Select(x => x.Name)",
        "        .ToList();",
        "",
        "    Console.WriteLine($\"Courses with no scores: {(unscored.Count == 0 ? \"none\" : string.Join(\", \", unscored))}\");",
        "}",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Score bands:\");",
        "var bands = Enumerable.Range(6, 4)",
        "    .Reverse()",
        "    .Select(d => (Label: $\"{d * 10}s\", Count: scores.Count(s => Math.Min(s.Points / 10, 9) == d)))",
        "    .Append((\"<60\", scores.Count(s => s.Points < 60)));",
        "",
        "foreach (var (label, count) in bands)",
