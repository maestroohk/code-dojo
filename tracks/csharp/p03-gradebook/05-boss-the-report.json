        "",
        "var allCourses = courses.Count > 0",
        "    ? courses.Select(c => c.Name).ToList()",
        "    : scores.Select(s => s.Course).Distinct().Order().ToList();",
        "",
        "var missing = scores",
        "    .GroupBy(s => s.Student)",
