          "stdin": [
            "2026-05-05,Meals,620.00,Client banquet",
            "2026-05-06,Meals,50.00,Team lunch",
            "2026-05-07,Supplies,500.00,Monitor"
          ],
          "expect": [
            "Expenses: 3",
            "Total: 1,170.00",
