{
  "kind": "project",
  "title": "Tasks API",
  "summary": "Build a real REST API with ASP.NET Core, one stage at a time: routes, JSON, validation, status codes, dependency injection and middleware. Every stage is tested over real HTTP.",
  "level": "After module 4. Stages 4 onward use LINQ, DI and async from modules 6 to 8.",
  "skills": [
    "Minimal APIs",
    "HTTP and status codes",
    "JSON",
    "Validation",
    "LINQ",
    "Dependency injection",
    "Middleware"
  ],
  "blueprint": {
    "layers": [
      "Client",
      "Pipeline",
      "Endpoints",
      "Services",
      "Data"
    ],
    "parts": [
      {
        "id": "client",
        "label": "HTTP client",
        "layer": "Client",
        "stage": 1,
        "note": "The tests, a browser, or a phone app calling your API."
      },
      {
        "id": "host",
        "label": "WebApplication",
        "layer": "Pipeline",
        "stage": 1,
        "uses": [
          "hello"
        ],
        "note": "builder, app.Build(), app.Run()"
      },
      {
        "id": "hello",
        "label": "GET /hello · /health",
        "layer": "Endpoints",
        "stage": 1
      },
      {
        "id": "list",
        "label": "GET /tasks · /tasks/{id}",
        "layer": "Endpoints",
        "stage": 2,
        "uses": [
          "store"
        ]
      },
      {
        "id": "store",
        "label": "In-memory task list",
        "layer": "Data",
        "stage": 2,
        "note": "A List<TaskItem> of records."
      },
      {
        "id": "create",
        "label": "POST /tasks + validation",
        "layer": "Endpoints",
        "stage": 3,
        "uses": [
          "store"
        ],
        "note": "201 Created, Location header, 400 on bad input"
      },
      {
        "id": "crud",
        "label": "PUT · PATCH · DELETE",
        "layer": "Endpoints",
        "stage": 4,
        "uses": [
          "store"
        ]
      },
      {
        "id": "query",
        "label": "Filter, search, paging",
        "layer": "Services",
        "stage": 5,
        "uses": [
          "store"
        ],
        "note": "Query string + LINQ"
      },
      {
        "id": "itaskstore",
        "label": "ITaskStore (DI)",
        "layer": "Services",
        "stage": 6,
        "uses": [
          "store"
        ],
        "note": "Endpoints ask for the interface, not the list."
      },
      {
        "id": "reqid",
        "label": "Request-id middleware",
        "layer": "Pipeline",
        "stage": 7
      },
      {
        "id": "apikey",
        "label": "API key check",
        "layer": "Pipeline",
        "stage": 7
      },
      {
        "id": "errors",
        "label": "Error handling + /stats",
        "layer": "Pipeline",
        "stage": 8,
        "note": "ProblemDetails, route groups"
      }
    ],
    "flow": [
      [
        "client",
        "host"
      ],
      [
        "host",
        "reqid"
      ],
      [
        "reqid",
        "apikey"
      ],
      [
        "apikey",
        "list"
      ],
      [
        "apikey",
        "create"
      ],
      [
        "apikey",
        "crud"
      ],
      [
        "list",
        "query"
      ],
      [
        "query",
        "itaskstore"
      ],
      [
        "create",
        "itaskstore"
      ],
      [
        "crud",
        "itaskstore"
      ],
      [
        "itaskstore",
        "store"
      ],
      [
        "host",
        "hello"
      ],
      [
        "host",
        "errors"
      ]
    ]
  }
}
