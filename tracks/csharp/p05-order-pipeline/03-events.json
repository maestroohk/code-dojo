        "",
        "interface IEntity",
        "{",
        "    int Id { get; }",
        "}",
        "",
        "record Result<T>(bool IsOk, T? Value, string Error)",
        "{",
        "    public static Result<T> Ok(T value) => new(true, value, \"\");",
        "    public static Result<T> Fail(string error) => new(false, default, error);",
        "}",
        "",
        "interface IRepository<T> where T : IEntity",
        "{",
        "    Result<T> Add(T item);",
        "    T? Find(int id);",
        "    IReadOnlyList<T> All();",
        "}",
        "",
        "class ListRepository<T> : IRepository<T> where T : IEntity",
        "{",
        "    private readonly List<T> _items = new();",
        "",
        "    public Result<T> Add(T item)",
        "    {",
        "        if (Find(item.Id) is not null)",
        "            return Result<T>.Fail($\"duplicate id {item.Id}\");",
        "        _items.Add(item);",
        "        return Result<T>.Ok(item);",
        "    }",
        "",
        "    public T? Find(int id) => _items.FirstOrDefault(i => i.Id == id);",
        "",
        "    public IReadOnlyList<T> All() => _items;",
        "}",
        "",
        "class SortedRepository<T> : IRepository<T> where T : IEntity",
        "{",
        "    private readonly SortedDictionary<int, T> _items = new();",
        "",
        "    public Result<T> Add(T item)",
        "    {",
        "        if (!_items.TryAdd(item.Id, item))",
        "            return Result<T>.Fail($\"duplicate id {item.Id}\");",
        "        return Result<T>.Ok(item);",
        "    }",
        "",
        "    public T? Find(int id) => _items.TryGetValue(id, out var item) ? item : default;",
        "",
        "    public IReadOnlyList<T> All() => _items.Values.ToList();",
        "}",
        "",
        "enum Status { Accepted, Rejected }",
        "",
        "record Outcome(Order Order, Status Status, string Reason);",
        "",
        "class OrderDesk",
        "{",
        "    private readonly List<IOrderRule> _rules;",
        "    private readonly IRepository<Order> _orders;",
        "",
        "    public OrderDesk(List<IOrderRule> rules, IRepository<Order> orders)",
        "    {",
        "        _rules = rules;",
        "        _orders = orders;",
        "    }",
        "",
        "    public event Action<Outcome>? OrderProcessed;",
        "",
        "    public void Process(Order order)",
        "    {",
        "        var result = Validate(order);",
        "        if (result.IsOk)",
        "            result = _orders.Add(order);",
        "",
        "        var outcome = result.IsOk",
        "            ? new Outcome(order, Status.Accepted, \"\")",
        "            : new Outcome(order, Status.Rejected, result.Error);",
        "",
        "        OrderProcessed?.Invoke(outcome);",
        "    }",
        "",
        "    private Result<Order> Validate(Order order)",
        "    {",
        "        var reasons = _rules.Select(rule => rule.Check(order)).OfType<string>().ToList();",
        "        return reasons.Count == 0",
        "            ? Result<Order>.Ok(order)",
        "            : Result<Order>.Fail(string.Join(\"; \", reasons));",
        "    }",
        "}",
        "",
        "class TotalsBoard",
        "{",
        "    private readonly Dictionary<Product, int> _units = new();",
        "",
        "    public int Accepted { get; private set; }",
        "    public int Rejected { get; private set; }",
        "",
        "    public void Record(Outcome outcome)",
        "    {",
        "        if (outcome.Status != Status.Accepted)",
        "        {",
        "            Rejected++;",
        "            return;",
        "        }",
        "",
        "        Accepted++;",
        "        _units[outcome.Order.Product] = _units.GetValueOrDefault(outcome.Order.Product) + outcome.Order.Quantity;",
        "    }",
        "",
        "    public string UnitsLine() =>",
        "        _units.Count == 0",
        "            ? \"Units: none\"",
        "            : \"Units: \" + string.Join(\", \", _units.OrderBy(u => u.Key).Select(u => $\"{u.Key} {u.Value}\"));",
        "}"
      ],
      "solution": [
        "var rules = new List<IOrderRule>",
        "{",
        "    new MinQuantityRule(),",
        "    new MaxQuantityRule(10),",
        "    new DiscontinuedRule(Product.Gizmo),",
        "    new BlockedCustomerRule(\"mallory\"),",
        "};",
        "",
        "IRepository<Order> orders = new SortedRepository<Order>();",
        "var desk = new OrderDesk(rules, orders);",
        "var board = new TotalsBoard();",
        "var audit = new AuditLog();",
        "",
        "desk.OrderProcessed += outcome => Console.WriteLine(Format(outcome));",
        "desk.OrderProcessed += board.Record;",
        "desk.OrderProcessed += audit.Record;",
        "",
        "var unreadable = 0;",
        "var lineNumber = 0;",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "{",
        "    lineNumber++;",
        "    if (string.IsNullOrWhiteSpace(line)) continue;",
        "",
        "    if (line.Trim() == \"audit off\")",
        "    {",
        "        desk.OrderProcessed -= audit.Record;",
        "        continue;",
        "    }",
        "    var order = ParseOrder(line);",
        "    if (order is null)",
        "    {",
        "        Console.WriteLine($\"line {lineNumber}: cannot read '{line}'\");",
