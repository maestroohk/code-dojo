        "    {",
        "        var reasons = _rules.Select(rule => rule.Check(order)).OfType<string>().ToList();",
        "        return reasons.Count == 0",
        "            ? Result<Order>.Ok(order)",
        "            : Result<Order>.Fail(string.Join(\"; \", reasons));",
        "    }",
        "}",
        "",
        "class TotalsBoard",
        "{",
        "    private readonly Dictionary<Product, int> _units = new();",
        "",
        "    public int Accepted { get; private set; }",
        "    public int Rejected { get; private set; }",
        "",
        "    public void Record(Outcome outcome)",
        "    {",
        "        if (outcome.Status != Status.Accepted)",
        "        {",
        "            Rejected++;",
        "            return;",
        "        }",
        "",
        "        Accepted++;",
        "        _units[outcome.Order.Product] = _units.GetValueOrDefault(outcome.Order.Product) + outcome.Order.Quantity;",
