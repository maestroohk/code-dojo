        "Console.WriteLine($\"Accepted: {board.Accepted}, Rejected: {board.Rejected}, Unreadable: {unreadable}\");",
        "Console.WriteLine(board.UnitsLine());",
        "Console.WriteLine(StoredLine(orders.All()));",
        "Console.WriteLine($\"Audit: {audit.Entries.Count} entries\");",
        "foreach (var entry in audit.Entries)",
        "    Console.WriteLine($\"  {entry}\");",
        "string Format(Outcome outcome) =>",
        "    outcome.Status == Status.Accepted",
        "        ? $\"{Describe(outcome.Order)} accepted\"",
        "        : $\"{Describe(outcome.Order)} rejected: {outcome.Reason}\";",
        "",
        "string StoredLine(IReadOnlyList<Order> stored) =>",
        "    stored.Count == 0",
        "        ? \"Stored: none\"",
        "        : \"Stored: \" + string.Join(\", \", stored.Select(o => $\"#{o.Id}\"));",
        "",
        "Order? ParseOrder(string line)",
        "{",
        "    var parts = line.Split(',', StringSplitOptions.TrimEntries);",
        "    if (parts.Length != 4) return null;",
        "    if (!int.TryParse(parts[0], out var id)) return null;",
        "    if (!Enum.TryParse<Product>(parts[2], ignoreCase: true, out var product) || !Enum.IsDefined(product)) return null;",
        "    if (!int.TryParse(parts[3], out var quantity)) return null;",
        "    return new Order(id, parts[1], product, quantity);",
        "}",
        "",
        "string Describe(Order order) => $\"#{order.Id} {order.Customer} {order.Product} x{order.Quantity}\";",
        "",
        "enum Product { Widget, Gadget, Gizmo }",
        "",
        "record Order(int Id, string Customer, Product Product, int Quantity) : IEntity;",
        "",
        "interface IOrderRule",
        "{",
        "    string? Check(Order order);",
        "}",
        "",
        "class MinQuantityRule : IOrderRule",
        "{",
        "    public string? Check(Order order) =>",
        "        order.Quantity < 1 ? \"quantity must be at least 1\" : null;",
        "}",
        "",
        "class MaxQuantityRule : IOrderRule",
        "{",
        "    private readonly int _max;",
        "",
        "    public MaxQuantityRule(int max) => _max = max;",
        "",
        "    public string? Check(Order order) =>",
        "        order.Quantity > _max ? $\"quantity over {_max}\" : null;",
        "}",
        "",
        "class DiscontinuedRule : IOrderRule",
        "{",
        "    private readonly Product _product;",
        "",
