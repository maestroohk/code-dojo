        "            : \"Units: \" + string.Join(\", \", _units.OrderBy(u => u.Key).Select(u => $\"{u.Key} {u.Value}\"));",
        "}",
        "",
        "class AuditLog",
        "{",
        "    private readonly List<string> _entries = new();",
        "",
        "    public IReadOnlyList<string> Entries => _entries;",
        "",
        "    public void Record(Outcome outcome) =>",
        "        _entries.Add($\"#{outcome.Order.Id} {outcome.Status.ToString().ToLower()}\");",
        "}"
      ],
      "tests": [
        {
          "name": "audit off stops only the audit log",
          "stdin": [
            "1,alice,widget,3",
            "2,bob,gadget,0",
            "audit off",
            "3,carol,widget,4",
            "bad line",
            "4,dave,gadget,2"
          ],
          "expect": [
            "#1 alice Widget x3 accepted",
            "#2 bob Gadget x0 rejected: quantity must be at least 1",
            "#3 carol Widget x4 accepted",
            "line 5: cannot read 'bad line'",
            "#4 dave Gadget x2 accepted",
            "Accepted: 3, Rejected: 1, Unreadable: 1",
            "Units: Widget 7, Gadget 2",
            "Stored: #1, #3, #4",
            "Audit: 2 entries",
            "  #1 accepted",
            "  #2 rejected"
          ]
        },
        {
          "name": "without the command every order is audited",
          "stdin": [
            "1,alice,widget,3",
            "2,bob,gadget,2",
            "3,carol,widget,4",
            "4,dave,gizmo,1",
            "5,erin,gadget,1"
          ],
          "expect": [
            "#1 alice Widget x3 accepted",
            "#2 bob Gadget x2 accepted",
            "#3 carol Widget x4 accepted",
            "#4 dave Gizmo x1 rejected: Gizmo is discontinued",
            "#5 erin Gadget x1 accepted",
            "Accepted: 4, Rejected: 1, Unreadable: 0",
            "Units: Widget 7, Gadget 3",
            "Stored: #1, #2, #3, #5",
            "Audit: 5 entries",
            "  #1 accepted",
            "  #2 accepted",
            "  #3 accepted",
            "  #4 rejected",
            "  #5 accepted"
          ]
        },
        {
          "name": "no input",
          "stdin": "",
          "expect": [
            "Accepted: 0, Rejected: 0, Unreadable: 0",
            "Units: none",
            "Stored: none",
            "Audit: 0 entries"
          ]
        }
      ],
      "require": [
        {
          "pattern": "OrderProcessed\\s*\\+=\\s*audit\\.Record",
          "message": "Subscribes audit.Record"
        },
        {
          "pattern": "OrderProcessed\\s*-=\\s*audit\\.Record",
          "message": "Unsubscribes audit.Record"
        },
        {
          "pattern": "class\\s+AuditLog",
          "message": "Declares an AuditLog class"
        }
      ],
      "hints": [
        "Check for the command before `ParseOrder`: `if (line.Trim() == \"audit off\") { desk.OrderProcessed -= audit.Record; continue; }`",
        "`-=` with the method group `audit.Record` removes the subscription that `+= audit.Record` added: they compare equal.",
        "`$\"#{outcome.Order.Id} {outcome.Status.ToString().ToLower()}\"`"
      ]
    }
  ]
