{
  "kind": "project",
  "title": "Order Pipeline",
  "summary": "Build a console order desk that validates orders with pluggable rules, stores them in a generic repository, broadcasts every outcome to subscribers, checks stock asynchronously in batches, and finally runs each order through a retrying pipeline of small generic stages.",
  "level": "After module 7. Uses interfaces, generics with constraints, delegates and events, async/await, Task.WhenAll, SemaphoreSlim and cancellation.",
  "skills": [
    "Interfaces and polymorphism",
    "Records and enums",
    "Generic classes and constraints",
    "Result types",
    "Events and Action callbacks",
    "async / await",
    "Task.WhenAll and SemaphoreSlim",
    "CancellationToken",
    "Composing generic stages",
    "Retry"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Domain",
      "Rules",
      "Infrastructure",
      "Async",
      "Output"
    ],
    "parts": [
      {
        "id": "stdin",
        "label": "stdin order lines",
        "layer": "Input",
        "stage": 1,
        "note": "id,customer,product,quantity"
      },
      {
        "id": "model",
        "label": "Order record + Product enum",
        "layer": "Domain",
        "stage": 1
      },
      {
        "id": "rules",
        "label": "IOrderRule implementations",
        "layer": "Rules",
        "stage": 1,
        "note": "One interface, four rules"
      },
      {
        "id": "result",
        "label": "Result<T>",
        "layer": "Domain",
        "stage": 2,
        "note": "Ok or Fail, no exceptions"
      },
      {
        "id": "repo",
        "label": "IRepository<T> where T : IEntity",
        "layer": "Infrastructure",
        "stage": 2,
        "note": "List or sorted store, swapped in one line"
      },
      {
        "id": "desk",
        "label": "OrderDesk + OrderProcessed event",
        "layer": "Domain",
        "stage": 3
      },
      {
        "id": "board",
        "label": "Totals board",
        "layer": "Output",
        "stage": 3,
        "note": "Subscriber"
      },
      {
        "id": "audit",
        "label": "Audit log",
        "layer": "Output",
        "stage": 3,
        "note": "Subscriber that can leave"
      },
      {
        "id": "warehouse",
        "label": "Warehouse (SemaphoreSlim)",
        "layer": "Async",
        "stage": 4,
        "note": "Simulated async stock check"
      },
      {
        "id": "batches",
        "label": "Batches with Task.WhenAll",
        "layer": "Async",
        "stage": 4,
        "note": "Results printed in input order"
      },
      {
        "id": "cutoff",
        "label": "CancellationToken cutoff",
        "layer": "Async",
        "stage": 4
      },
      {
        "id": "stages",
        "label": "IStage<TIn, TOut> pipeline",
        "layer": "Rules",
        "stage": 5,
        "note": "validate → price → reserve → notify"
      },
      {
        "id": "retry",
        "label": "Retry<TIn, TOut>",
        "layer": "Async",
        "stage": 5,
        "note": "Wraps the flaky notifier"
      },
      {
        "id": "summary",
        "label": "Final summary",
        "layer": "Output",
        "stage": 5,
        "note": "Revenue, stock, stored, audit"
      }
    ],
    "flow": [
      [
        "stdin",
        "model"
      ],
      [
        "model",
        "rules"
      ],
      [
        "rules",
        "result"
      ],
      [
        "result",
        "repo"
      ],
      [
        "model",
        "desk"
      ],
      [
        "desk",
        "board"
      ],
      [
        "desk",
        "audit"
      ],
      [
        "desk",
        "batches"
      ],
      [
        "batches",
        "warehouse"
      ],
      [
        "cutoff",
        "batches"
      ],
      [
        "desk",
        "stages"
      ],
      [
        "stages",
        "retry"
      ],
      [
        "stages",
        "repo"
      ],
      [
        "board",
        "summary"
      ],
      [
        "audit",
        "summary"
      ]
    ]
  }
}
