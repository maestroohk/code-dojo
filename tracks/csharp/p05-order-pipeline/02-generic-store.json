        "{",
        "    private readonly List<T> _items = new();",
        "",
        "    public Result<T> Add(T item)",
        "    {",
        "        if (Find(item.Id) is not null)",
        "            return Result<T>.Fail($\"duplicate id {item.Id}\");",
        "        _items.Add(item);",
        "        return Result<T>.Ok(item);",
        "    }",
        "",
        "    public T? Find(int id) => _items.FirstOrDefault(i => i.Id == id);",
        "",
        "    public IReadOnlyList<T> All() => _items;",
        "}"
      ],
      "solution": [
        "var rules = new List<IOrderRule>",
        "{",
        "    new MinQuantityRule(),",
        "    new MaxQuantityRule(10),",
        "    new DiscontinuedRule(Product.Gizmo),",
        "    new BlockedCustomerRule(\"mallory\"),",
        "};",
        "",
        "IRepository<Order> orders = new SortedRepository<Order>();",
        "",
        "int accepted = 0, rejected = 0, unreadable = 0;",
        "var lineNumber = 0;",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "{",
        "    lineNumber++;",
        "    if (string.IsNullOrWhiteSpace(line)) continue;",
        "",
        "    var order = ParseOrder(line);",
        "    if (order is null)",
        "    {",
        "        Console.WriteLine($\"line {lineNumber}: cannot read '{line}'\");",
        "        unreadable++;",
        "        continue;",
        "    }",
        "",
        "    var result = Validate(order);",
        "    if (result.IsOk)",
        "        result = orders.Add(order);",
        "",
        "    if (result.IsOk)",
        "    {",
        "        Console.WriteLine($\"{Describe(order)} accepted\");",
        "        accepted++;",
        "    }",
        "    else",
        "    {",
        "        Console.WriteLine($\"{Describe(order)} rejected: {result.Error}\");",
        "        rejected++;",
        "    }",
        "}",
        "",
        "Console.WriteLine($\"Accepted: {accepted}, Rejected: {rejected}, Unreadable: {unreadable}\");",
        "Console.WriteLine(StoredLine(orders.All()));",
        "",
        "Result<Order> Validate(Order order)",
        "{",
        "    var reasons = rules.Select(rule => rule.Check(order)).OfType<string>().ToList();",
        "    return reasons.Count == 0",
        "        ? Result<Order>.Ok(order)",
        "        : Result<Order>.Fail(string.Join(\"; \", reasons));",
        "}",
        "",
        "string StoredLine(IReadOnlyList<Order> stored) =>",
        "    stored.Count == 0",
        "        ? \"Stored: none\"",
        "        : \"Stored: \" + string.Join(\", \", stored.Select(o => $\"#{o.Id}\"));",
        "",
        "Order? ParseOrder(string line)",
        "{",
        "    var parts = line.Split(',', StringSplitOptions.TrimEntries);",
        "    if (parts.Length != 4) return null;",
        "    if (!int.TryParse(parts[0], out var id)) return null;",
        "    if (!Enum.TryParse<Product>(parts[2], ignoreCase: true, out var product) || !Enum.IsDefined(product)) return null;",
        "    if (!int.TryParse(parts[3], out var quantity)) return null;",
        "    return new Order(id, parts[1], product, quantity);",
        "}",
        "",
        "string Describe(Order order) => $\"#{order.Id} {order.Customer} {order.Product} x{order.Quantity}\";",
        "",
        "enum Product { Widget, Gadget, Gizmo }",
        "",
        "record Order(int Id, string Customer, Product Product, int Quantity) : IEntity;",
        "",
        "interface IOrderRule",
        "{",
        "    string? Check(Order order);",
        "}",
        "",
        "class MinQuantityRule : IOrderRule",
        "{",
        "    public string? Check(Order order) =>",
        "        order.Quantity < 1 ? \"quantity must be at least 1\" : null;",
        "}",
        "",
        "class MaxQuantityRule : IOrderRule",
        "{",
        "    private readonly int _max;",
        "",
        "    public MaxQuantityRule(int max) => _max = max;",
        "",
        "    public string? Check(Order order) =>",
        "        order.Quantity > _max ? $\"quantity over {_max}\" : null;",
        "}",
        "",
        "class DiscontinuedRule : IOrderRule",
        "{",
        "    private readonly Product _product;",
        "",
        "    public DiscontinuedRule(Product product) => _product = product;",
        "",
        "    public string? Check(Order order) =>",
        "        order.Product == _product ? $\"{_product} is discontinued\" : null;",
        "}",
        "",
        "class BlockedCustomerRule : IOrderRule",
        "{",
        "    private readonly string _customer;",
        "",
        "    public BlockedCustomerRule(string customer) => _customer = customer;",
        "",
        "    public string? Check(Order order) =>",
        "        order.Customer == _customer ? $\"customer {_customer} is blocked\" : null;",
        "}",
        "",
        "interface IEntity",
        "{",
        "    int Id { get; }",
        "}",
        "",
        "record Result<T>(bool IsOk, T? Value, string Error)",
        "{",
        "    public static Result<T> Ok(T value) => new(true, value, \"\");",
        "    public static Result<T> Fail(string error) => new(false, default, error);",
        "}",
        "",
        "interface IRepository<T> where T : IEntity",
        "{",
        "    Result<T> Add(T item);",
        "    T? Find(int id);",
        "    IReadOnlyList<T> All();",
        "}",
        "",
        "class ListRepository<T> : IRepository<T> where T : IEntity",
        "{",
        "    private readonly List<T> _items = new();",
        "",
        "    public Result<T> Add(T item)",
        "    {",
        "        if (Find(item.Id) is not null)",
        "            return Result<T>.Fail($\"duplicate id {item.Id}\");",
        "        _items.Add(item);",
        "        return Result<T>.Ok(item);",
        "    }",
        "",
        "    public T? Find(int id) => _items.FirstOrDefault(i => i.Id == id);",
        "",
        "    public IReadOnlyList<T> All() => _items;",
        "}",
        "",
        "class SortedRepository<T> : IRepository<T> where T : IEntity",
        "{",
        "    private readonly SortedDictionary<int, T> _items = new();",
        "",
        "    public Result<T> Add(T item)",
        "    {",
        "        if (!_items.TryAdd(item.Id, item))",
        "            return Result<T>.Fail($\"duplicate id {item.Id}\");",
        "        return Result<T>.Ok(item);",
        "    }",
        "",
        "    public T? Find(int id) => _items.TryGetValue(id, out var item) ? item : default;",
        "",
        "    public IReadOnlyList<T> All() => _items.Values.ToList();",
        "}"
      ],
      "tests": [
        {
          "name": "stored orders come out sorted by id",
          "stdin": [
            "7,bob,gadget,1",
            "1,alice,widget,3",
            "1,carol,widget,2",
            "3,dave,widget,2",
            "3,mallory,widget,1"
          ],
          "expect": [
            "#7 bob Gadget x1 accepted",
            "#1 alice Widget x3 accepted",
            "#1 carol Widget x2 rejected: duplicate id 1",
            "#3 dave Widget x2 accepted",
            "#3 mallory Widget x1 rejected: customer mallory is blocked",
            "Accepted: 3, Rejected: 2, Unreadable: 0",
            "Stored: #1, #3, #7"
          ]
        },
        {
          "name": "rules still report every objection",
          "stdin": [
            "5,mallory,gizmo,0",
            "6,erin,sprocket,1",
            "",
            "x,erin,widget,1",
            "7,frank,widget,12",
            "8,mallory,widget,2",
            "9,grace,widget,10"
          ],
          "expect": [
            "#5 mallory Gizmo x0 rejected: quantity must be at least 1; Gizmo is discontinued; customer mallory is blocked",
            "line 2: cannot read '6,erin,sprocket,1'",
            "line 4: cannot read 'x,erin,widget,1'",
            "#7 frank Widget x12 rejected: quantity over 10",
            "#8 mallory Widget x2 rejected: customer mallory is blocked",
            "#9 grace Widget x10 accepted",
            "Accepted: 1, Rejected: 3, Unreadable: 2",
            "Stored: #9"
          ]
        },
        {
          "name": "no input",
          "stdin": "",
          "expect": [
            "Accepted: 0, Rejected: 0, Unreadable: 0",
            "Stored: none"
          ]
        }
      ],
      "require": [
        {
          "pattern": "class\\s+SortedRepository<T>\\s*:\\s*IRepository<T>\\s+where\\s+T\\s*:\\s*IEntity",
          "message": "SortedRepository<T> implements IRepository<T>"
        },
        {
          "pattern": "SortedDictionary<int,\\s*T>",
          "message": "Backed by a SortedDictionary<int, T>"
        },
        {
          "pattern": "new\\s+SortedRepository<Order>\\(\\)",
          "message": "The program creates a SortedRepository<Order>"
        },
        {
          "pattern": "class\\s+ListRepository<T>",
          "message": "ListRepository<T> is still there"
        }
      ],
      "hints": [
        "`TryAdd` on the dictionary returns `false` for a duplicate key, which is exactly when `Add` should fail.",
        "`Find`: `_items.TryGetValue(id, out var item) ? item : default`. `All`: `_items.Values.ToList()`."
      ]
    }
  ]
}
