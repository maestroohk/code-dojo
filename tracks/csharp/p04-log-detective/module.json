{
  "kind": "project",
  "title": "Log Detective",
  "summary": "Build a tool that reads a web server's access log, skips the garbage, and answers the questions asked after an outage: status counts, the busiest and slowest endpoints, visitor sessions and an incident summary. It ends as a lazy pipeline of your own LINQ extension methods.",
  "level": "After module 6. Uses records, pattern matching, iterators and LINQ.",
  "skills": [
    "Split and list patterns",
    "TryParse",
    "CountBy and GroupBy",
    "OrderBy, Skip, Take, ElementAt",
    "Percentiles",
    "Iterators with yield",
    "Zip and Chunk",
    "Extension methods and lazy pipelines"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Parsing",
      "Model",
      "Queries",
      "Output"
    ],
    "parts": [
      {
        "id": "stdin",
        "label": "stdin log lines",
        "layer": "Input",
        "stage": 1
      },
      {
        "id": "parse",
        "label": "TryParseEntry",
        "layer": "Parsing",
        "stage": 1,
        "note": "Split + list pattern, garbage skipped"
      },
      {
        "id": "entry",
        "label": "Entry record",
        "layer": "Model",
        "stage": 1,
        "note": "Endpoint = method + path"
      },
      {
        "id": "counts",
        "label": "Status + endpoint counts",
        "layer": "Queries",
        "stage": 2,
        "note": "CountBy, GroupBy, Take"
      },
      {
        "id": "report",
        "label": "Printed report",
        "layer": "Output",
        "stage": 2
      },
      {
        "id": "latency",
        "label": "p50 / p95 latency",
        "layer": "Queries",
        "stage": 3,
        "note": "Order, ElementAt"
      },
      {
        "id": "sessions",
        "label": "Sessions iterator",
        "layer": "Queries",
        "stage": 4,
        "note": "yield return, Zip for gaps"
      },
      {
        "id": "pipeline",
        "label": "LogPipeline extensions",
        "layer": "Parsing",
        "stage": 5,
        "note": "lines.ParseEntries() is lazy"
      },
      {
        "id": "incident",
        "label": "Incident summary",
        "layer": "Output",
        "stage": 5,
        "note": "ServerErrors(), CountBy, Distinct"
      }
    ],
    "flow": [
      [
        "stdin",
        "parse"
      ],
      [
        "parse",
        "entry"
      ],
      [
        "stdin",
        "pipeline"
      ],
      [
        "pipeline",
        "entry"
      ],
      [
        "entry",
        "counts"
      ],
      [
        "entry",
        "latency"
      ],
      [
        "entry",
        "sessions"
      ],
      [
        "entry",
        "incident"
      ],
      [
        "counts",
        "report"
      ],
      [
        "latency",
        "report"
      ],
      [
        "sessions",
        "report"
      ],
      [
        "incident",
        "report"
      ]
    ]
  }
}
