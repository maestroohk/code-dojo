{
  "title": "Boss: The incident report",
  "summary": "Refactor the program into a lazy pipeline of your own extension methods, then write the incident summary.",
  "minutes": 22,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "Boss briefing: a pipeline of your own",
      "body": [
        "The program works, but the parser and the helpers are loose functions tangled into the top of the file. Real LINQ code reads as a pipeline, and you can build your own stages for it with **extension methods**: a `static` method in a `static class` whose first parameter has `this`.",
        "",
        "```csharp",
        "static class LogPipeline",
        "{",
        "    public static IEnumerable<Entry> ParseEntries(this IEnumerable<string> lines)",
        "    {",
        "        foreach (var line in lines)",
        "            if (TryParseEntry(line) is { } entry)",
        "                yield return entry;",
        "    }",
        "",
        "    public static IEnumerable<Entry> ServerErrors(this IEnumerable<Entry> entries) =>",
        "        entries.Where(e => e.Status >= 500);",
        "}",
        "```",
        "",
        "Now `lines.ParseEntries().ServerErrors()` reads like the built-in operators, and it is just as **lazy**: nothing is parsed until someone enumerates the result, and each line flows through every stage before the next line is read.",
        "",
        "Types go at the bottom of the file: top-level statements first, then `static class LogPipeline`, then the `Entry` record."
      ]
    },
    {
      "type": "predict",
      "prompt": "Lazy stages interleave. What does this print?",
      "code": [
        "var lines = new[] { \"a\", \"bb\", \"ccc\" };",
        "",
        "var lengths = lines",
        "    .Select(l => { Console.WriteLine($\"read {l}\"); return l.Length; })",
        "    .Where(n => { Console.WriteLine($\"check {n}\"); return n != 2; });",
        "",
        "Console.WriteLine(\"built\");",
        "foreach (var n in lengths)",
        "    Console.WriteLine($\"use {n}\");"
      ],
      "answer": [
        "built",
        "read a",
        "check 1",
        "use 1",
        "read bb",
        "check 2",
        "read ccc",
        "check 3",
        "use 3"
      ],
      "explain": "Building the query prints nothing. Then each item travels through `Select`, `Where` and the loop body before the next item is read. `2` is checked but never used."
    },
    {
      "type": "order",
      "prompt": "Arrange the extension method that turns lines into entries lazily.",
      "lines": [
        "static class LogPipeline",
        "{",
        "    public static IEnumerable<Entry> ParseEntries(this IEnumerable<string> lines)",
        "    {",
        "        foreach (var line in lines)",
        "            if (TryParseEntry(line) is { } entry)",
        "                yield return entry;",
        "    }",
        "}"
      ],
      "explain": "The method must live in a static class, its first parameter carries `this`, and `yield return` hands out each parsed entry as it is found."
    },
    {
      "type": "mcq",
      "prompt": "What makes `ParseEntries` callable as `lines.ParseEntries()`?",
      "options": [
        "It is `static`, in a `static` class, and its first parameter is marked `this`",
        "It returns an `IEnumerable<Entry>`",
        "It uses `yield return`",
        "The class is named after the type it extends"
      ],
      "answer": 0,
      "explain": "Those three things make an extension method. Returning `IEnumerable` and using `yield` make it a lazy LINQ-style stage, but they are not what lets you call it with a dot."
    },
    {
      "type": "code",
      "title": "Refactor into a pipeline",
      "carry": true,
      "prompt": [
        "Refactor without changing a single character of output.",
        "",
        "1. Add `static class LogPipeline` between the top-level statements and the `Entry` record.",
        "2. Move `TryParseEntry` into it as a `public static` method, and add the extension method `ParseEntries(this IEnumerable<string> lines)` that yields every line that parses.",
        "3. Turn `Percentile` and `Sessions` into extension methods in the same class (`this List<int> sorted`, `this IEnumerable<Entry> ordered`) and call them with a dot: `sorted.Percentile(95)`, `visitor.OrderBy(e => e.Time).Sessions(TimeSpan.FromMinutes(30))`.",
        "4. Build `entries` with `candidates.ParseEntries().ToList()`.",
        "",
        "The tests are the ones from stage 4: same input, same output."
      ],
      "starter": [
        "using System.Globalization;",
        "",
        "var lines = new List<string>();",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "    lines.Add(line);",
        "",
        "var candidates = lines.Where(l => !string.IsNullOrWhiteSpace(l)).ToList();",
        "",
        "var entries = candidates",
        "    .Select(TryParseEntry)",
        "    .OfType<Entry>()",
        "    .ToList();",
        "",
        "Console.WriteLine($\"Parsed: {entries.Count}, skipped: {candidates.Count - entries.Count}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Status codes:\");",
        "foreach (var (status, count) in entries.CountBy(e => e.Status).OrderBy(p => p.Key))",
        "    Console.WriteLine($\"{status}: {count}\");",
        "",
        "var topEndpoints = entries",
        "    .GroupBy(e => e.Endpoint)",
        "    .Select(g => new { Endpoint = g.Key, Hits = g.Count() })",
        "    .OrderByDescending(x => x.Hits)",
        "    .ThenBy(x => x.Endpoint)",
        "    .Take(3);",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Top endpoints:\");",
        "foreach (var x in topEndpoints)",
        "    Console.WriteLine($\"{x.Endpoint}: {x.Hits}\");",
        "",
        "var slowest = entries",
        "    .GroupBy(e => e.Endpoint)",
        "    .Select(g =>",
        "    {",
        "        var sorted = g.Select(e => e.Ms).Order().ToList();",
        "        return new",
        "        {",
        "            Endpoint = g.Key,",
        "            Count = sorted.Count,",
        "            P50 = Percentile(sorted, 50),",
        "            P95 = Percentile(sorted, 95),",
        "            Max = sorted[^1]",
        "        };",
        "    })",
        "    .OrderByDescending(x => x.P95)",
        "    .ThenBy(x => x.Endpoint)",
        "    .Take(3);",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Slowest endpoints:\");",
        "foreach (var x in slowest)",
        "    Console.WriteLine($\"{x.Endpoint}: p50={x.P50}ms p95={x.P95}ms max={x.Max}ms n={x.Count}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Sessions (gap over 30 min):\");",
        "foreach (var visitor in entries.GroupBy(e => e.Ip).OrderBy(g => g.Key))",
        "{",
        "    var sessions = Sessions(visitor.OrderBy(e => e.Time), TimeSpan.FromMinutes(30)).ToList();",
        "    var sizes = string.Join(\",\", sessions.Select(s => s.Count));",
        "",
        "    var times = visitor.Select(e => e.Time).Order().ToList();",
        "    var longestGap = times",
        "        .Zip(times.Skip(1), (earlier, later) => later - earlier)",
        "        .DefaultIfEmpty(TimeSpan.Zero)",
        "        .Max();",
        "",
        "    Console.WriteLine($\"{visitor.Key}: sessions={sessions.Count} sizes={sizes} longest-gap={(int)longestGap.TotalMinutes}m\");",
        "}",
        "",
        "Entry? TryParseEntry(string line)",
        "{",
        "    var parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);",
        "    if (parts is not [var stamp, var ip, var method, var path, var status, var took])",
        "        return null;",
        "    if (method is not (\"GET\" or \"POST\" or \"PUT\" or \"DELETE\"))",
        "        return null;",
        "    if (!DateTime.TryParseExact(stamp, \"yyyy-MM-ddTHH:mm:ss\", CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))",
        "        return null;",
        "    if (!int.TryParse(status, out var code))",
        "        return null;",
        "    if (!took.EndsWith(\"ms\") || !int.TryParse(took[..^2], out var ms))",
        "        return null;",
        "    return new Entry(time, ip, method, path, code, ms);",
        "}",
        "",
        "int Percentile(List<int> sorted, int p)",
        "{",
        "    var rank = (p * sorted.Count + 99) / 100;",
        "    return sorted.ElementAt(rank - 1);",
        "}",
        "",
        "IEnumerable<List<Entry>> Sessions(IEnumerable<Entry> ordered, TimeSpan gap)",
        "{",
        "    var current = new List<Entry>();",
        "    foreach (var e in ordered)",
        "    {",
        "        if (current.Count > 0 && e.Time - current[^1].Time > gap)",
        "        {",
        "            yield return current;",
        "            current = new List<Entry>();",
        "        }",
        "        current.Add(e);",
        "    }",
        "    if (current.Count > 0)",
        "        yield return current;",
        "}",
        "",
        "record Entry(DateTime Time, string Ip, string Method, string Path, int Status, int Ms)",
        "{",
        "    public string Endpoint => $\"{Method} {Path}\";",
        "}"
      ],
      "solution": [
        "using System.Globalization;",
        "",
        "var lines = new List<string>();",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "    lines.Add(line);",
        "",
        "var candidates = lines.Where(l => !string.IsNullOrWhiteSpace(l)).ToList();",
        "",
        "var entries = candidates.ParseEntries().ToList();",
        "",
        "Console.WriteLine($\"Parsed: {entries.Count}, skipped: {candidates.Count - entries.Count}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Status codes:\");",
        "foreach (var (status, count) in entries.CountBy(e => e.Status).OrderBy(p => p.Key))",
        "    Console.WriteLine($\"{status}: {count}\");",
        "",
        "var topEndpoints = entries",
        "    .GroupBy(e => e.Endpoint)",
        "    .Select(g => new { Endpoint = g.Key, Hits = g.Count() })",
        "    .OrderByDescending(x => x.Hits)",
        "    .ThenBy(x => x.Endpoint)",
        "    .Take(3);",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Top endpoints:\");",
        "foreach (var x in topEndpoints)",
        "    Console.WriteLine($\"{x.Endpoint}: {x.Hits}\");",
        "",
        "var slowest = entries",
        "    .GroupBy(e => e.Endpoint)",
        "    .Select(g =>",
        "    {",
        "        var sorted = g.Select(e => e.Ms).Order().ToList();",
        "        return new",
        "        {",
        "            Endpoint = g.Key,",
        "            Count = sorted.Count,",
        "            P50 = sorted.Percentile(50),",
        "            P95 = sorted.Percentile(95),",
        "            Max = sorted[^1]",
        "        };",
        "    })",
        "    .OrderByDescending(x => x.P95)",
        "    .ThenBy(x => x.Endpoint)",
        "    .Take(3);",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Slowest endpoints:\");",
        "foreach (var x in slowest)",
        "    Console.WriteLine($\"{x.Endpoint}: p50={x.P50}ms p95={x.P95}ms max={x.Max}ms n={x.Count}\");",
        "",
        "Console.WriteLine();",
        "Console.WriteLine(\"Sessions (gap over 30 min):\");",
        "foreach (var visitor in entries.GroupBy(e => e.Ip).OrderBy(g => g.Key))",
        "{",
        "    var sessions = visitor.OrderBy(e => e.Time).Sessions(TimeSpan.FromMinutes(30)).ToList();",
        "    var sizes = string.Join(\",\", sessions.Select(s => s.Count));",
        "",
        "    var times = visitor.Select(e => e.Time).Order().ToList();",
        "    var longestGap = times",
        "        .Zip(times.Skip(1), (earlier, later) => later - earlier)",
        "        .DefaultIfEmpty(TimeSpan.Zero)",
        "        .Max();",
        "",
        "    Console.WriteLine($\"{visitor.Key}: sessions={sessions.Count} sizes={sizes} longest-gap={(int)longestGap.TotalMinutes}m\");",
        "}",
        "",
        "static class LogPipeline",
        "{",
        "    public static IEnumerable<Entry> ParseEntries(this IEnumerable<string> lines)",
        "    {",
        "        foreach (var line in lines)",
        "        {",
        "            if (TryParseEntry(line) is { } entry)",
        "                yield return entry;",
        "        }",
        "    }",
        "",
        "    public static Entry? TryParseEntry(string line)",
        "    {",
        "        var parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);",
        "        if (parts is not [var stamp, var ip, var method, var path, var status, var took])",
        "            return null;",
        "        if (method is not (\"GET\" or \"POST\" or \"PUT\" or \"DELETE\"))",
        "            return null;",
        "        if (!DateTime.TryParseExact(stamp, \"yyyy-MM-ddTHH:mm:ss\", CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))",
        "            return null;",
        "        if (!int.TryParse(status, out var code))",
        "            return null;",
        "        if (!took.EndsWith(\"ms\") || !int.TryParse(took[..^2], out var ms))",
        "            return null;",
        "        return new Entry(time, ip, method, path, code, ms);",
        "    }",
        "",
        "    public static int Percentile(this List<int> sorted, int p)",
        "    {",
        "        var rank = (p * sorted.Count + 99) / 100;",
        "        return sorted.ElementAt(rank - 1);",
        "    }",
        "",
        "    public static IEnumerable<List<Entry>> Sessions(this IEnumerable<Entry> ordered, TimeSpan gap)",
        "    {",
        "        var current = new List<Entry>();",
        "        foreach (var e in ordered)",
        "        {",
        "            if (current.Count > 0 && e.Time - current[^1].Time > gap)",
        "            {",
        "                yield return current;",
        "                current = new List<Entry>();",
        "            }",
        "            current.Add(e);",
        "        }",
        "        if (current.Count > 0)",
        "            yield return current;",
        "    }",
        "}",
        "",
        "record Entry(DateTime Time, string Ip, string Method, string Path, int Status, int Ms)",
        "{",
        "    public string Endpoint => $\"{Method} {Path}\";",
        "}"
      ],
