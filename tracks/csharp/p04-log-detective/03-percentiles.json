          "name": "a quiet morning",
          "stdin": [
            "2026-05-01T08:00:00 192.168.1.5 GET /index 200 12ms",
            "2026-05-01T08:00:01 192.168.1.5 GET /style.css 200 4ms",
            "2026-05-01T08:20:00 192.168.1.5 GET /index 304 2ms",
            "2026-05-01T08:59:00 192.168.1.9 POST /login 302 88ms",
            "2026-05-01T09:00:30 192.168.1.5 GET /index 200 15ms",
            "2026-05-01T09:01:00 192.168.1.9 GET /index 200 11ms"
          ],
          "expect": [
            "Parsed: 6, skipped: 0",
            "",
            "Status codes:",
            "200: 4",
            "302: 1",
            "304: 1",
            "",
            "Top endpoints:",
            "GET /index: 4",
            "GET /style.css: 1",
            "POST /login: 1",
            "",
            "Slowest endpoints:",
            "POST /login: p50=88ms p95=88ms max=88ms n=1",
            "GET /index: p50=11ms p95=15ms max=15ms n=4",
            "GET /style.css: p50=4ms p95=4ms max=4ms n=1"
          ]
        },
        {
          "name": "an empty log",
          "stdin": "",
          "expect": [
            "Parsed: 0, skipped: 0",
            "",
            "Status codes:",
            "",
            "Top endpoints:",
            "",
            "Slowest endpoints:"
          ]
        }
      ],
      "require": [
        {
          "pattern": "\\.ElementAt\\(",
          "message": "Picks the percentile with ElementAt"
        },
        {
          "pattern": "\\.Order(By)?\\(",
          "message": "Sorts the durations"
        }
      ],
      "hints": [
        "Inside `Select(g => { ... })`: `var sorted = g.Select(e => e.Ms).Order().ToList();`",
        "Return `new { Endpoint = g.Key, Count = sorted.Count, P50 = Percentile(sorted, 50), P95 = Percentile(sorted, 95), Max = sorted[^1] }`.",
        "Sort with `.OrderByDescending(x => x.P95).ThenBy(x => x.Endpoint).Take(3)`."
      ]
    }
  ]
