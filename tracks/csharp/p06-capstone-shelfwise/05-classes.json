      "starter": [
        "string library = \"Shelfwise\";",
        "int version = 1;",
        "var books = new List<(string Isbn, string Title, string Author, int Year, int Copies)>();",
        "var isbns = new HashSet<string>();",
        "",
        "Console.WriteLine($\"{library} v{version}. Type help for commands.\");",
        "",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "{",
        "    line = line.Trim();",
        "    if (line == \"\") continue;",
        "",
        "    var (command, rest) = SplitCommand(line);",
        "    if (command == \"quit\") break;",
        "",
        "    switch (command)",
        "    {",
        "        case \"help\":",
        "            Console.WriteLine(\"Commands: add, list, find, authors, stats, fine, help, quit\");",
        "            break;",
        "        case \"add\":",
        "            Console.WriteLine(AddBook(rest));",
        "            break;",
        "        case \"list\":",
        "            PrintBooks(books, \"No books yet.\");",
        "            break;",
        "        case \"find\":",
        "            PrintBooks(FindBooks(rest), $\"No books match \\\"{rest}\\\".\");",
        "            break;",
        "        case \"authors\":",
        "            PrintAuthors();",
        "            break;",
        "        case \"stats\":",
        "            Console.WriteLine(Stats());",
        "            break;",
        "        case \"fine\":",
