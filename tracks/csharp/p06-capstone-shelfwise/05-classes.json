        "        case \"authors\":",
        "            PrintAuthors();",
        "            break;",
        "        case \"stats\":",
        "            Console.WriteLine(Stats());",
        "            break;",
        "        case \"fine\":",
        "            Console.WriteLine(FineMessage(rest));",
