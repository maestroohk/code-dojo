      "starter": [
        "string library = \"Shelfwise\";",
        "int version = 1;",
        "var catalog = new Catalog();",
        "",
        "Console.WriteLine($\"{library} v{version}. Type help for commands.\");",
        "",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "{",
        "    line = line.Trim();",
        "    if (line == \"\") continue;",
        "",
        "    var (command, rest) = SplitCommand(line);",
        "    if (command == \"quit\") break;",
        "",
        "    switch (command)",
        "    {",
        "        case \"help\":",
        "            Console.WriteLine(\"Commands: add, list, find, authors, stats, fine, help, quit\");",
