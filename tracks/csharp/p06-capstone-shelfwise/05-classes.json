        "Console.WriteLine(\"Bye.\");",
        "",
        "(string Command, string Args) SplitCommand(string text)",
        "{",
        "    int space = text.IndexOf(' ');",
        "    if (space < 0) return (text.ToLowerInvariant(), \"\");",
        "    return (text.Substring(0, space).ToLowerInvariant(), text.Substring(space + 1).Trim());",
        "}",
        "",
        "string AddBook(string text)",
        "{",
        "    string[] parts = text.Split('|');",
        "    string? error = ValidateBook(parts, out int year, out int count);",
        "    if (error is not null) return \"Error: \" + error;",
        "    var book = new Book(parts[0], parts[1], parts[2], year, count);",
        "    if (!catalog.Add(book)) return $\"Error: ISBN {parts[0]} is already in the catalog\";",
        "",
        "    return $\"Added: {parts[1]} ({year})\";",
        "}",
        "",
        "string? ValidateBook(string[] parts, out int year, out int count)",
        "{",
        "    year = 0;",
        "    count = 0;",
        "    if (parts.Length != 5) return \"use add isbn|title|author|year|copies\";",
        "    if (parts[1].Trim() == \"\") return \"title is required\";",
        "    if (!int.TryParse(parts[3], out year) || year < 1450 || year > 2026) return \"year must be a number from 1450 to 2026\";",
        "    if (!int.TryParse(parts[4], out count) || count < 1) return \"copies must be a whole number of at least 1\";",
        "    return null;",
        "}",
        "",
        "string Stats()",
        "{",
        "    if (catalog.All.Count == 0) return \"Books: 0 | Copies: 0\";",
        "",
        "    int copies = 0;",
        "    int oldest = int.MaxValue;",
        "    foreach (var book in catalog.All)",
        "    {",
        "        copies += book.TotalCopies;",
        "        if (book.Year < oldest) oldest = book.Year;",
        "    }",
        "    return $\"Books: {catalog.All.Count} | Copies: {copies} | Oldest: {oldest}\";",
        "}",
        "",
        "void PrintBooks(IReadOnlyList<Book> list, string whenEmpty)",
        "{",
        "    if (list.Count == 0)",
        "    {",
        "        Console.WriteLine(whenEmpty);",
        "        return;",
        "    }",
        "    foreach (var book in list)",
        "        Console.WriteLine(book);",
        "}",
        "",
        "void PrintAuthors()",
        "{",
        "    if (catalog.All.Count == 0)",
        "    {",
        "        Console.WriteLine(\"No books yet.\");",
        "        return;",
        "    }",
        "",
        "    var perAuthor = new Dictionary<string, int>();",
        "    foreach (var book in catalog.All)",
        "        perAuthor[book.Author] = perAuthor.GetValueOrDefault(book.Author) + 1;",
        "",
        "    var names = new List<string>(perAuthor.Keys);",
        "    names.Sort(StringComparer.Ordinal);",
        "    foreach (var name in names)",
        "        Console.WriteLine($\"{name}: {Plural(perAuthor[name], \"book\")}\");",
        "}",
        "",
        "string FineMessage(string text)",
        "{",
        "    if (!int.TryParse(text, out int days) || days < 0) return \"Error: use fine <days late>\";",
        "    return $\"Fine for {Plural(days, \"day\")} late: {FineFor(days):C}\";",
        "}",
        "",
        "string Plural(int n, string word) => n == 1 ? $\"{n} {word}\" : $\"{n} {word}s\";",
        "",
        "decimal FineFor(int daysLate, decimal perDay = 0.50m) => Math.Min(daysLate * perDay, 10.00m);",
        "",
        "class Book",
        "{",
        "    public Book(string isbn, string title, string author, int year, int copies)",
        "    {",
        "        Isbn = isbn;",
        "        Title = title;",
        "        Author = author;",
        "        Year = year;",
        "        TotalCopies = copies;",
        "        AvailableCopies = copies;",
        "    }",
        "",
        "    public string Isbn { get; }",
        "    public string Title { get; }",
        "    public string Author { get; }",
        "    public int Year { get; }",
        "    public int TotalCopies { get; }",
        "    public int AvailableCopies { get; private set; }",
        "",
        "    public override string ToString() =>",
        "        $\"{Isbn} | {Title} | {Author} | {Year} | {AvailableCopies}/{TotalCopies} in\";",
        "}",
        "",
        "class Catalog",
        "{",
        "    private readonly List<Book> _books = new();",
        "    private readonly Dictionary<string, Book> _byIsbn = new();",
        "",
        "    public IReadOnlyList<Book> All => _books;",
        "",
        "    public bool Add(Book book)",
        "    {",
        "        if (!_byIsbn.TryAdd(book.Isbn, book)) return false;",
        "        _books.Add(book);",
        "        return true;",
        "    }",
        "",
        "    public Book? Find(string isbn) => _byIsbn.TryGetValue(isbn, out var book) ? book : null;",
        "",
        "    public List<Book> Search(string text)",
        "    {",
        "        var found = new List<Book>();",
        "        foreach (var book in _books)",
        "        {",
        "            if (book.Title.Contains(text, StringComparison.OrdinalIgnoreCase)",
        "                || book.Author.Contains(text, StringComparison.OrdinalIgnoreCase))",
        "                found.Add(book);",
        "        }",
        "        return found;",
        "    }",
        "}"
      ],
      "solution": [
        "string library = \"Shelfwise\";",
        "int version = 1;",
        "var catalog = new Catalog();",
        "",
        "Console.WriteLine($\"{library} v{version}. Type help for commands.\");",
        "",
        "string? line;",
        "while ((line = Console.ReadLine()) is not null)",
        "{",
        "    line = line.Trim();",
        "    if (line == \"\") continue;",
        "",
        "    var (command, rest) = SplitCommand(line);",
        "    if (command == \"quit\") break;",
        "",
        "    switch (command)",
        "    {",
        "        case \"help\":",
        "            Console.WriteLine(\"Commands: add, list, find, authors, lend, return, stats, fine, help, quit\");",
        "            break;",
        "        case \"add\":",
        "            Console.WriteLine(AddBook(rest));",
        "            break;",
        "        case \"list\":",
        "            PrintBooks(catalog.All, \"No books yet.\");",
        "            break;",
        "        case \"find\":",
        "            PrintBooks(catalog.Search(rest), $\"No books match \\\"{rest}\\\".\");",
        "            break;",
        "        case \"authors\":",
        "            PrintAuthors();",
        "            break;",
        "        case \"lend\":",
        "            Console.WriteLine(Lend(rest));",
        "            break;",
        "        case \"return\":",
        "            Console.WriteLine(Return(rest));",
        "            break;",
        "        case \"stats\":",
        "            Console.WriteLine(Stats());",
        "            break;",
        "        case \"fine\":",
        "            Console.WriteLine(FineMessage(rest));",
        "            break;",
        "        default:",
        "            Console.WriteLine($\"Unknown command: {command}\");",
        "            break;",
        "    }",
        "}",
        "",
        "Console.WriteLine(\"Bye.\");",
        "",
        "(string Command, string Args) SplitCommand(string text)",
        "{",
        "    int space = text.IndexOf(' ');",
        "    if (space < 0) return (text.ToLowerInvariant(), \"\");",
        "    return (text.Substring(0, space).ToLowerInvariant(), text.Substring(space + 1).Trim());",
        "}",
        "",
        "string AddBook(string text)",
        "{",
        "    string[] parts = text.Split('|');",
        "    string? error = ValidateBook(parts, out int year, out int count);",
        "    if (error is not null) return \"Error: \" + error;",
        "    var book = new Book(parts[0], parts[1], parts[2], year, count);",
        "    if (!catalog.Add(book)) return $\"Error: ISBN {parts[0]} is already in the catalog\";",
        "",
        "    return $\"Added: {parts[1]} ({year})\";",
        "}",
        "",
        "string? ValidateBook(string[] parts, out int year, out int count)",
        "{",
        "    year = 0;",
        "    count = 0;",
        "    if (parts.Length != 5) return \"use add isbn|title|author|year|copies\";",
        "    if (parts[1].Trim() == \"\") return \"title is required\";",
        "    if (!int.TryParse(parts[3], out year) || year < 1450 || year > 2026) return \"year must be a number from 1450 to 2026\";",
        "    if (!int.TryParse(parts[4], out count) || count < 1) return \"copies must be a whole number of at least 1\";",
        "    return null;",
        "}",
        "",
        "string Stats()",
        "{",
        "    if (catalog.All.Count == 0) return \"Books: 0 | Copies: 0\";",
        "",
        "    int copies = 0;",
        "    int onLoan = 0;",
        "    int oldest = int.MaxValue;",
        "    foreach (var book in catalog.All)",
        "    {",
        "        copies += book.TotalCopies;",
        "        onLoan += book.TotalCopies - book.AvailableCopies;",
        "        if (book.Year < oldest) oldest = book.Year;",
        "    }",
        "    return $\"Books: {catalog.All.Count} | Copies: {copies} | On loan: {onLoan} | Oldest: {oldest}\";",
        "}",
        "",
        "string Lend(string isbn)",
        "{",
        "    Book? book = catalog.Find(isbn);",
        "    if (book is null) return $\"Error: no book with ISBN {isbn}\";",
        "    if (!book.TryLend()) return $\"Error: no copies of {book.Title} are in\";",
        "    return $\"Lent: {book.Title} ({book.AvailableCopies}/{book.TotalCopies} in)\";",
        "}",
        "",
        "string Return(string isbn)",
        "{",
        "    Book? book = catalog.Find(isbn);",
        "    if (book is null) return $\"Error: no book with ISBN {isbn}\";",
        "    if (!book.TryReturn()) return $\"Error: every copy of {book.Title} is already in\";",
        "    return $\"Returned: {book.Title} ({book.AvailableCopies}/{book.TotalCopies} in)\";",
        "}",
        "",
        "void PrintBooks(IReadOnlyList<Book> list, string whenEmpty)",
        "{",
        "    if (list.Count == 0)",
        "    {",
        "        Console.WriteLine(whenEmpty);",
        "        return;",
        "    }",
        "    foreach (var book in list)",
        "        Console.WriteLine(book);",
        "}",
        "",
        "void PrintAuthors()",
        "{",
        "    if (catalog.All.Count == 0)",
        "    {",
        "        Console.WriteLine(\"No books yet.\");",
        "        return;",
        "    }",
        "",
        "    var perAuthor = new Dictionary<string, int>();",
        "    foreach (var book in catalog.All)",
        "        perAuthor[book.Author] = perAuthor.GetValueOrDefault(book.Author) + 1;",
        "",
        "    var names = new List<string>(perAuthor.Keys);",
        "    names.Sort(StringComparer.Ordinal);",
        "    foreach (var name in names)",
        "        Console.WriteLine($\"{name}: {Plural(perAuthor[name], \"book\")}\");",
        "}",
        "",
        "string FineMessage(string text)",
        "{",
        "    if (!int.TryParse(text, out int days) || days < 0) return \"Error: use fine <days late>\";",
        "    return $\"Fine for {Plural(days, \"day\")} late: {FineFor(days):C}\";",
        "}",
        "",
        "string Plural(int n, string word) => n == 1 ? $\"{n} {word}\" : $\"{n} {word}s\";",
        "",
        "decimal FineFor(int daysLate, decimal perDay = 0.50m) => Math.Min(daysLate * perDay, 10.00m);",
        "",
        "class Book",
        "{",
        "    public Book(string isbn, string title, string author, int year, int copies)",
        "    {",
        "        Isbn = isbn;",
        "        Title = title;",
        "        Author = author;",
        "        Year = year;",
        "        TotalCopies = copies;",
        "        AvailableCopies = copies;",
        "    }",
        "",
        "    public string Isbn { get; }",
        "    public string Title { get; }",
        "    public string Author { get; }",
        "    public int Year { get; }",
        "    public int TotalCopies { get; }",
        "    public int AvailableCopies { get; private set; }",
        "",
        "    public bool TryLend()",
        "    {",
        "        if (AvailableCopies == 0) return false;",
        "        AvailableCopies--;",
        "        return true;",
        "    }",
        "",
        "    public bool TryReturn()",
        "    {",
        "        if (AvailableCopies == TotalCopies) return false;",
        "        AvailableCopies++;",
        "        return true;",
        "    }",
        "",
        "    public override string ToString() =>",
        "        $\"{Isbn} | {Title} | {Author} | {Year} | {AvailableCopies}/{TotalCopies} in\";",
        "}",
        "",
        "class Catalog",
        "{",
        "    private readonly List<Book> _books = new();",
        "    private readonly Dictionary<string, Book> _byIsbn = new();",
        "",
        "    public IReadOnlyList<Book> All => _books;",
        "",
        "    public bool Add(Book book)",
        "    {",
        "        if (!_byIsbn.TryAdd(book.Isbn, book)) return false;",
        "        _books.Add(book);",
        "        return true;",
        "    }",
        "",
        "    public Book? Find(string isbn) => _byIsbn.TryGetValue(isbn, out var book) ? book : null;",
        "",
        "    public List<Book> Search(string text)",
        "    {",
        "        var found = new List<Book>();",
        "        foreach (var book in _books)",
        "        {",
        "            if (book.Title.Contains(text, StringComparison.OrdinalIgnoreCase)",
        "                || book.Author.Contains(text, StringComparison.OrdinalIgnoreCase))",
        "                found.Add(book);",
        "        }",
        "        return found;",
        "    }",
        "}"
      ],
      "tests": [
        {
          "name": "lend until empty, then return",
          "stdin": [
            "add 978-0441172719|Dune|Frank Herbert|1965|2",
            "lend 978-0441172719",
            "lend 978-0441172719",
            "lend 978-0441172719",
            "list",
            "stats",
            "return 978-0441172719",
            "return 978-0441172719",
            "return 978-0441172719",
            "stats"
          ],
          "expect": [
            "Shelfwise v1. Type help for commands.",
            "Added: Dune (1965)",
            "Lent: Dune (1/2 in)",
            "Lent: Dune (0/2 in)",
            "Error: no copies of Dune are in",
            "978-0441172719 | Dune | Frank Herbert | 1965 | 0/2 in",
            "Books: 1 | Copies: 2 | On loan: 2 | Oldest: 1965",
            "Returned: Dune (1/2 in)",
            "Returned: Dune (2/2 in)",
            "Error: every copy of Dune is already in",
            "Books: 1 | Copies: 2 | On loan: 0 | Oldest: 1965",
            "Bye."
          ]
        },
        {
          "name": "unknown ISBNs",
          "stdin": [
            "lend 123",
            "return 123",
            "help"
          ],
          "expect": [
            "Shelfwise v1. Type help for commands.",
            "Error: no book with ISBN 123",
            "Error: no book with ISBN 123",
            "Commands: add, list, find, authors, lend, return, stats, fine, help, quit",
            "Bye."
          ]
        },
        {
          "name": "everything else still works",
          "stdin": [
            "add 978-0261103344|The Hobbit|J.R.R. Tolkien|1937|3",
            "add 978-0441172719|Dune|Frank Herbert|1965|1",
            "add 978-0618640157|The Lord of the Rings|J.R.R. Tolkien|1954|2",
            "lend 978-0261103344",
            "find hobbit",
            "authors",
            "fine 1",
            "stats"
          ],
          "expect": [
            "Shelfwise v1. Type help for commands.",
            "Added: The Hobbit (1937)",
            "Added: Dune (1965)",
            "Added: The Lord of the Rings (1954)",
            "Lent: The Hobbit (2/3 in)",
            "978-0261103344 | The Hobbit | J.R.R. Tolkien | 1937 | 2/3 in",
            "Frank Herbert: 1 book",
            "J.R.R. Tolkien: 2 books",
            "Fine for 1 day late: $0.50",
            "Books: 3 | Copies: 6 | On loan: 1 | Oldest: 1937",
            "Bye."
          ]
        }
      ],
      "hints": [
        "`TryReturn` mirrors `TryLend`: refuse when `AvailableCopies == TotalCopies`, otherwise `AvailableCopies++`.",
        "`Lend(string isbn)` finds the book (`Book? book = catalog.Find(isbn);`), returns the error when it is `null`, then calls `book.TryLend()`.",
        "In `Stats`, the copies on loan for one book are `book.TotalCopies - book.AvailableCopies`."
      ]
    }
  ]
}
