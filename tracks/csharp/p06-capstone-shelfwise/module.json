{
  "kind": "project",
  "title": "Capstone: Shelfwise",
  "summary": "Build Shelfwise, the system a public library runs on, from a single catalog card to a layered, tested, authenticated web API, in 32 stages that each start from your own code. Books, members, loans, policies, fines, reports, files, background reminders, dependency injection and HTTP: the whole C# language, in one application you write yourself.",
  "level": "The capstone: after the whole C# track (each stage links the lessons it needs)",
  "skills": [
    "Variables, control flow and methods",
    "Collections and LINQ",
    "Classes, records, enums and structs",
    "Inheritance and interfaces",
    "Value objects and validation",
    "Nullability, exceptions and Result<T>",
    "Pattern matching",
    "Generics, delegates and events",
    "JSON, versioned formats and CSV",
    "async/await, Task.WhenAll, cancellation, IAsyncEnumerable",
    "Layered architecture and dependency injection",
    "Minimal APIs, ProblemDetails, paging, middleware, API keys",
    "Writing your own tests",
    "SOLID refactoring and performance"
  ],
  "blueprint": {
    "layers": [
      "Console/UI",
      "API",
      "Application",
      "Domain",
      "Infrastructure",
      "Tests"
    ],
    "parts": [
