{
  "title": "Boss: the fleet inventory",
  "summary": "Identify every machine in a mixed fleet from what it reports.",
  "minutes": 15,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "A mixed fleet",
      "body": "You inherited 40 machines: some Ubuntu, some Rocky, a few Alpine containers and one forgotten SUSE box. A script has collected `/etc/os-release` and `uname -r` from each. Turn that into an inventory."
    },
    {
      "type": "code",
      "mode": "write",
      "title": "One line per machine",
      "prompt": [
        "Write `string Summarize(string host, string osRelease, string unameR)` returning `\"<host>: <PRETTY_NAME> [<family>] kernel <unameR>\"`.",
        "",
        "- `PRETTY_NAME` falls back to `NAME VERSION_ID` (joined with a space, skipping missing parts), then to `\"Linux\"`.",
        "- `<family>` follows the rules of lesson 3 (`debian`, `rhel`, `suse`, `arch`, `alpine`, `unknown`).",
        "- `unameR` is trimmed.",
        "",
        "Include your `ParseOsRelease` and `Family` helpers."
      ],
      "starter": [
        "Dictionary<string, string> ParseOsRelease(string text)",
        "{",
        "    var result = new Dictionary<string, string>();",
        "    foreach (var raw in text.Split('\\n'))",
        "    {",
        "        var line = raw.Trim();",
        "        if (line.Length == 0 || line.StartsWith(\"#\")) continue;",
        "        int eq = line.IndexOf('=');",
        "        if (eq <= 0) continue;",
        "        var key = line.Substring(0, eq);",
        "        var value = line.Substring(eq + 1);",
        "        if (value.Length >= 2 && (value[0] == '\"' || value[0] == '\\'') && value[^1] == value[0])",
        "            value = value.Substring(1, value.Length - 2);",
        "        result[key] = value;",
        "    }",
        "    return result;",
        "}",
        "",
        "string Family(Dictionary<string, string> os)",
        "{",
        "    var ids = new List<string>();",
        "    if (os.TryGetValue(\"ID\", out var id)) ids.Add(id.ToLowerInvariant());",
        "    if (os.TryGetValue(\"ID_LIKE\", out var like)) ids.AddRange(like.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));",
        "    foreach (var x in ids)",
        "    {",
        "        if (x == \"debian\" || x == \"ubuntu\") return \"debian\";",
        "        if (x == \"rhel\" || x == \"fedora\" || x == \"centos\" || x == \"amzn\") return \"rhel\";",
        "        if (x == \"suse\" || x.StartsWith(\"opensuse\") || x == \"sles\") return \"suse\";",
        "        if (x == \"arch\") return \"arch\";",
        "        if (x == \"alpine\") return \"alpine\";",
        "    }",
        "    return \"unknown\";",
        "}",
        "",
        "string Summarize(string host, string osRelease, string unameR)",
        "{",
        "    return \"\";",
        "}"
      ],
      "solution": [
        "Dictionary<string, string> ParseOsRelease(string text)",
        "{",
        "    var result = new Dictionary<string, string>();",
        "    foreach (var raw in text.Split('\\n'))",
        "    {",
        "        var line = raw.Trim();",
        "        if (line.Length == 0 || line.StartsWith(\"#\")) continue;",
        "        int eq = line.IndexOf('=');",
        "        if (eq <= 0) continue;",
        "        var key = line.Substring(0, eq);",
        "        var value = line.Substring(eq + 1);",
        "        if (value.Length >= 2 && (value[0] == '\"' || value[0] == '\\'') && value[^1] == value[0])",
        "            value = value.Substring(1, value.Length - 2);",
        "        result[key] = value;",
        "    }",
        "    return result;",
        "}",
        "",
        "string Family(Dictionary<string, string> os)",
        "{",
        "    var ids = new List<string>();",
        "    if (os.TryGetValue(\"ID\", out var id)) ids.Add(id.ToLowerInvariant());",
        "    if (os.TryGetValue(\"ID_LIKE\", out var like)) ids.AddRange(like.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));",
        "    foreach (var x in ids)",
        "    {",
        "        if (x == \"debian\" || x == \"ubuntu\") return \"debian\";",
        "        if (x == \"rhel\" || x == \"fedora\" || x == \"centos\" || x == \"amzn\") return \"rhel\";",
        "        if (x == \"suse\" || x.StartsWith(\"opensuse\") || x == \"sles\") return \"suse\";",
        "        if (x == \"arch\") return \"arch\";",
        "        if (x == \"alpine\") return \"alpine\";",
        "    }",
        "    return \"unknown\";",
        "}",
        "",
        "string Summarize(string host, string osRelease, string unameR)",
        "{",
        "    var os = ParseOsRelease(osRelease);",
        "    string name;",
        "    if (os.TryGetValue(\"PRETTY_NAME\", out var pretty) && pretty.Length > 0) name = pretty;",
        "    else",
        "    {",
        "        var parts = new List<string>();",
        "        if (os.TryGetValue(\"NAME\", out var n) && n.Length > 0) parts.Add(n);",
        "        if (os.TryGetValue(\"VERSION_ID\", out var v) && v.Length > 0) parts.Add(v);",
        "        name = parts.Count > 0 ? string.Join(\" \", parts) : \"Linux\";",
        "    }",
        "    return $\"{host}: {name} [{Family(os)}] kernel {unameR.Trim()}\";",
        "}"
      ],
      "hints": [
        "Parse once, then build the name with fallbacks."
      ],
      "template": [
        "{{CODE}}",
        "Dojo.Eq(\"ubuntu\", \"web1: Ubuntu 24.04.1 LTS [debian] kernel 6.8.0-45-generic\", Summarize(\"web1\", \"PRETTY_NAME=\\\"Ubuntu 24.04.1 LTS\\\"\\nID=ubuntu\\nID_LIKE=debian\", \"6.8.0-45-generic\\n\"));",
        "Dojo.Eq(\"rocky without PRETTY_NAME\", \"db1: Rocky Linux 9.4 [rhel] kernel 5.14.0-427.el9.x86_64\", Summarize(\"db1\", \"NAME=\\\"Rocky Linux\\\"\\nVERSION_ID=\\\"9.4\\\"\\nID=\\\"rocky\\\"\\nID_LIKE=\\\"rhel centos fedora\\\"\", \"5.14.0-427.el9.x86_64\"));",
        "Dojo.Eq(\"nothing known\", \"box: Linux [unknown] kernel 4.19.0\", Summarize(\"box\", \"\", \" 4.19.0 \"));"
      ]
    },
    {
      "type": "code",
      "mode": "write",
      "title": "Count the fleet",
      "prompt": "Write `List<string> Inventory(List<(string Id, string IdLike, string Version)> machines)` returning counts per family and version, sorted by family then version (ordinal), as `\"<family> <version>: <count>\"`. Use the family rules from lesson 3 on `Id` then the words of `IdLike`. Machines whose family is unknown are grouped as `\"unknown\"` with their version.",
      "starter": [
        "List<string> Inventory(List<(string Id, string IdLike, string Version)> machines)",
        "{",
        "    return new List<string>();",
        "}"
      ],
      "solution": [
        "string FamilyOf(string id, string idLike)",
        "{",
        "    var words = new List<string> { id.ToLowerInvariant() };",
        "    words.AddRange(idLike.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));",
        "    foreach (var x in words)",
        "    {",
        "        if (x == \"debian\" || x == \"ubuntu\") return \"debian\";",
        "        if (x == \"rhel\" || x == \"fedora\" || x == \"centos\" || x == \"amzn\") return \"rhel\";",
        "        if (x == \"suse\" || x.StartsWith(\"opensuse\") || x == \"sles\") return \"suse\";",
        "        if (x == \"arch\") return \"arch\";",
        "        if (x == \"alpine\") return \"alpine\";",
        "    }",
        "    return \"unknown\";",
        "}",
        "",
        "List<string> Inventory(List<(string Id, string IdLike, string Version)> machines)",
        "{",
        "    return machines",
        "        .GroupBy(m => (Family: FamilyOf(m.Id, m.IdLike), m.Version))",
        "        .OrderBy(g => g.Key.Family, StringComparer.Ordinal)",
        "        .ThenBy(g => g.Key.Version, StringComparer.Ordinal)",
        "        .Select(g => $\"{g.Key.Family} {g.Key.Version}: {g.Count()}\")",
        "        .ToList();",
        "}"
      ],
      "hints": [
        "`GroupBy` a tuple of family and version.",
        "Sort with `StringComparer.Ordinal` twice: `OrderBy` then `ThenBy`."
      ],
      "template": [
        "{{CODE}}",
        "var dojoFleet = new List<(string, string, string)>",
        "{",
        "    (\"ubuntu\", \"debian\", \"24.04\"), (\"ubuntu\", \"debian\", \"22.04\"), (\"ubuntu\", \"debian\", \"24.04\"),",
        "    (\"rocky\", \"rhel centos fedora\", \"9.4\"), (\"almalinux\", \"rhel centos fedora\", \"9.4\"),",
        "    (\"alpine\", \"\", \"3.20.3\"), (\"sles\", \"suse\", \"15.5\"), (\"nixos\", \"\", \"24.05\"), (\"debian\", \"\", \"12\")",
        "};",
        "Dojo.Eq(\"inventory\", new List<string> {",
        "    \"alpine 3.20.3: 1\",",
        "    \"debian 12: 1\",",
        "    \"debian 22.04: 1\",",
        "    \"debian 24.04: 2\",",
        "    \"rhel 9.4: 2\",",
        "    \"suse 15.5: 1\",",
        "    \"unknown 24.05: 1\" }, Inventory(dojoFleet));",
        "Dojo.Eq(\"empty fleet\", new List<string>(), Inventory(new List<(string, string, string)>()));"
      ]
    },
    {
      "type": "code",
      "mode": "write",
      "title": "End-of-life report",
      "prompt": [
        "Write `List<string> PastEol(List<(string Host, string Id, string VersionId)> machines, int year)` listing hosts whose release is out of standard support in `year` (support has ended when `endYear < year`), sorted by host, as `\"<host> (<id> <version>, ended <endYear>)\"`.",
        "",
        "Support end years:",
        "",
        "| id | rule |",
        "|---|---|",
        "| `ubuntu` | LTS (`.04` of an even year): `2000 + yy + 5`; other releases: `2000 + yy + 1` |",
        "| `debian` | major version 10 → 2024, 11 → 2026, 12 → 2028 |",
        "| `rocky`, `almalinux`, `rhel` | major 8 → 2029, 9 → 2032 |",
        "| `centos` | any → 2024 (CentOS Linux is end of life) |",
        "",
        "Unknown ids or versions are skipped."
      ],
      "starter": [
        "List<string> PastEol(List<(string Host, string Id, string VersionId)> machines, int year)",
        "{",
        "    return new List<string>();",
        "}"
      ],
      "solution": [
        "int EndYear(string id, string version)",
        "{",
        "    var parts = version.Split('.');",
        "    if (!int.TryParse(parts[0], out var major)) return -1;",
        "    switch (id)",
        "    {",
        "        case \"ubuntu\":",
        "            if (parts.Length < 2 || !int.TryParse(parts[1], out var month)) return -1;",
        "            return 2000 + major + (month == 4 && major % 2 == 0 ? 5 : 1);",
        "        case \"debian\":",
        "            return major switch { 10 => 2024, 11 => 2026, 12 => 2028, _ => -1 };",
        "        case \"rocky\":",
        "        case \"almalinux\":",
        "        case \"rhel\":",
        "            return major switch { 8 => 2029, 9 => 2032, _ => -1 };",
        "        case \"centos\":",
        "            return 2024;",
        "        default:",
        "            return -1;",
        "    }",
        "}",
        "",
        "List<string> PastEol(List<(string Host, string Id, string VersionId)> machines, int year)",
        "{",
        "    var result = new List<(string Host, string Line)>();",
        "    foreach (var m in machines)",
        "    {",
        "        int end = EndYear(m.Id, m.VersionId);",
        "        if (end > 0 && end < year) result.Add((m.Host, $\"{m.Host} ({m.Id} {m.VersionId}, ended {end})\"));",
        "    }",
        "    return result.OrderBy(r => r.Host, StringComparer.Ordinal).Select(r => r.Line).ToList();",
        "}"
      ],
      "hints": [
        "Write an `EndYear(id, version)` helper returning -1 when unknown.",
        "`end < year` means it is past end of life."
      ],
      "template": [
        "{{CODE}}",
        "var dojoHosts = new List<(string, string, string)>",
        "{",
        "    (\"web3\", \"ubuntu\", \"20.04\"), (\"web1\", \"ubuntu\", \"24.04\"), (\"ci\", \"ubuntu\", \"23.10\"),",
        "    (\"old-db\", \"centos\", \"7\"), (\"db1\", \"rocky\", \"9.4\"), (\"legacy\", \"debian\", \"10\"), (\"nas\", \"nixos\", \"24.05\")",
        "};",
        "Dojo.Eq(\"in 2026\", new List<string> {",
        "    \"ci (ubuntu 23.10, ended 2024)\",",
        "    \"legacy (debian 10, ended 2024)\",",
        "    \"old-db (centos 7, ended 2024)\",",
        "    \"web3 (ubuntu 20.04, ended 2025)\" }, PastEol(dojoHosts, 2026));",
        "Dojo.Eq(\"support ending this year is not yet past\", new List<string>(), PastEol(new List<(string, string, string)> { (\"a\", \"ubuntu\", \"22.10\") }, 2023));"
      ]
    }
  ]
}