{
  "kind": "project",
  "title": "Chain doctor",
  "summary": "Build a diagnostic tool that reads a description of what a server sends and what a client trusts, builds the matching certificates, runs X509Chain, and prints each problem with the openssl or PowerShell command that confirms and fixes it.",
  "level": "After module 5 (In the field). Uses X509Chain, MatchesHostname and the troubleshooting playbook.",
  "skills": [
    "X509Chain status flags",
    "Custom trust stores",
    "Missing intermediates",
    "Untrusted roots",
    "Expiry",
    "SAN matching",
    "EKU",
    "Chain order",
    "Writing diagnostics"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Model",
      "Checks",
      "Diagnosis",
      "Output"
    ],
    "parts": [
      {
        "id": "scenario",
        "label": "Scenario lines",
        "layer": "Input",
        "stage": 1
      },
      {
        "id": "certs",
        "label": "Root, intermediate, leaf",
        "layer": "Model",
        "stage": 1,
        "note": "built to match the scenario"
      },
      {
        "id": "chain",
        "label": "X509Chain at 2030-06-01",
        "layer": "Checks",
        "stage": 1
      },
      {
        "id": "summary",
        "label": "Summary + chain line",
        "layer": "Output",
        "stage": 1
      },
      {
        "id": "delivery",
        "label": "Missing intermediate / untrusted root",
        "layer": "Diagnosis",
        "stage": 2
      },
      {
        "id": "verdict",
        "label": "Verdict",
        "layer": "Output",
        "stage": 2
      },
      {
        "id": "expiry",
        "label": "Expired",
        "layer": "Diagnosis",
        "stage": 3
      },
      {
        "id": "name",
        "label": "Name mismatch (SAN only)",
        "layer": "Diagnosis",
        "stage": 3
      },
      {
        "id": "eku",
        "label": "Wrong EKU",
        "layer": "Diagnosis",
        "stage": 4
      },
      {
        "id": "order",
        "label": "Wrong order",
        "layer": "Checks",
        "stage": 4
      },
      {
        "id": "batch",
        "label": "Batch report + summary",
        "layer": "Output",
        "stage": 4
      }
    ],
    "flow": [
      [
        "scenario",
        "certs"
      ],
      [
        "certs",
        "chain"
      ],
      [
        "chain",
        "summary"
      ],
      [
        "chain",
        "delivery"
      ],
      [
        "chain",
        "expiry"
      ],
      [
        "chain",
        "eku"
      ],
      [
        "certs",
        "name"
      ],
      [
        "scenario",
        "order"
      ],
      [
        "delivery",
        "verdict"
      ],
      [
        "verdict",
        "batch"
      ]
    ]
  }
}
