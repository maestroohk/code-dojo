{
  "kind": "project",
  "title": "Your own mini CA",
  "summary": "Build a console certificate authority that reads commands from stdin and issues a root, an intermediate and TLS leaves in memory, then verifies chains, revokes, and exports a fullchain.pem. Every stage is tested by feeding it a script of commands.",
  "level": "After module 4 (Hands-on with .NET). Pairs well with module 5.",
  "skills": [
    "CertificateRequest",
    "Basic Constraints and path length",
    "SAN and EKU",
    "X509Chain with custom trust",
    "Reading chain status",
    "Revocation",
    "PEM bundles",
    "Console command parsing"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Commands",
      "CA",
      "Checks",
      "Output"
    ],
    "parts": [
      {
        "id": "stdin",
        "label": "stdin commands",
        "layer": "Input",
        "stage": 1
      },
      {
        "id": "dispatch",
        "label": "Command switch + errors",
        "layer": "Commands",
        "stage": 1
      },
      {
        "id": "root",
        "label": "Self-signed root",
        "layer": "CA",
        "stage": 1,
        "note": "CA, KeyCertSign, 2030-2050"
      },
      {
        "id": "show",
        "label": "show / list",
        "layer": "Output",
        "stage": 1
      },
      {
        "id": "inter",
        "label": "Intermediate (pathlen 0)",
        "layer": "CA",
        "stage": 2
      },
      {
        "id": "leaf",
        "label": "TLS leaf: SAN + serverAuth",
        "layer": "CA",
        "stage": 3
      },
      {
        "id": "verify",
        "label": "verify with X509Chain",
        "layer": "Checks",
        "stage": 4,
        "note": "custom trust, fixed date"
      },
      {
        "id": "match",
        "label": "match host to SAN",
        "layer": "Checks",
        "stage": 4
      },
      {
        "id": "revoke",
        "label": "Revocation list",
        "layer": "Checks",
        "stage": 5
      },
      {
        "id": "export",
        "label": "fullchain.pem export",
        "layer": "Output",
        "stage": 5
      }
    ],
    "flow": [
      [
        "stdin",
        "dispatch"
      ],
      [
        "dispatch",
        "root"
      ],
      [
        "root",
        "inter"
      ],
      [
        "inter",
        "leaf"
      ],
      [
        "dispatch",
        "show"
      ],
      [
        "leaf",
        "verify"
      ],
      [
        "revoke",
        "verify"
      ],
      [
        "leaf",
        "match"
      ],
      [
        "leaf",
        "export"
      ],
      [
        "verify",
        "show"
      ]
    ]
  }
}
