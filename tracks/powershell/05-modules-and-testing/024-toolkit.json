{
  "title": "Senior's toolkit: modules and tests",
  "summary": "The module, Pester, analyzer and package commands a PowerShell repo's pipeline runs, with the switches that matter.",
  "minutes": 7,
  "kind": "lesson",
  "steps": [
    {
      "type": "learn",
      "title": "Senior's toolkit: modules and tests",
      "body": "A PowerShell repo at work looks like any other: code, tests, a linter and a package step in CI. These are the commands each stage runs.",
      "toolkit": [
        { "cmd": "New-ModuleManifest / Update-ModuleManifest", "what": "Write or change the .psd1: version, exports, requirements.",
          "flags": [["-ModuleVersion 1.2.0", "the version"], ["-FunctionsToExport A, B", "an explicit list, never *"], ["-RequiredModules", "dependencies"], ["-PowerShellVersion 7.4", "the oldest supported"]],
          "example": "Update-ModuleManifest ./LogTools/LogTools.psd1 -ModuleVersion 1.3.0", "lang": "powershell" },
        { "cmd": "Import-Module", "what": "Load a module by name (from PSModulePath) or by path (from your repo).",
          "flags": [["-Force", "reload after a change"], ["-RequiredVersion 1.2.0", "one exact version"], ["-PassThru", "return the module object"], ["-UseWindowsPowerShell", "PowerShell 7 on Windows: run a 5.1-only module through a 5.1 process"]],
          "example": "Import-Module ./LogTools/LogTools.psd1 -Force -PassThru | Select-Object Name, Version", "lang": "powershell" },
        { "cmd": "Invoke-Pester", "what": "Run the tests.",
          "flags": [["-Output Detailed", "every test with its time"], ["-CI", "exit code + testResults.xml"], ["-TagFilter Unit", "only tagged tests"], ["New-PesterConfiguration", "full control, incl. CodeCoverage"]],
          "example": "$c = New-PesterConfiguration; $c.Run.Path = './tests'; $c.CodeCoverage.Enabled = $true; Invoke-Pester -Configuration $c", "lang": "powershell" },
        { "cmd": "Mock / Should -Invoke", "what": "Replace a command and assert how it was called.",
          "flags": [["-ModuleName M", "inject into the module's scope"], ["-ParameterFilter { $Uri -like '*x' }", "only matching calls"], ["-Times 0 -Exactly", "prove it never happened"]],
          "example": "Mock Invoke-RestMethod -ModuleName LogTools { @{ ok = $true } }", "lang": "powershell" },
        { "cmd": "Invoke-ScriptAnalyzer", "what": "Lint with the repo's settings; fail the build on findings.",
          "flags": [["-Settings ./PSScriptAnalyzerSettings.psd1", "the shared rules"], ["-Recurse", "the whole tree"], ["-EnableExit", "exit code = number of findings"], ["-Fix", "rewrite what it can"]],
          "example": "Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit", "lang": "powershell" },
        { "cmd": "Install-PSResource / Save-PSResource", "what": "Install (or download) modules from a repository, pinned.",
          "flags": [["-Scope CurrentUser", "no admin"], ["-Version '[2.1.0, 3.0)'", "a version range (NuGet syntax)"], ["-Repository TeamFeed", "from your feed"], ["-TrustRepository", "skip the prompt for this one call"]],
          "example": "Install-PSResource Pester -Version 6.2.0 -Scope CurrentUser -TrustRepository", "lang": "powershell" },
        { "cmd": "Publish-PSResource / Register-PSResourceRepository", "what": "Ship a module to a feed, and add feeds.",
          "flags": [["-Repository TeamFeed", "where to publish"], ["-ApiKey $key", "for NuGet servers and Azure Artifacts"], ["Register-PSResourceRepository -Uri", "a URL or a file share path"]],
          "example": "Publish-PSResource -Path ./LogTools -Repository TeamFeed -ApiKey $env:FEED_KEY", "lang": "powershell" }
      ]
    },
    {
      "type": "match",
      "prompt": "Which command does the CI stage need?",
      "pairs": [
        ["Run the tests, fail the build on a failure", "`Invoke-Pester -CI`"],
        ["Fail the build on lint findings", "`Invoke-ScriptAnalyzer -EnableExit`"],
        ["Bump the version", "`Update-ModuleManifest -ModuleVersion`"],
        ["Ship it to the feed", "`Publish-PSResource -Repository`"],
        ["Get dependencies on an offline agent", "`Save-PSResource` (on a connected machine)"]
      ]
    },
    {
      "type": "order",
      "prompt": "Order a module's release pipeline.",
      "lines": [
        "Install-PSResource Pester, PSScriptAnalyzer -Repository TeamFeed -TrustRepository",
        "Invoke-ScriptAnalyzer -Path ./LogTools -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit",
        "Invoke-Pester ./LogTools/tests -CI",
        "Update-ModuleManifest ./LogTools/LogTools.psd1 -ModuleVersion $env:RELEASE_VERSION",
        "Publish-PSResource -Path ./LogTools -Repository TeamFeed -ApiKey $env:FEED_KEY"
      ],
      "also": [[
        "Install-PSResource Pester, PSScriptAnalyzer -Repository TeamFeed -TrustRepository",
        "Invoke-Pester ./LogTools/tests -CI",
        "Invoke-ScriptAnalyzer -Path ./LogTools -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit",
        "Update-ModuleManifest ./LogTools/LogTools.psd1 -ModuleVersion $env:RELEASE_VERSION",
        "Publish-PSResource -Path ./LogTools -Repository TeamFeed -ApiKey $env:FEED_KEY"
      ]],
      "explain": "Tools first (pinned, from your feed), then the cheap checks (lint and tests, either order), and only a green build gets a version and is published."
    },
    {
      "type": "learn",
      "title": "Make it a habit",
      "body": "Every function you share lives in a module with an explicit export list, a test file next to it, and a settings file for the analyzer. Mock anything that leaves the machine, always with `-ModuleName`. Install from a feed you control, with pinned versions."
    }
  ]
}
