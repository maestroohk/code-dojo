    },
    {
      "type": "code",
      "title": "Leaderboard",
      "prompt": [
        "Read lines of `name points` until `end`. A player can appear many times; add up their points. Print the top 3 players by total, highest first, ties broken alphabetically by name:",
        "",
        "```text",
        "1. bo 30",
        "2. ann 25",
        "3. cy 25",
        "```",
        "",
        "If there are fewer than 3 players, print them all."
      ],
      "starter": "from collections import Counter\n",
      "solution": [
        "from collections import Counter",
        "totals = Counter()",
        "while (line := input()) != \"end\":",
        "    name, points = line.split()",
        "    totals[name] += int(points)",
        "ranked = sorted(totals.items(), key=lambda kv: (-kv[1], kv[0]))",
        "for i, (name, pts) in enumerate(ranked[:3], start=1):",
        "    print(f\"{i}. {name} {pts}\")"
      ],
      "tests": [
        {
          "name": "four players",
          "stdin": "ann 10\nbo 30\ncy 25\nann 15\ndi 5\nend\n",
          "expect": [
            "1. bo 30",
            "2. ann 25",
            "3. cy 25"
          ]
        },
        {
          "name": "one player",
          "stdin": "zed 1\nzed 2\nend\n",
          "expect": "1. zed 3"
        }
      ],
      "require": [
        {
          "pattern": "\\bkey\\s*=",
          "message": "Sorts with key="
        }
      ],
      "hints": [
        "A `Counter` starts every name at 0, so `totals[name] += int(points)` just works.",
        "Sort `totals.items()` with `key=lambda kv: (-kv[1], kv[0])`.",
        "Slice `[:3]` and `enumerate(..., start=1)`."
      ]
    }
  ]
