      ],
      "solution": [
        "import re",
        "from dataclasses import dataclass",
        "from datetime import datetime, timedelta",
        "from pathlib import Path",
        "",
        "LEVELS = [\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"]",
        "LINE = re.compile(r\"^(?P<ts>\\S+) (?P<level>[A-Z]+) (?P<logger>[\\w.]+): (?P<msg>.*)$\")",
        "",
        "",
        "@dataclass(frozen=True)",
        "class Entry:",
        "    ts: datetime",
        "    level: str",
        "    logger: str",
        "    msg: str",
        "",
        "",
        "def parse_line(line: str) -> Entry | None:",
        "    m = LINE.match(line.strip())",
        "    if not m or m[\"level\"] not in LEVELS:",
        "        return None",
        "    try:",
        "        ts = datetime.fromisoformat(m[\"ts\"])",
        "    except ValueError:",
        "        return None",
        "    if ts.tzinfo is None:",
        "        return None",
        "    return Entry(ts, m[\"level\"], m[\"logger\"], m[\"msg\"])",
        "",
        "",
        "def parse_duration(text: str) -> timedelta:",
        "    m = re.fullmatch(r\"(\\d+)([smhd])\", text.strip())",
        "    if not m:",
        "        raise ValueError(f\"bad duration: {text!r}\")",
        "    n = int(m.group(1))",
        "    return {\"s\": timedelta(seconds=n), \"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[m.group(2)]",
        "",
        "",
        "def scan(paths: list[Path], since: datetime, level: str) -> list[Entry]:",
        "    floor = LEVELS.index(level)",
        "    found = []",
        "    for path in paths:",
        "        for line in path.read_text(encoding=\"utf-8\").splitlines():",
        "            e = parse_line(line)",
        "            if e and e.ts >= since and LEVELS.index(e.level) >= floor:",
        "                found.append(e)",
        "    return sorted(found, key=lambda e: e.ts)"
      ],
      "template": [
        "{{CODE}}",
        "",
        "_LOG_A = \"\"\"2026-11-26T08:00:00+00:00 INFO api: started",
        "2026-11-26T09:10:00+00:00 ERROR api.db: connection reset",
        "not a log line at all",
        "2026-11-26T09:20:00+00:00 WARNING api: slow request 2.3s",
        "2026-11-26T09:55:00 ERROR api: naive time, skipped",
        "2026-11-26T10:05:00+01:00 CRITICAL billing: card gateway down",
        "\"\"\"",
        "_LOG_B = \"\"\"2026-11-26T09:30:00+00:00 ERROR worker: job 17 failed",
        "2026-11-26T09:40:00+00:00 DEBUG worker: tick",
        "\"\"\"",
        "",
        "import tempfile as _t",
        "from datetime import datetime, timedelta, timezone as _tz",
        "from pathlib import Path as _P",
        "Dojo.eq(\"2h\", timedelta(hours=2), parse_duration(\"2h\"))",
        "Dojo.eq(\"90s\", timedelta(seconds=90), parse_duration(\"90s\"))",
        "Dojo.eq(\"1d\", timedelta(days=1), parse_duration(\"1d\"))",
        "Dojo.throws(\"'2 hours' is rejected\", ValueError, lambda: parse_duration(\"2 hours\"))",
        "Dojo.throws(\"'h' is rejected\", ValueError, lambda: parse_duration(\"h\"))",
        "with _t.TemporaryDirectory() as _d:",
        "    _a = _P(_d) / \"app.log\"; _a.write_text(_LOG_A, encoding=\"utf-8\")",
        "    _b = _P(_d) / \"worker.log\"; _b.write_text(_LOG_B, encoding=\"utf-8\")",
        "    _since = datetime(2026, 11, 26, 9, 0, tzinfo=_tz.utc)",
        "    _got = scan([_a, _b], _since, \"ERROR\")",
        "    Dojo.eq(\"ERROR and worse since 09:00, oldest first\", [\"billing\", \"api.db\", \"worker\"], [e.logger for e in _got])",
        "    Dojo.eq(\"WARNING and worse\", 4, len(scan([_a, _b], _since, \"WARNING\")))",
        "    Dojo.eq(\"nothing since noon\", [], scan([_a, _b], datetime(2026, 11, 26, 12, 0, tzinfo=_tz.utc), \"DEBUG\"))"
      ],
      "hints": [
        "`re.fullmatch(r\"(\\d+)([smhd])\", text)` and a dict from unit to `timedelta`.",
        "Compare severities by position: `LEVELS.index(e.level) >= LEVELS.index(level)`. `10:05+01:00` is 09:05 UTC, so it sorts after 09:00 UTC entries but before 09:10."
      ]
    },
    {
      "type": "code",
      "title": "Part 3: the command line",
      "prompt": [
        "Keep parts 1 and 2 and add `main(argv: list[str] | None = None, now: datetime | None = None) -> int` (the tests pass a fixed `now`; the real run uses `datetime.now(timezone.utc)`):",
        "",
        "```text",
        "logscan FILE... [--since DURATION] [--level LEVEL]       defaults: --since 1h --level ERROR",
        "```",
        "",
        "- Print each matching entry on stdout as `\"<ts.isoformat()> <level> <logger>: <msg>\"`, oldest first.",
        "- Print `\"<n> entries at <LEVEL> or above in the last <since>\"` to **stderr**.",
        "- Exit `1` when anything matched, `0` when nothing did.",
        "- A bad `--since` is a usage error (`parser.error(...)`, exit 2). A file that does not exist prints `logscan: cannot read <path>` to stderr and returns `2`."
      ],
      "starter": [
        "import re",
        "from dataclasses import dataclass",
        "from datetime import datetime, timedelta",
        "from pathlib import Path",
        "",
        "LEVELS = [\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"]",
        "LINE = re.compile(r\"^(?P<ts>\\S+) (?P<level>[A-Z]+) (?P<logger>[\\w.]+): (?P<msg>.*)$\")",
        "",
        "",
        "@dataclass(frozen=True)",
        "class Entry:",
        "    ts: datetime",
        "    level: str",
        "    logger: str",
        "    msg: str",
        "",
        "",
        "def parse_line(line: str) -> Entry | None:",
        "    m = LINE.match(line.strip())",
        "    if not m or m[\"level\"] not in LEVELS:",
        "        return None",
        "    try:",
        "        ts = datetime.fromisoformat(m[\"ts\"])",
        "    except ValueError:",
        "        return None",
        "    if ts.tzinfo is None:",
        "        return None",
        "    return Entry(ts, m[\"level\"], m[\"logger\"], m[\"msg\"])",
        "",
        "",
        "def parse_duration(text: str) -> timedelta:",
        "    m = re.fullmatch(r\"(\\d+)([smhd])\", text.strip())",
        "    if not m:",
        "        raise ValueError(f\"bad duration: {text!r}\")",
        "    n = int(m.group(1))",
        "    return {\"s\": timedelta(seconds=n), \"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[m.group(2)]",
        "",
        "",
        "def scan(paths: list[Path], since: datetime, level: str) -> list[Entry]:",
        "    floor = LEVELS.index(level)",
        "    found = []",
        "    for path in paths:",
        "        for line in path.read_text(encoding=\"utf-8\").splitlines():",
        "            e = parse_line(line)",
        "            if e and e.ts >= since and LEVELS.index(e.level) >= floor:",
        "                found.append(e)",
        "    return sorted(found, key=lambda e: e.ts)"
      ],
      "solution": [
        "import argparse",
        "import re",
        "import sys",
        "from dataclasses import dataclass",
        "from datetime import datetime, timedelta, timezone",
        "from pathlib import Path",
        "",
        "LEVELS = [\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"]",
        "LINE = re.compile(r\"^(?P<ts>\\S+) (?P<level>[A-Z]+) (?P<logger>[\\w.]+): (?P<msg>.*)$\")",
        "",
        "",
        "@dataclass(frozen=True)",
        "class Entry:",
        "    ts: datetime",
        "    level: str",
        "    logger: str",
        "    msg: str",
        "",
        "",
        "def parse_line(line: str) -> Entry | None:",
        "    m = LINE.match(line.strip())",
        "    if not m or m[\"level\"] not in LEVELS:",
        "        return None",
        "    try:",
        "        ts = datetime.fromisoformat(m[\"ts\"])",
        "    except ValueError:",
        "        return None",
        "    if ts.tzinfo is None:",
        "        return None",
        "    return Entry(ts, m[\"level\"], m[\"logger\"], m[\"msg\"])",
        "",
        "",
        "def parse_duration(text: str) -> timedelta:",
        "    m = re.fullmatch(r\"(\\d+)([smhd])\", text.strip())",
        "    if not m:",
        "        raise ValueError(f\"bad duration: {text!r}\")",
        "    n = int(m.group(1))",
        "    return {\"s\": timedelta(seconds=n), \"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[m.group(2)]",
        "",
        "",
        "def scan(paths: list[Path], since: datetime, level: str) -> list[Entry]:",
        "    floor = LEVELS.index(level)",
        "    found = []",
        "    for path in paths:",
        "        for line in path.read_text(encoding=\"utf-8\").splitlines():",
        "            e = parse_line(line)",
        "            if e and e.ts >= since and LEVELS.index(e.level) >= floor:",
        "                found.append(e)",
        "    return sorted(found, key=lambda e: e.ts)",
        "",
        "",
        "def main(argv: list[str] | None = None, now: datetime | None = None) -> int:",
        "    parser = argparse.ArgumentParser(prog=\"logscan\")",
        "    parser.add_argument(\"files\", nargs=\"+\", type=Path)",
        "    parser.add_argument(\"--since\", default=\"1h\")",
        "    parser.add_argument(\"--level\", choices=LEVELS, default=\"ERROR\")",
        "    args = parser.parse_args(argv)",
        "    try:",
        "        window = parse_duration(args.since)",
        "    except ValueError as err:",
        "        parser.error(str(err))",
        "    missing = [p for p in args.files if not p.is_file()]",
        "    if missing:",
        "        print(f\"logscan: cannot read {missing[0]}\", file=sys.stderr)",
        "        return 2",
        "    now = now or datetime.now(timezone.utc)",
        "    found = scan(args.files, now - window, args.level)",
        "    for e in found:",
        "        print(f\"{e.ts.isoformat()} {e.level} {e.logger}: {e.msg}\")",
        "    print(f\"{len(found)} entries at {args.level} or above in the last {args.since}\", file=sys.stderr)",
        "    return 1 if found else 0"
      ],
      "template": [
        "{{CODE}}",
        "",
        "_LOG_A = \"\"\"2026-11-26T08:00:00+00:00 INFO api: started",
        "2026-11-26T09:10:00+00:00 ERROR api.db: connection reset",
        "not a log line at all",
        "2026-11-26T09:20:00+00:00 WARNING api: slow request 2.3s",
        "2026-11-26T09:55:00 ERROR api: naive time, skipped",
        "2026-11-26T10:05:00+01:00 CRITICAL billing: card gateway down",
        "\"\"\"",
        "_LOG_B = \"\"\"2026-11-26T09:30:00+00:00 ERROR worker: job 17 failed",
        "2026-11-26T09:40:00+00:00 DEBUG worker: tick",
        "\"\"\"",
        "",
        "import contextlib as _c, io as _io, tempfile as _t",
        "from datetime import datetime, timedelta, timezone as _tz",
        "from pathlib import Path as _P",
        "def dojo_run(argv, now):",
        "    out, err = _io.StringIO(), _io.StringIO()",
        "    with _c.redirect_stdout(out), _c.redirect_stderr(err):",
        "        try:",
        "            code = main(argv, now=now)",
        "        except SystemExit as e:",
        "            code = e.code",
        "    return code, out.getvalue().strip().splitlines(), err.getvalue().strip()",
        "_now = datetime(2026, 11, 26, 11, 0, tzinfo=_tz.utc)",
        "with _t.TemporaryDirectory() as _d:",
        "    _a = _P(_d) / \"app.log\"; _a.write_text(_LOG_A, encoding=\"utf-8\")",
        "    _b = _P(_d) / \"worker.log\"; _b.write_text(_LOG_B, encoding=\"utf-8\")",
        "    _code, _out, _err = dojo_run([\"--since\", \"2h\", str(_a), str(_b)], _now)",
        "    Dojo.eq(\"exit 1 when errors were found\", 1, _code)",
        "    Dojo.eq(\"entries, oldest first\", [\"2026-11-26T10:05:00+01:00 CRITICAL billing: card gateway down\", \"2026-11-26T09:10:00+00:00 ERROR api.db: connection reset\", \"2026-11-26T09:30:00+00:00 ERROR worker: job 17 failed\"], _out)",
        "    Dojo.eq(\"the summary goes to stderr\", \"3 entries at ERROR or above in the last 2h\", _err)",
        "    Dojo.eq(\"a clean window exits 0\", 0, dojo_run([\"--since\", \"30m\", str(_b)], _now)[0])",
        "    Dojo.eq(\"a bad --since is a usage error\", 2, dojo_run([\"--since\", \"soon\", str(_a)], _now)[0])",
        "    _m = dojo_run([str(_P(_d) / \"missing.log\")], _now)",
        "    Dojo.eq(\"a missing file exits 2\", 2, _m[0])",
        "    Dojo.check(\"and says which file\", \"cannot read\" in _m[2] and \"missing.log\" in _m[2], _m[2])"
      ],
      "hints": [
        "`parser.add_argument(\"files\", nargs=\"+\", type=Path)`, `--level` with `choices=LEVELS`.",
        "Wrap `parse_duration` in `try`/`except ValueError as err: parser.error(str(err))`, and return `1 if found else 0`."
      ]
    },
    {
      "type": "code",
      "title": "Part 4: prove parse_duration with pytest",
      "prompt": [
        "Before this ships, write the pytest tests for `parse_duration` (in `logscan.py`: `from logscan import parse_duration`). **Run checks** runs them with pytest against the real function and against four broken versions. Use `@pytest.mark.parametrize` for the good inputs and `pytest.raises` for the bad ones; at least 6 tests."
      ],
      "starter": [
        "from datetime import timedelta",
        "",
        "import pytest",
        "from logscan import parse_duration",
        "",
        "",
        "def test_hours():",
        "    assert parse_duration(\"2h\") == timedelta(hours=2)"
      ],
      "solution": [
        "from datetime import timedelta",
        "",
        "import pytest",
        "from logscan import parse_duration",
        "",
        "",
        "@pytest.mark.parametrize(\"text, expected\", [",
        "    (\"45s\", timedelta(seconds=45)),",
        "    (\"15m\", timedelta(minutes=15)),",
        "    (\"2h\", timedelta(hours=2)),",
        "    (\"1d\", timedelta(days=1)),",
        "    (\"120m\", timedelta(hours=2)),",
        "])",
        "def test_valid(text, expected):",
        "    assert parse_duration(text) == expected",
        "",
        "",
        "@pytest.mark.parametrize(\"bad\", [\"\", \"h\", \"2\", \"2 h\", \"2hx\", \"2hours\", \"-1h\", \"1w\", \"1.5h\"])",
        "def test_invalid(bad):",
        "    with pytest.raises(ValueError):",
        "        parse_duration(bad)"
      ],
      "pytest": {
        "module": "logscan.py",
        "minTests": 6,
        "target": [
          "import re",
          "from datetime import timedelta",
          "",
          "",
          "def parse_duration(text: str) -> timedelta:",
          "    m = re.fullmatch(r\"(\\d+)([smhd])\", text.strip())",
          "    if not m:",
          "        raise ValueError(f\"bad duration: {text!r}\")",
          "    n = int(m.group(1))",
          "    return {\"s\": timedelta(seconds=n), \"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[m.group(2)]"
        ],
        "mutants": [
          {
            "name": "minutes are read as seconds",
            "replace": [
              [
                "\"m\": timedelta(minutes=n)",
                "\"m\": timedelta(seconds=n)"
              ]
            ]
          },
          {
            "name": "days are read as hours",
            "replace": [
              [
                "\"d\": timedelta(days=n)",
                "\"d\": timedelta(hours=n)"
              ]
            ]
          },
          {
            "name": "a number with no unit is accepted as hours",
            "replace": [
              [
                "r\"(\\d+)([smhd])\"",
                "r\"(\\d+)([smhd]?)\""
              ],
              [
                "[m.group(2)]",
                "[m.group(2) or \"h\"]"
              ]
            ]
          },
          {
            "name": "only the start must match (\"2hours\" passes)",
            "replace": [
              [
                "re.fullmatch(",
                "re.match("
              ]
            ],
            "hint": "Try an input with extra text after a valid duration, like `\"2hx\"`."
          }
        ]
      },
      "require": [
        {
          "pattern": "@pytest\\.mark\\.parametrize",
          "message": "Uses @pytest.mark.parametrize"
        },
        {
          "pattern": "pytest\\.raises",
          "message": "Uses pytest.raises"
        }
      ],
      "hints": [
        "One parametrized test per unit (s, m, h, d) and one for bad inputs.",
        "Bad inputs worth having: no unit (`\"2\"`), a unit with trailing text (`\"2hx\"`, `\"2 hours\"`), an unknown unit (`\"1w\"`)."
      ],
      "explain": "Durations, dates and money are where off-by-a-unit bugs hide. A parametrized table of good and bad inputs is cheap, readable and catches all four planted bugs."
    }
  ]
}
