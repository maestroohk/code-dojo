{
  "title": "Boss: the library",
  "summary": "Model a small domain with classes.",
  "minutes": 25,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "Module boss",
      "body": "Three classes that work together: a frozen dataclass for values, a class with dunder methods for a collection, and a service that composes them."
    },
    {
      "type": "code",
      "title": "Book",
      "prompt": [
        "Write a frozen dataclass `Book(isbn: str, title: str, author: str, year: int)`. Ordering should be by `author`, then `year`, then `title`, so put a sort key property `sort_key` returning that tuple (do **not** use `order=True`, since field order is isbn first).",
        "",
        "Add `__str__` returning `\"Title (Author, Year)\"`."
      ],
      "starter": "from dataclasses import dataclass\n",
      "solution": [
        "from dataclasses import dataclass",
        "",
        "@dataclass(frozen=True)",
        "class Book:",
        "    isbn: str",
        "    title: str",
        "    author: str",
        "    year: int",
        "",
        "    @property",
        "    def sort_key(self):",
        "        return (self.author, self.year, self.title)",
        "",
        "    def __str__(self):",
        "        return f\"{self.title} ({self.author}, {self.year})\""
      ],
      "template": [
        "{{CODE}}",
        "b = Book(\"1\", \"Dune\", \"Herbert\", 1965)",
        "Dojo.eq(\"str\", \"Dune (Herbert, 1965)\", str(b))",
        "Dojo.eq(\"sort key\", (\"Herbert\", 1965, \"Dune\"), b.sort_key)",
        "Dojo.eq(\"equal by value\", Book(\"1\", \"Dune\", \"Herbert\", 1965), b)",
        "Dojo.throws(\"frozen\", Exception, lambda: setattr(b, \"year\", 2000))"
      ],
      "hints": [
        "`@dataclass(frozen=True)`",
        "`__str__` is what `print` and `str()` use; the dataclass still provides `__repr__`."
      ]
    },
    {
      "type": "code",
      "title": "Shelf",
      "prompt": [
        "Keep your `Book`. Add a class `Shelf`:",
        "",
        "- `Shelf()` starts empty; `add(book)` adds it, raising `ValueError` if a book with the same isbn is already there",
        "- `len(shelf)` is the number of books",
        "- `isbn in shelf` works (`__contains__`)",
        "- `shelf[isbn]` returns the book or raises `KeyError` (`__getitem__`)",
        "- iterating gives books in `sort_key` order",
        "- `by(author)` returns a list of that author's books in order"
      ],
      "starter": "from dataclasses import dataclass\n\n# Book from the previous step, then Shelf\n",
      "solution": [
        "from dataclasses import dataclass",
        "",
        "@dataclass(frozen=True)",
        "class Book:",
        "    isbn: str",
        "    title: str",
        "    author: str",
        "    year: int",
        "",
        "    @property",
        "    def sort_key(self):",
        "        return (self.author, self.year, self.title)",
        "",
        "    def __str__(self):",
        "        return f\"{self.title} ({self.author}, {self.year})\"",
        "",
        "class Shelf:",
        "    def __init__(self):",
        "        self._books = {}",
        "",
        "    def add(self, book):",
        "        if book.isbn in self._books:",
        "            raise ValueError(f\"duplicate isbn {book.isbn}\")",
        "        self._books[book.isbn] = book",
        "",
        "    def __len__(self):",
        "        return len(self._books)",
        "",
        "    def __contains__(self, isbn):",
        "        return isbn in self._books",
        "",
        "    def __getitem__(self, isbn):",
        "        return self._books[isbn]",
        "",
        "    def __iter__(self):",
        "        return iter(sorted(self._books.values(), key=lambda b: b.sort_key))",
        "",
        "    def by(self, author):",
        "        return [b for b in self if b.author == author]"
      ],
      "template": [
        "{{CODE}}",
        "s = Shelf()",
        "s.add(Book(\"3\", \"Emma\", \"Austen\", 1815))",
        "s.add(Book(\"1\", \"Dune\", \"Herbert\", 1965))",
        "s.add(Book(\"2\", \"Persuasion\", \"Austen\", 1817))",
        "Dojo.eq(\"len\", 3, len(s))",
        "Dojo.check(\"in by isbn\", \"1\" in s and \"9\" not in s, \"define __contains__\")",
        "Dojo.eq(\"lookup by isbn\", \"Dune\", s[\"1\"].title)",
        "Dojo.throws(\"missing isbn raises KeyError\", KeyError, lambda: s[\"9\"])",
        "Dojo.throws(\"duplicate isbn raises ValueError\", ValueError, lambda: s.add(Book(\"1\", \"X\", \"Y\", 1)))",
        "Dojo.eq(\"iterates in order\", [\"Emma\", \"Persuasion\", \"Dune\"], [b.title for b in s])",
        "Dojo.eq(\"by author\", [\"Emma\", \"Persuasion\"], [b.title for b in s.by(\"Austen\")])"
      ],
      "hints": [
        "Store books in a dict keyed by isbn.",
        "`__iter__` can return `iter(sorted(...))`.",
        "`by` can loop over `self`, which uses your `__iter__`."
      ]
    },
    {
      "type": "code",
      "title": "Loans",
      "prompt": [
        "Keep `Book` and `Shelf`. Add a class `Library` that **has** a `Shelf` (composition):",
        "",
        "- `Library()`; `library.shelf` is its shelf",
        "- `lend(isbn, member)`: raises `KeyError` for an unknown isbn, `ValueError` if already lent; otherwise records it",
        "- `give_back(isbn)`: raises `ValueError` if not lent",
        "- `available()`: list of books not on loan, in shelf order",
        "- `loans_of(member)`: list of titles that member has, in shelf order"
      ],
      "starter": "# Book, Shelf, then Library\n",
      "solution": [
        "from dataclasses import dataclass",
        "",
        "@dataclass(frozen=True)",
        "class Book:",
        "    isbn: str",
        "    title: str",
        "    author: str",
        "    year: int",
        "",
        "    @property",
        "    def sort_key(self):",
        "        return (self.author, self.year, self.title)",
        "",
        "    def __str__(self):",
        "        return f\"{self.title} ({self.author}, {self.year})\"",
        "",
        "class Shelf:",
        "    def __init__(self):",
        "        self._books = {}",
        "",
        "    def add(self, book):",
        "        if book.isbn in self._books:",
        "            raise ValueError(f\"duplicate isbn {book.isbn}\")",
        "        self._books[book.isbn] = book",
        "",
        "    def __len__(self):",
        "        return len(self._books)",
        "",
        "    def __contains__(self, isbn):",
        "        return isbn in self._books",
        "",
        "    def __getitem__(self, isbn):",
        "        return self._books[isbn]",
        "",
        "    def __iter__(self):",
        "        return iter(sorted(self._books.values(), key=lambda b: b.sort_key))",
        "",
        "    def by(self, author):",
        "        return [b for b in self if b.author == author]",
        "",
        "class Library:",
        "    def __init__(self):",
        "        self.shelf = Shelf()",
        "        self._loans = {}",
        "",
        "    def lend(self, isbn, member):",
        "        self.shelf[isbn]",
        "        if isbn in self._loans:",
        "            raise ValueError(\"already lent\")",
        "        self._loans[isbn] = member",
        "",
        "    def give_back(self, isbn):",
        "        if isbn not in self._loans:",
        "            raise ValueError(\"not lent\")",
        "        del self._loans[isbn]",
        "",
        "    def available(self):",
        "        return [b for b in self.shelf if b.isbn not in self._loans]",
        "",
        "    def loans_of(self, member):",
        "        return [b.title for b in self.shelf if self._loans.get(b.isbn) == member]"
      ],
      "template": [
        "{{CODE}}",
        "lib = Library()",
        "for b in [Book(\"1\", \"Dune\", \"Herbert\", 1965), Book(\"2\", \"Emma\", \"Austen\", 1815), Book(\"3\", \"Ubik\", \"Dick\", 1969)]:",
        "    lib.shelf.add(b)",
        "lib.lend(\"1\", \"ann\")",
        "lib.lend(\"3\", \"ann\")",
        "Dojo.eq(\"available excludes loans\", [\"Emma\"], [b.title for b in lib.available()])",
        "Dojo.eq(\"loans of ann in shelf order\", [\"Ubik\", \"Dune\"], lib.loans_of(\"ann\"))",
        "Dojo.throws(\"cannot lend twice\", ValueError, lambda: lib.lend(\"1\", \"bo\"))",
        "Dojo.throws(\"unknown isbn\", KeyError, lambda: lib.lend(\"9\", \"bo\"))",
        "lib.give_back(\"1\")",
        "Dojo.eq(\"returned book is available\", [\"Emma\", \"Dune\"], [b.title for b in lib.available()])",
        "Dojo.throws(\"cannot return twice\", ValueError, lambda: lib.give_back(\"1\"))",
        "Dojo.eq(\"nobody else has loans\", [], lib.loans_of(\"bo\"))"
      ],
      "hints": [
        "Keep a dict `isbn -> member` for loans.",
        "`self.shelf[isbn]` raises `KeyError` for you when the isbn is unknown.",
        "Iterate `self.shelf` to get shelf order."
      ]
    }
  ]
}
