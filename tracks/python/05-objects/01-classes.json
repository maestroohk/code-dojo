    {
      "type": "code",
      "title": "Bank account",
      "prompt": [
        "Write a class `Account` with:",
        "",
        "- `Account(owner, balance=0)`",
        "- `deposit(amount)`: adds; raises `ValueError` if `amount <= 0`",
        "- `withdraw(amount)`: subtracts; raises `ValueError` if `amount <= 0` or more than the balance",
        "- `history`: a list of `(\"deposit\", amount)` / `(\"withdraw\", amount)` tuples, one list **per account**",
        "",
        "(To raise: `raise ValueError(\"message\")`.)"
      ],
      "starter": "class Account:\n    ...\n",
      "solution": [
        "class Account:",
        "    def __init__(self, owner, balance=0):",
        "        self.owner = owner",
        "        self.balance = balance",
        "        self.history = []",
        "",
        "    def deposit(self, amount):",
        "        if amount <= 0:",
        "            raise ValueError(\"deposit must be positive\")",
        "        self.balance += amount",
        "        self.history.append((\"deposit\", amount))",
        "",
        "    def withdraw(self, amount):",
        "        if amount <= 0 or amount > self.balance:",
        "            raise ValueError(\"invalid withdrawal\")",
        "        self.balance -= amount",
        "        self.history.append((\"withdraw\", amount))"
      ],
      "template": [
        "{{CODE}}",
        "a = Account(\"ann\")",
        "a.deposit(100)",
        "a.withdraw(30)",
        "Dojo.eq(\"balance after deposit and withdraw\", 70, a.balance)",
        "Dojo.eq(\"owner is kept\", \"ann\", a.owner)",
        "Dojo.eq(\"history records both\", [(\"deposit\", 100), (\"withdraw\", 30)], a.history)",
        "Dojo.throws(\"withdrawing too much raises ValueError\", ValueError, lambda: a.withdraw(1000))",
        "Dojo.throws(\"depositing 0 raises ValueError\", ValueError, lambda: a.deposit(0))",
        "Dojo.eq(\"failed operations change nothing\", 70, a.balance)",
        "b = Account(\"bo\", 5)",
        "Dojo.eq(\"each account has its own history\", [], b.history)",
        "Dojo.eq(\"starting balance\", 5, b.balance)"
      ],
      "hints": [
        "Create `self.history = []` inside `__init__`, not in the class body.",
        "Check the amount before changing anything."
      ]
    }
  ]
