{
  "title": "JSON and logging",
  "summary": "Save structured data, and report what your program is doing.",
  "minutes": 10,
  "steps": [
    {
      "type": "learn",
      "title": "json",
      "body": [
        "`json` converts between JSON text and Python's dicts and lists, like `System.Text.Json` but with no classes needed:",
        "",
        "```python",
        "import json",
        "",
        "data = {\"name\": \"ann\", \"scores\": [90, 85], \"admin\": False, \"boss\": None}",
        "text = json.dumps(data)                 # to a str",
        "back = json.loads(text)                 # from a str",
        "json.dumps(data, indent=2, sort_keys=True)   # pretty",
        "",
        "with open(\"data.json\", \"w\", encoding=\"utf-8\") as f:",
        "    json.dump(data, f)                  # to a file",
        "```",
        "",
        "| JSON | Python |",
        "|---|---|",
        "| object | `dict` |",
        "| array | `list` |",
        "| `true`/`false`/`null` | `True`/`False`/`None` |"
      ]
    },
    {
      "type": "predict",
      "prompt": "What does this print?",
      "code": [
        "import json",
        "text = '{\"id\": 7, \"tags\": [\"a\", \"b\"], \"active\": true, \"parent\": null}'",
        "obj = json.loads(text)",
        "print(obj[\"tags\"][1], obj[\"active\"], obj[\"parent\"])",
        "print(json.dumps({\"b\": 1, \"a\": (1, 2)}, sort_keys=True))"
      ],
      "answer": [
        "b True None",
        "{\"a\": [1, 2], \"b\": 1}"
      ],
      "explain": "JSON `true` and `null` become `True` and `None`. Tuples are written as arrays, and `sort_keys` orders the keys."
    },
    {
      "type": "mcq",
      "prompt": "What does `json.dumps({1: \"x\"})` give?",
      "options": [
        "`'{\"1\": \"x\"}'`: JSON keys are always strings",
        "`'{1: \"x\"}'`",
        "a `TypeError`",
        "`'[1, \"x\"]'`"
      ],
      "answer": 0,
      "explain": "JSON object keys must be strings, so integer keys are converted. Loading it back gives `{\"1\": \"x\"}`, a classic round-trip surprise."
    },
    {
      "type": "learn",
      "title": "Objects to JSON",
      "body": [
        "`json` only knows dicts, lists, strings, numbers, booleans and `None`. For your own classes, convert first:",
        "",
        "```python continues",
        "from dataclasses import dataclass, asdict",
        "",
        "@dataclass",
        "class User:",
        "    name: str",
        "    age: int",
        "",
        "text = json.dumps(asdict(User(\"ann\", 30)))       # '{\"name\": \"ann\", \"age\": 30}'",
        "user = User(**json.loads(text))                  # back again",
        "```",
        "",
        "Anything else (a `datetime`, a `set`) raises `TypeError: Object of type ... is not JSON serializable`. Convert it to a string or list yourself, or pass `default=str`."
      ]
    },
    {
      "type": "predict",
      "prompt": "What does this print?",
      "code": [
        "import json",
        "from dataclasses import dataclass, asdict",
        "",
        "@dataclass",
        "class Point:",
        "    x: int",
        "    y: int",
        "",
        "text = json.dumps([asdict(Point(1, 2)), asdict(Point(3, 4))])",
        "print(text)",
        "points = [Point(**d) for d in json.loads(text)]",
        "print(points[1].y, sorted({1, 3, 2}))",
        "try:",
        "    json.dumps({\"tags\": {1, 2}})",
        "except TypeError:",
        "    print(\"sets are not JSON\")"
      ],
      "answer": [
        "[{\"x\": 1, \"y\": 2}, {\"x\": 3, \"y\": 4}]",
        "4 [1, 2, 3]",
        "sets are not JSON"
      ],
      "explain": "`asdict` turns a dataclass into a plain dict; `Point(**d)` builds one back. Sets have no JSON form, so convert them to a sorted list first."
    },
    {
      "type": "learn",
      "title": "logging",
      "body": [
        "`print` is for the program's output; **logging** is for messages about what the program is doing. Like `ILogger`, messages have levels and the configuration decides which are shown and where:",
        "",
        "```python",
        "import logging, sys",
        "logging.basicConfig(level=logging.INFO, stream=sys.stdout,",
        "                    format=\"%(levelname)s %(name)s: %(message)s\")",
        "log = logging.getLogger(\"billing\")",
        "",
        "log.debug(\"detail\")           # hidden: below INFO",
        "log.info(\"charged %s\", 42)    # INFO billing: charged 42",
        "log.warning(\"retrying\")",
        "log.error(\"failed\")",
        "```",
        "",
        "Pass values as arguments (`\"%s\", 42`) rather than f-strings: the text is only built if the message is actually shown. Libraries call `getLogger(__name__)` and never call `basicConfig`; the application does that once."
      ]
    },
    {
      "type": "predict",
      "prompt": "What does this print?",
      "code": [
        "import logging, sys",
        "logging.basicConfig(level=logging.WARNING, stream=sys.stdout, format=\"%(levelname)s:%(message)s\")",
        "log = logging.getLogger(\"app\")",
        "log.info(\"starting\")",
        "log.warning(\"disk %d%% full\", 91)",
        "log.error(\"cannot write %s\", \"out.txt\")",
        "log.debug(\"bytes=%d\", 10)"
      ],
      "answer": [
        "WARNING:disk 91% full",
        "ERROR:cannot write out.txt"
      ],
      "explain": "Only WARNING and above pass the threshold. `%%` is a literal percent sign in a `%`-style message."
    },
    {
      "type": "sort",
      "prompt": "Which level would you use?",
      "buckets": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ],
      "items": [
        [
          "the SQL text of every query",
          0
        ],
        [
          "service started on port 8080",
          1
        ],
        [
          "config file missing, using defaults",
          2
        ],
        [
          "payment failed for order 77",
          3
        ],
        [
          "retrying a request (attempt 2 of 3)",
          2
        ],
        [
          "user 42 logged in",
          1
        ]
      ]
    },
    {
      "type": "blanks",
      "prompt": "Save and reload settings.",
      "code": [
        "import json",
        "from pathlib import Path",
        "p = Path(\"settings.json\")",
        "p.write_text(json.__1__({\"theme\": \"dark\"}), encoding=\"utf-8\")",
        "settings = json.__2__(p.read_text(encoding=\"utf-8\"))",
        "print(settings[__3__])"
      ],
      "blanks": [
        "dumps",
        "loads",
        "\"theme\""
      ],
      "bank": [
        "dump",
        "load",
        "theme",
        "parse"
      ]
    },
    {
      "type": "code",
      "title": "Settings store",
      "prompt": [
        "Write `load_settings(path, defaults)` and `save_settings(path, settings)`:",
        "",
        "- `load_settings` returns a **new** dict: the defaults updated with what is in the JSON file at `path`. If the file does not exist, just a copy of the defaults. If the file is not valid JSON, log a warning with `logging.getLogger(\"settings\").warning(...)` and return a copy of the defaults.",
        "- `save_settings` writes the dict as JSON with `indent=2` and `sort_keys=True`.",
        "",
        "`path` is a `pathlib.Path`."
      ],
      "starter": "import json\nimport logging\nfrom pathlib import Path\n\nlog = logging.getLogger(\"settings\")\n",
      "solution": [
        "import json",
        "import logging",
        "from pathlib import Path",
        "",
        "log = logging.getLogger(\"settings\")",
        "",
        "def load_settings(path, defaults):",
        "    result = dict(defaults)",
        "    if not path.exists():",
        "        return result",
        "    try:",
        "        result.update(json.loads(path.read_text(encoding=\"utf-8\")))",
        "    except json.JSONDecodeError:",
        "        log.warning(\"bad settings file %s, using defaults\", path)",
        "    return result",
        "",
        "def save_settings(path, settings):",
        "    path.write_text(json.dumps(settings, indent=2, sort_keys=True), encoding=\"utf-8\")"
      ],
      "template": [
        "{{CODE}}",
        "import logging as dojo_logging",
        "dojo_records = []",
        "class DojoHandler(dojo_logging.Handler):",
        "    def emit(self, record):",
        "        dojo_records.append(record.levelname)",
        "dojo_logging.getLogger(\"settings\").addHandler(DojoHandler())",
        "d = {\"theme\": \"light\", \"size\": 12}",
        "p = Path(\"app.json\")",
        "Dojo.eq(\"missing file gives the defaults\", d, load_settings(p, d))",
        "save_settings(p, {\"theme\": \"dark\"})",
        "Dojo.eq(\"saved as pretty sorted JSON\", '{\\n  \"theme\": \"dark\"\\n}', p.read_text(encoding=\"utf-8\"))",
        "Dojo.eq(\"file values override defaults\", {\"theme\": \"dark\", \"size\": 12}, load_settings(p, d))",
        "Dojo.eq(\"defaults are not modified\", {\"theme\": \"light\", \"size\": 12}, d)",
        "p.write_text(\"{not json\", encoding=\"utf-8\")",
        "Dojo.eq(\"bad JSON gives the defaults\", d, load_settings(p, d))",
        "Dojo.eq(\"and logs a warning\", [\"WARNING\"], dojo_records)"
      ],
      "hints": [
        "Start with `result = dict(defaults)` so the caller's dict is untouched.",
        "Catch `json.JSONDecodeError` (a subclass of `ValueError`).",
        "`json.dumps(settings, indent=2, sort_keys=True)`"
      ]
    }
  ]
}
