{
  "title": "Boss: the journal",
  "summary": "Exceptions, files, JSON and context managers together.",
  "minutes": 25,
  "kind": "boss",
  "steps": [
    {
      "type": "learn",
      "title": "Module boss",
      "body": "One small persistent program, built in three steps. Each step is the whole program so far. Files are written in the run's own temporary folder, which starts empty every time."
    },
    {
      "type": "code",
      "title": "Journal store",
      "prompt": [
        "Write a class `Journal(path)` that keeps entries in a JSON file (a list of `{\"day\": ..., \"text\": ...}` dicts):",
        "",
        "- `add(day, text)`: append an entry and save; raise `ValueError` if `text` is blank",
        "- `entries()`: the list, loaded from the file (empty list if the file is missing)",
        "- `on(day)`: list of texts for that day",
        "",
        "Loading a corrupt file must raise a custom `JournalError` chained from the `json.JSONDecodeError`."
      ],
      "starter": "import json\nfrom pathlib import Path\n\nclass JournalError(Exception):\n    pass\n",
      "solution": [
        "import json",
        "from pathlib import Path",
        "",
        "class JournalError(Exception):",
        "    pass",
        "",
        "class Journal:",
        "    def __init__(self, path):",
        "        self.path = Path(path)",
        "",
        "    def entries(self):",
        "        if not self.path.exists():",
        "            return []",
        "        try:",
        "            return json.loads(self.path.read_text(encoding=\"utf-8\"))",
        "        except json.JSONDecodeError as e:",
        "            raise JournalError(f\"corrupt journal {self.path}\") from e",
        "",
        "    def add(self, day, text):",
        "        if not text.strip():",
        "            raise ValueError(\"entry text is blank\")",
        "        items = self.entries()",
        "        items.append({\"day\": day, \"text\": text})",
        "        self.path.write_text(json.dumps(items, indent=2), encoding=\"utf-8\")",
        "",
        "    def on(self, day):",
        "        return [e[\"text\"] for e in self.entries() if e[\"day\"] == day]"
      ],
      "template": [
        "{{CODE}}",
        "j = Journal(\"j.json\")",
        "Dojo.eq(\"empty at first\", [], j.entries())",
        "j.add(\"mon\", \"ran 5k\")",
        "j.add(\"mon\", \"read\")",
        "j.add(\"tue\", \"rest\")",
        "Dojo.eq(\"texts for monday\", [\"ran 5k\", \"read\"], j.on(\"mon\"))",
        "Dojo.eq(\"persisted: a new Journal sees the entries\", 3, len(Journal(\"j.json\").entries()))",
        "Dojo.throws(\"blank text\", ValueError, lambda: j.add(\"wed\", \"  \"))",
        "Path(\"bad.json\").write_text(\"[{\", encoding=\"utf-8\")",
        "Dojo.throws(\"corrupt file raises JournalError\", JournalError, lambda: Journal(\"bad.json\").entries())",
        "try:",
        "    Journal(\"bad.json\").entries()",
        "except JournalError as e:",
        "    Dojo.check(\"chained from JSONDecodeError\", isinstance(e.__cause__, json.JSONDecodeError), \"raise JournalError(...) from e\")"
      ],
      "hints": [
        "`entries()` reads and parses the file each time; `add` loads, appends, and writes back.",
        "Catch `json.JSONDecodeError as e` and `raise JournalError(...) from e`."
      ]
    },
    {
      "type": "code",
      "title": "Atomic batch",
      "prompt": [
        "Keep `Journal`. Add a method `batch()` that returns a **context manager**. Inside the `with` block, `add` calls are collected in memory and written in **one** save when the block ends normally. If the block raises, nothing is written and the exception propagates.",
        "",
        "```python",
        "with j.batch():",
        "    j.add(\"thu\", \"a\")",
        "    j.add(\"thu\", \"b\")",
        "```"
      ],
      "starter": "# Journal from the previous step, plus batch()\n",
      "solution": [
        "import json",
        "from contextlib import contextmanager",
        "from pathlib import Path",
        "",
        "class JournalError(Exception):",
        "    pass",
        "",
        "class Journal:",
        "    def __init__(self, path):",
        "        self.path = Path(path)",
        "        self._pending = None",
        "",
        "    def entries(self):",
        "        if not self.path.exists():",
        "            return []",
        "        try:",
        "            return json.loads(self.path.read_text(encoding=\"utf-8\"))",
        "        except json.JSONDecodeError as e:",
        "            raise JournalError(f\"corrupt journal {self.path}\") from e",
        "",
        "    def _save(self, items):",
        "        self.path.write_text(json.dumps(items, indent=2), encoding=\"utf-8\")",
        "",
        "    def add(self, day, text):",
        "        if not text.strip():",
        "            raise ValueError(\"entry text is blank\")",
        "        entry = {\"day\": day, \"text\": text}",
        "        if self._pending is not None:",
        "            self._pending.append(entry)",
        "        else:",
        "            self._save(self.entries() + [entry])",
        "",
        "    def on(self, day):",
        "        return [e[\"text\"] for e in self.entries() if e[\"day\"] == day]",
        "",
        "    @contextmanager",
        "    def batch(self):",
        "        self._pending = []",
        "        try:",
        "            yield self",
        "            self._save(self.entries() + self._pending)",
        "        finally:",
        "            self._pending = None"
      ],
      "template": [
        "{{CODE}}",
        "j = Journal(\"b.json\")",
        "j.add(\"mon\", \"first\")",
        "with j.batch():",
        "    j.add(\"tue\", \"a\")",
        "    j.add(\"tue\", \"b\")",
        "    Dojo.eq(\"nothing written until the block ends\", 1, len(Journal(\"b.json\").entries()))",
        "Dojo.eq(\"written after the block\", [\"a\", \"b\"], j.on(\"tue\"))",
        "def dojo_fail():",
        "    with j.batch():",
        "        j.add(\"wed\", \"lost\")",
        "        raise RuntimeError(\"abort\")",
        "Dojo.throws(\"exceptions propagate\", RuntimeError, dojo_fail)",
        "Dojo.eq(\"nothing from the failed batch\", [], j.on(\"wed\"))",
        "j.add(\"thu\", \"after\")",
        "Dojo.eq(\"normal adds work again\", [\"after\"], j.on(\"thu\"))"
      ],
      "hints": [
        "Keep a `_pending` list that `add` uses while a batch is open.",
        "A `@contextmanager` method: set up, `yield`, save after the yield; reset `_pending` in `finally`.",
        "Code after `yield` does not run when the block raises, which is exactly what you want for the save."
      ]
    },
    {
      "type": "code",
      "title": "Journal CLI",
      "prompt": [
        "Keep your `Journal` (with `batch`). Now add a script part at the bottom that reads commands until `end`, using a journal at `journal.json`:",
        "",
        "- `add DAY TEXT...` adds an entry and prints `added`",
        "- `show DAY` prints each text on its own line as `- TEXT`, or `nothing on DAY`",
        "- `count` prints the number of entries",
        "- errors: print `error: MESSAGE` for a `ValueError` (blank text) and `error: unknown command` for anything else",
        "",
        "Logging is not needed here."
      ],
      "starter": "# Journal and JournalError from the previous step, then the command loop\n",
      "solution": [
        "import json",
        "from contextlib import contextmanager",
        "from pathlib import Path",
        "",
        "class JournalError(Exception):",
        "    pass",
        "",
        "class Journal:",
        "    def __init__(self, path):",
        "        self.path = Path(path)",
        "        self._pending = None",
        "",
        "    def entries(self):",
        "        if not self.path.exists():",
        "            return []",
        "        try:",
        "            return json.loads(self.path.read_text(encoding=\"utf-8\"))",
        "        except json.JSONDecodeError as e:",
        "            raise JournalError(f\"corrupt journal {self.path}\") from e",
        "",
        "    def _save(self, items):",
        "        self.path.write_text(json.dumps(items, indent=2), encoding=\"utf-8\")",
        "",
        "    def add(self, day, text):",
        "        if not text.strip():",
        "            raise ValueError(\"entry text is blank\")",
        "        entry = {\"day\": day, \"text\": text}",
        "        if self._pending is not None:",
        "            self._pending.append(entry)",
        "        else:",
        "            self._save(self.entries() + [entry])",
        "",
        "    def on(self, day):",
        "        return [e[\"text\"] for e in self.entries() if e[\"day\"] == day]",
        "",
        "    @contextmanager",
        "    def batch(self):",
        "        self._pending = []",
        "        try:",
        "            yield self",
        "            self._save(self.entries() + self._pending)",
        "        finally:",
        "            self._pending = None",
        "",
        "journal = Journal(\"journal.json\")",
        "while (line := input()) != \"end\":",
        "    parts = line.split(maxsplit=2)",
        "    try:",
        "        match parts:",
        "            case [\"add\", day, *rest]:",
        "                journal.add(day, \" \".join(rest))",
        "                print(\"added\")",
        "            case [\"show\", day]:",
        "                texts = journal.on(day)",
        "                for text in texts:",
        "                    print(f\"- {text}\")",
        "                if not texts:",
        "                    print(f\"nothing on {day}\")",
        "            case [\"count\"]:",
        "                print(len(journal.entries()))",
        "            case _:",
        "                print(\"error: unknown command\")",
        "    except ValueError as e:",
        "        print(f\"error: {e}\")"
      ],
      "tests": [
        {
          "name": "session",
          "stdin": "add mon ran 5k\nadd mon read a book\nshow mon\nshow tue\ncount\nend\n",
          "expect": [
            "added",
            "added",
            "- ran 5k",
            "- read a book",
            "nothing on tue",
            "2"
          ]
        },
        {
          "name": "errors",
          "stdin": "add mon\nfly away\ncount\nend\n",
          "expect": [
            "error: entry text is blank",
            "error: unknown command",
            "0"
          ]
        }
      ],
      "hints": [
        "`line.split(maxsplit=2)` keeps the entry text in one piece.",
        "`case [\"add\", day, *rest]:` also matches `add mon` with an empty `rest`, so `add` raises the `ValueError` for you.",
        "Wrap the `match` in `try`/`except ValueError as e`."
      ]
    }
  ]
}
