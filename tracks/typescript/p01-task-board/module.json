{
  "kind": "project",
  "title": "Task Board Core",
  "summary": "Build the typed core of a Trello-style task board: domain types and validation, a reducer driven by discriminated-union actions, selectors, undo/redo, and versioned JSON persistence. It is exactly the logic a React or Next.js front end would sit on.",
  "level": "After module 5. Stage 4 uses generics and stage 5 uses JSON and unknown narrowing.",
  "skills": [
    "TypeScript types",
    "Discriminated unions",
    "Reducers",
    "Immutability",
    "Generics",
    "Undo/redo",
    "JSON persistence"
  ],
  "blueprint": {
    "layers": [
      "UI",
      "State",
      "Domain",
      "Storage"
    ],
    "parts": [
      {
        "id": "ui",
        "label": "React components (later)",
        "layer": "UI",
        "stage": 3,
        "note": "Render selectTasks(board, filter); dispatch actions."
      },
      {
        "id": "types",
        "label": "Task, Status, Priority",
        "layer": "Domain",
        "stage": 1
      },
      {
        "id": "create",
        "label": "createTask + validation",
        "layer": "Domain",
        "stage": 1,
        "note": "Result<Task>, never throws for bad input"
      },
      {
        "id": "reducer",
        "label": "boardReducer",
        "layer": "State",
        "stage": 2,
        "note": "Discriminated-union actions, immutable updates"
      },
      {
        "id": "selectors",
        "label": "selectTasks, countByStatus",
        "layer": "State",
        "stage": 3,
        "note": "Derived data, never stored"
      },
      {
        "id": "history",
        "label": "undoable(reducer)",
        "layer": "State",
        "stage": 4,
        "note": "past / present / future"
      },
      {
        "id": "persist",
        "label": "serialize / deserialize",
        "layer": "Storage",
        "stage": 5,
        "note": "Versioned JSON with migration"
      }
    ],
    "flow": [
      [
        "ui",
        "history"
      ],
      [
        "history",
        "reducer"
      ],
      [
        "reducer",
        "types"
      ],
      [
        "ui",
        "selectors"
      ],
      [
        "selectors",
        "reducer"
      ],
      [
        "ui",
        "create"
      ],
      [
        "create",
        "types"
      ],
      [
        "history",
        "persist"
      ]
    ]
  }
}
