{
  "title": "Stage 3: happy hour on a fake clock",
  "summary": "An extra 5% from 17:00 to 19:00 UTC. The engine already takes a TimeProvider; the tests use FakeTimeProvider.",
  "minutes": 20,
  "prereqs": [
    "testing/03-test-doubles/03-time-randomness-files"
  ],
  "steps": [
    {
      "type": "learn",
      "title": "Ticket SHOP-219: happy hour",
      "body": [
        "From **17:00 (included) to 19:00 (excluded) UTC**, carts get an extra **5% of what is left after the multi-buy and the coupon**. The 30% cap still applies to the whole discount.",
        "",
        "Read the time from the engine's `TimeProvider` (`clock.GetUtcNow()`), never from `DateTime`. Your tests build engines on a `FakeTimeProvider` at the moments that matter: 16:59, 17:00, 18:59, 19:00. Existing tests that used `TimeProvider.System` now become time-dependent: move them to a fixed clock outside happy hour (10:00), or they will fail every evening."
      ]
    },
    {
      "type": "mcq",
      "prompt": "After this stage, why is `new PricingEngine(TimeProvider.System)` in an old test a problem?",
      "options": [
        "Between 17:00 and 19:00 UTC that test gets the happy-hour discount and fails: it reads the real clock",
        "TimeProvider.System is obsolete",
        "It makes the test slower",
        "FakeTimeProvider and TimeProvider.System cannot be mixed"
      ],
      "answer": 0,
      "explain": "A new time-based rule turns every real-clock test into a flaky test. Fixed clocks everywhere keep the suite deterministic."
    },
    {
      "type": "code",
      "title": "Stage 3: happy hour",
      "carry": true,
      "prompt": [
        "Add happy hour, test-first. Move your tests onto a `FakeTimeProvider` at 10:00 (add `using Microsoft.Extensions.Time.Testing;` at the top) and add tests at both edges of the window and for the cap. At least **13** tests in all. All three stages' acceptance tests run."
      ],
      "starter": [
        "public record CartLine(string Sku, int Quantity, decimal UnitPrice);",
        "",
        "public sealed class PricingEngine(TimeProvider clock)",
        "{",
        "    public decimal Subtotal(IReadOnlyList<CartLine> lines)",
        "    {",
        "        foreach (var line in lines)",
        "        {",
        "            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(line.Quantity);",
        "            ArgumentOutOfRangeException.ThrowIfNegative(line.UnitPrice);",
        "        }",
        "        return lines.Sum(l => l.Quantity * l.UnitPrice);",
        "    }",
        "",
        "    public decimal Discount(IReadOnlyList<CartLine> lines, string? coupon = null)",
        "    {",
        "        var subtotal = Subtotal(lines);",
        "        var multiBuy = lines.Where(l => l.Sku == \"mug\").Sum(l => l.Quantity / 3 * l.UnitPrice);",
        "        var afterMultiBuy = subtotal - multiBuy;",
        "        var couponOff = coupon switch",
        "        {",
        "            null or \"\" => 0m,",
        "            \"SAVE10\" => afterMultiBuy >= 50m ? afterMultiBuy * 0.10m : 0m,",
        "            _ => throw new ArgumentException($\"Unknown coupon {coupon}.\", nameof(coupon)),",
        "        };",
        "        return Math.Round(Math.Min(multiBuy + couponOff, subtotal * 0.30m), 2, MidpointRounding.AwayFromZero);",
        "    }",
        "",
        "    public decimal Total(IReadOnlyList<CartLine> lines, string? coupon = null) => Subtotal(lines) - Discount(lines, coupon);",
        "}",
        "",
        "public class PricingEngineTests",
        "{",
        "    readonly PricingEngine engine = new(TimeProvider.System);",
        "",
        "    [Fact]",
        "    public void An_empty_cart_costs_nothing() => Assert.Equal(0m, engine.Subtotal([]));",
        "",
        "    [Fact]",
        "    public void Lines_are_quantity_times_price_summed() =>",
        "        Assert.Equal(20.50m, engine.Subtotal([new(\"mug\", 2, 8.00m), new(\"tea\", 1, 4.50m)]));",
        "",
        "    [Theory]",
        "    [InlineData(0)]",
        "    [InlineData(-1)]",
        "    public void Quantities_must_be_positive(int quantity) =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", quantity, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Prices_cannot_be_negative() =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 1, -0.01m)]));",
        "",
        "    [Theory]",
        "    [InlineData(2, 0)]",
        "    [InlineData(5, 8)]",
        "    [InlineData(7, 16)]",
        "    public void Every_third_mug_is_free(int mugs, int freeEuros) =>",
        "        Assert.Equal(freeEuros, engine.Discount([new(\"mug\", mugs, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Save10_takes_ten_percent_from_50() => Assert.Equal(6.00m, engine.Discount([new(\"pot\", 1, 60.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Save10_needs_50_after_the_multi_buy() => Assert.Equal(0m, engine.Discount([new(\"pot\", 1, 49.99m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Discounts_are_capped_at_30_percent() => Assert.Equal(21.60m, engine.Discount([new(\"mug\", 9, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Unknown_coupons_are_refused() => Assert.Throws<ArgumentException>(() => engine.Discount([new(\"pot\", 1, 60m)], \"FREE\"));",
        "}"
      ],
      "solution": [
        "using Microsoft.Extensions.Time.Testing;",
        "",
        "public record CartLine(string Sku, int Quantity, decimal UnitPrice);",
        "",
        "public sealed class PricingEngine(TimeProvider clock)",
        "{",
        "    public decimal Subtotal(IReadOnlyList<CartLine> lines)",
        "    {",
        "        foreach (var line in lines)",
        "        {",
        "            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(line.Quantity);",
        "            ArgumentOutOfRangeException.ThrowIfNegative(line.UnitPrice);",
        "        }",
        "        return lines.Sum(l => l.Quantity * l.UnitPrice);",
        "    }",
        "",
        "    public decimal Discount(IReadOnlyList<CartLine> lines, string? coupon = null)",
        "    {",
        "        var subtotal = Subtotal(lines);",
        "        var multiBuy = lines.Where(l => l.Sku == \"mug\").Sum(l => l.Quantity / 3 * l.UnitPrice);",
        "        var afterMultiBuy = subtotal - multiBuy;",
        "        var couponOff = coupon switch",
        "        {",
        "            null or \"\" => 0m,",
        "            \"SAVE10\" => afterMultiBuy >= 50m ? afterMultiBuy * 0.10m : 0m,",
        "            _ => throw new ArgumentException($\"Unknown coupon {coupon}.\", nameof(coupon)),",
        "        };",
        "        var happyHour = IsHappyHour() ? (afterMultiBuy - couponOff) * 0.05m : 0m;",
        "        return Math.Round(Math.Min(multiBuy + couponOff + happyHour, subtotal * 0.30m), 2, MidpointRounding.AwayFromZero);",
        "    }",
        "",
        "    public decimal Total(IReadOnlyList<CartLine> lines, string? coupon = null) => Subtotal(lines) - Discount(lines, coupon);",
        "",
        "    bool IsHappyHour()",
        "    {",
        "        var hour = clock.GetUtcNow().Hour;",
        "        return hour >= 17 && hour < 19;",
        "    }",
        "}",
        "",
        "public class PricingEngineTests",
        "{",
        "    static FakeTimeProvider At(int hour, int minute = 0) => new(new DateTimeOffset(2026, 11, 27, hour, minute, 0, TimeSpan.Zero));",
        "    readonly PricingEngine engine = new(At(10));",
        "",
        "    [Fact]",
        "    public void An_empty_cart_costs_nothing() => Assert.Equal(0m, engine.Subtotal([]));",
        "",
        "    [Fact]",
        "    public void Lines_are_quantity_times_price_summed() =>",
        "        Assert.Equal(20.50m, engine.Subtotal([new(\"mug\", 2, 8.00m), new(\"tea\", 1, 4.50m)]));",
        "",
        "    [Theory]",
        "    [InlineData(0)]",
        "    [InlineData(-1)]",
        "    public void Quantities_must_be_positive(int quantity) =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", quantity, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Prices_cannot_be_negative() =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 1, -0.01m)]));",
        "",
        "    [Theory]",
        "    [InlineData(2, 0)]",
        "    [InlineData(5, 8)]",
        "    [InlineData(7, 16)]",
        "    public void Every_third_mug_is_free(int mugs, int freeEuros) =>",
        "        Assert.Equal(freeEuros, engine.Discount([new(\"mug\", mugs, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Save10_takes_ten_percent_from_50() => Assert.Equal(6.00m, engine.Discount([new(\"pot\", 1, 60.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Save10_needs_50_after_the_multi_buy() => Assert.Equal(0m, engine.Discount([new(\"pot\", 1, 49.99m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Discounts_are_capped_at_30_percent() => Assert.Equal(21.60m, engine.Discount([new(\"mug\", 9, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Unknown_coupons_are_refused() => Assert.Throws<ArgumentException>(() => engine.Discount([new(\"pot\", 1, 60m)], \"FREE\"));",
        "",
        "    [Theory]",
        "    [InlineData(17, 0, 300)]",
        "    [InlineData(18, 59, 300)]",
        "    [InlineData(16, 59, 0)]",
        "    [InlineData(19, 0, 0)]",
        "    public void Happy_hour_takes_five_percent_from_17_to_19_utc(int hour, int minute, int expectedCents) =>",
        "        Assert.Equal(expectedCents / 100m, new PricingEngine(At(hour, minute)).Discount([new(\"pot\", 1, 60.00m)]));",
        "",
        "    [Fact]",
        "    public void Happy_hour_still_respects_the_cap() =>",
        "        Assert.Equal(21.60m, new PricingEngine(At(17)).Discount([new(\"mug\", 9, 8.00m)]));",
        "}"
      ],
      "template": [
        "{{CODE}}",
        "public class Stage1Acceptance",
        "{",
        "    readonly PricingEngine engine = new(TimeProvider.System);",
        "    [Fact] public void Empty() => Assert.Equal(0m, engine.Subtotal([]));",
        "    [Fact] public void Sums() => Assert.Equal(28.49m, engine.Subtotal([new(\"mug\", 3, 8.00m), new(\"tea\", 1, 4.49m)]));",
        "    [Fact] public void Total_is_the_subtotal_for_now() => Assert.Equal(8.00m, engine.Total([new(\"mug\", 1, 8.00m)]));",
        "    [Fact] public void Zero_quantity() => Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 0, 8m)]));",
        "    [Fact] public void Negative_price() => Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 1, -1m)]));",
        "    [Fact] public void Free_items_are_fine() => Assert.Equal(0m, engine.Subtotal([new(\"sticker\", 5, 0m)]));",
        "}",
        "public class Stage2Acceptance",
        "{",
        "    readonly PricingEngine engine = new(new Microsoft.Extensions.Time.Testing.FakeTimeProvider(new DateTimeOffset(2026, 11, 27, 10, 0, 0, TimeSpan.Zero)));",
        "    [Fact] public void Three_for_two() => Assert.Equal(8.00m, engine.Discount([new(\"mug\", 3, 8.00m), new(\"tea\", 1, 10.00m)]));",
        "    [Fact] public void Six_mugs_two_free() => Assert.Equal(16.00m, engine.Discount([new(\"mug\", 6, 8.00m), new(\"pot\", 1, 20.00m)]));",
        "    [Fact] public void Only_mugs() => Assert.Equal(0m, engine.Discount([new(\"tea\", 9, 4.00m)]));",
        "    [Fact] public void Coupon() => Assert.Equal(7.00m, engine.Discount([new(\"pot\", 1, 70.00m)], \"SAVE10\"));",
        "    [Fact] public void Coupon_at_exactly_50() => Assert.Equal(5.00m, engine.Discount([new(\"pot\", 1, 50.00m)], \"SAVE10\"));",
        "    [Fact] public void Coupon_counts_after_the_multi_buy() => Assert.Equal(8.00m, engine.Discount([new(\"mug\", 3, 8.00m), new(\"tea\", 6, 5.00m)], \"SAVE10\"));",
        "    [Fact] public void Cap() => Assert.Equal(21.60m, engine.Discount([new(\"mug\", 9, 8.00m)], \"SAVE10\"));",
        "    [Fact] public void Total_subtracts_the_discount() => Assert.Equal(63.00m, engine.Total([new(\"pot\", 1, 70.00m)], \"SAVE10\"));",
        "    [Fact] public void No_coupon_is_fine() => Assert.Equal(0m, engine.Discount([new(\"pot\", 1, 70m)], null));",
        "    [Fact] public void Unknown_coupon() => Assert.Throws<ArgumentException>(() => engine.Discount([new(\"pot\", 1, 70m)], \"HALFOFF\"));",
        "}",
        "public class Stage3Acceptance",
        "{",
        "    static PricingEngine At(int hour, int minute = 0) =>",
        "        new(new Microsoft.Extensions.Time.Testing.FakeTimeProvider(new DateTimeOffset(2026, 11, 27, hour, minute, 0, TimeSpan.Zero)));",
        "    [Fact] public void Starts_at_17() => Assert.Equal(4.00m, At(17).Discount([new(\"pot\", 1, 80.00m)]));",
        "    [Fact] public void Not_before() => Assert.Equal(0m, At(16, 59).Discount([new(\"pot\", 1, 80.00m)]));",
        "    [Fact] public void Last_minute() => Assert.Equal(4.00m, At(18, 59).Discount([new(\"pot\", 1, 80.00m)]));",
        "    [Fact] public void Ends_at_19() => Assert.Equal(0m, At(19).Discount([new(\"pot\", 1, 80.00m)]));",
        "    [Fact] public void After_coupon() => Assert.Equal(11.60m, At(17, 30).Discount([new(\"pot\", 1, 80.00m)], \"SAVE10\"));",
        "    [Fact] public void Capped() => Assert.Equal(21.60m, At(18).Discount([new(\"mug\", 9, 8.00m)], \"SAVE10\"));",
        "    [Fact] public void Earlier_rules_still_hold() => Assert.Equal(8.00m, At(9).Discount([new(\"mug\", 3, 8.00m), new(\"tea\", 1, 10.00m)]));",
        "}"
      ],
      "xunit": {
        "minTests": 13
      },
      "forbid": [
        {
          "pattern": "DateTime(Offset)?\\.(Now|UtcNow)",
          "message": "Never reads the real clock"
        }
      ],
      "hints": [
        "`var hour = clock.GetUtcNow().Hour; return hour >= 17 && hour < 19;`",
        "Happy hour is 5% of `afterMultiBuy - couponOff`, added before the cap.",
        "In the tests: `static FakeTimeProvider At(int hour, int minute = 0) => new(new DateTimeOffset(2026, 11, 27, hour, minute, 0, TimeSpan.Zero));`."
      ],
      "explain": "Taking the TimeProvider in stage 1 paid off: the rule is three lines, and every test controls the time. Note the cap test at 18:00: rules that stack are where caps matter."
    }
  ]
}
