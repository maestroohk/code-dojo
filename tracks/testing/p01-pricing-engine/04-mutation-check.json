{
  "title": "Stage 4: the mutation check",
  "summary": "Before release, the engine's suite is judged by planted bugs: every rule, every edge, every combination.",
  "minutes": 20,
  "prereqs": [
    "testing/05-mutation-thinking/02-operators-and-equivalent-mutants"
  ],
  "steps": [
    {
      "type": "learn",
      "title": "Release gate: mutation score 100% on pricing",
      "body": [
        "Pricing bugs cost money, so the team gates releases on `dotnet stryker --since:main --break-at 100` for the pricing folder. In this stage the reference engine (the same rules as yours) is compiled beside **your tests only**, and nine planted bugs, one per rule edge, must each make a test fail.",
        "",
        "Start from the tests you wrote in stages 1 to 3: paste your `PricingEngineTests` class (the starter has the reference version of stage 3's). If a bug survives, its name tells you which edge your suite does not pin."
      ]
    },
    {
      "type": "code",
      "title": "Stage 4: kill every mutant",
      "prompt": [
        "Write `public class PricingEngineTests` (tests only; the engine is provided) with at least **12** tests. The engine's API: `new PricingEngine(TimeProvider)`, `Subtotal(lines)`, `Discount(lines, coupon = null)`, `Total(lines, coupon = null)`, with the rules of stages 1 to 3. Nine planted bugs."
      ],
      "starter": [
        "using Microsoft.Extensions.Time.Testing;",
        "",
        "public class PricingEngineTests",
        "{",
        "    static FakeTimeProvider At(int hour, int minute = 0) => new(new DateTimeOffset(2026, 11, 27, hour, minute, 0, TimeSpan.Zero));",
        "    readonly PricingEngine engine = new(At(10));",
        "",
        "    [Fact]",
        "    public void An_empty_cart_costs_nothing() => Assert.Equal(0m, engine.Subtotal([]));",
        "",
        "    [Fact]",
        "    public void Lines_are_quantity_times_price_summed() =>",
        "        Assert.Equal(20.50m, engine.Subtotal([new(\"mug\", 2, 8.00m), new(\"tea\", 1, 4.50m)]));",
        "",
        "    [Theory]",
        "    [InlineData(0)]",
        "    [InlineData(-1)]",
        "    public void Quantities_must_be_positive(int quantity) =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", quantity, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Prices_cannot_be_negative() =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 1, -0.01m)]));",
        "",
        "    [Theory]",
        "    [InlineData(2, 0)]",
        "    [InlineData(5, 8)]",
        "    [InlineData(7, 16)]",
        "    public void Every_third_mug_is_free(int mugs, int freeEuros) =>",
        "        Assert.Equal(freeEuros, engine.Discount([new(\"mug\", mugs, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Save10_takes_ten_percent_from_50() => Assert.Equal(6.00m, engine.Discount([new(\"pot\", 1, 60.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Save10_needs_50_after_the_multi_buy() => Assert.Equal(0m, engine.Discount([new(\"pot\", 1, 49.99m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Discounts_are_capped_at_30_percent() => Assert.Equal(21.60m, engine.Discount([new(\"mug\", 9, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Unknown_coupons_are_refused() => Assert.Throws<ArgumentException>(() => engine.Discount([new(\"pot\", 1, 60m)], \"FREE\"));",
        "",
        "    [Theory]",
        "    [InlineData(17, 0, 300)]",
        "    [InlineData(18, 59, 300)]",
        "    [InlineData(16, 59, 0)]",
        "    [InlineData(19, 0, 0)]",
        "    public void Happy_hour_takes_five_percent_from_17_to_19_utc(int hour, int minute, int expectedCents) =>",
        "        Assert.Equal(expectedCents / 100m, new PricingEngine(At(hour, minute)).Discount([new(\"pot\", 1, 60.00m)]));",
        "",
        "    [Fact]",
        "    public void Happy_hour_still_respects_the_cap() =>",
        "        Assert.Equal(21.60m, new PricingEngine(At(17)).Discount([new(\"mug\", 9, 8.00m)]));",
        "}"
      ],
      "solution": [
        "using Microsoft.Extensions.Time.Testing;",
        "",
        "public class PricingEngineTests",
        "{",
        "    static FakeTimeProvider At(int hour, int minute = 0) => new(new DateTimeOffset(2026, 11, 27, hour, minute, 0, TimeSpan.Zero));",
        "    readonly PricingEngine engine = new(At(10));",
        "",
        "    [Fact]",
        "    public void An_empty_cart_costs_nothing() => Assert.Equal(0m, engine.Subtotal([]));",
        "",
        "    [Fact]",
        "    public void Lines_are_quantity_times_price_summed() =>",
        "        Assert.Equal(20.50m, engine.Subtotal([new(\"mug\", 2, 8.00m), new(\"tea\", 1, 4.50m)]));",
        "",
        "    [Theory]",
        "    [InlineData(0)]",
        "    [InlineData(-1)]",
        "    public void Quantities_must_be_positive(int quantity) =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", quantity, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Prices_cannot_be_negative() =>",
        "        Assert.Throws<ArgumentOutOfRangeException>(() => engine.Subtotal([new(\"mug\", 1, -0.01m)]));",
        "",
        "    [Theory]",
        "    [InlineData(2, 0)]",
        "    [InlineData(5, 8)]",
        "    [InlineData(7, 16)]",
        "    public void Every_third_mug_is_free(int mugs, int freeEuros) =>",
        "        Assert.Equal(freeEuros, engine.Discount([new(\"mug\", mugs, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Save10_takes_ten_percent_from_50() => Assert.Equal(6.00m, engine.Discount([new(\"pot\", 1, 60.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Save10_needs_50_after_the_multi_buy() => Assert.Equal(0m, engine.Discount([new(\"pot\", 1, 49.99m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Discounts_are_capped_at_30_percent() => Assert.Equal(21.60m, engine.Discount([new(\"mug\", 9, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Unknown_coupons_are_refused() => Assert.Throws<ArgumentException>(() => engine.Discount([new(\"pot\", 1, 60m)], \"FREE\"));",
        "",
        "    [Theory]",
        "    [InlineData(17, 0, 300)]",
        "    [InlineData(18, 59, 300)]",
        "    [InlineData(16, 59, 0)]",
        "    [InlineData(19, 0, 0)]",
        "    public void Happy_hour_takes_five_percent_from_17_to_19_utc(int hour, int minute, int expectedCents) =>",
        "        Assert.Equal(expectedCents / 100m, new PricingEngine(At(hour, minute)).Discount([new(\"pot\", 1, 60.00m)]));",
        "",
        "    [Fact]",
        "    public void Happy_hour_still_respects_the_cap() =>",
        "        Assert.Equal(21.60m, new PricingEngine(At(17)).Discount([new(\"mug\", 9, 8.00m)]));",
        "",
        "    [Fact]",
        "    public void Save10_at_exactly_50() => Assert.Equal(5.00m, engine.Discount([new(\"pot\", 1, 50.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Save10_sees_the_amount_after_the_multi_buy() =>",
        "        Assert.Equal(8.00m, engine.Discount([new(\"mug\", 3, 8.00m), new(\"tea\", 6, 5.00m)], \"SAVE10\"));",
        "",
        "    [Fact]",
        "    public void Only_mugs_are_three_for_two() => Assert.Equal(0m, engine.Discount([new(\"tea\", 9, 4.00m)]));",
        "}"
      ],
      "xunit": {
        "minTests": 12,
        "target": [
          "public record CartLine(string Sku, int Quantity, decimal UnitPrice);",
          "",
          "public sealed class PricingEngine(TimeProvider clock)",
          "{",
          "    public decimal Subtotal(IReadOnlyList<CartLine> lines)",
          "    {",
          "        foreach (var line in lines)",
          "        {",
          "            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(line.Quantity);",
          "            ArgumentOutOfRangeException.ThrowIfNegative(line.UnitPrice);",
          "        }",
          "        return lines.Sum(l => l.Quantity * l.UnitPrice);",
          "    }",
          "",
          "    public decimal Discount(IReadOnlyList<CartLine> lines, string? coupon = null)",
          "    {",
          "        var subtotal = Subtotal(lines);",
          "        var multiBuy = lines.Where(l => l.Sku == \"mug\").Sum(l => l.Quantity / 3 * l.UnitPrice);",
          "        var afterMultiBuy = subtotal - multiBuy;",
          "        var couponOff = coupon switch",
          "        {",
          "            null or \"\" => 0m,",
          "            \"SAVE10\" => afterMultiBuy >= 50m ? afterMultiBuy * 0.10m : 0m,",
          "            _ => throw new ArgumentException($\"Unknown coupon {coupon}.\", nameof(coupon)),",
          "        };",
          "        var happyHour = IsHappyHour() ? (afterMultiBuy - couponOff) * 0.05m : 0m;",
          "        return Math.Round(Math.Min(multiBuy + couponOff + happyHour, subtotal * 0.30m), 2, MidpointRounding.AwayFromZero);",
          "    }",
          "",
          "    public decimal Total(IReadOnlyList<CartLine> lines, string? coupon = null) => Subtotal(lines) - Discount(lines, coupon);",
          "",
          "    bool IsHappyHour()",
          "    {",
          "        var hour = clock.GetUtcNow().Hour;",
          "        return hour >= 17 && hour < 19;",
          "    }",
          "}"
        ],
        "mutants": [
          {
            "name": "two for one instead of three for two",
            "replace": [
              [
                "l.Quantity / 3",
                "l.Quantity / 2"
              ]
            ]
          },
          {
            "name": "the multi-buy applies to every product",
            "replace": [
              [
                "lines.Where(l => l.Sku == \"mug\")",
                "lines"
              ]
            ]
          },
          {
            "name": "SAVE10 needs more than 50",
            "replace": [
              [
                "afterMultiBuy >= 50m",
                "afterMultiBuy > 50m"
              ]
            ],
            "hint": "Test a cart of exactly 50 with SAVE10."
          },
          {
            "name": "SAVE10 counts before the multi-buy",
            "replace": [
              [
                "afterMultiBuy >= 50m ? afterMultiBuy * 0.10m",
                "subtotal >= 50m ? subtotal * 0.10m"
              ]
            ],
            "hint": "A cart with mugs where the multi-buy changes the coupon."
          },
          {
            "name": "the cap is gone",
            "replace": [
              [
                "Math.Min(multiBuy + couponOff + happyHour, subtotal * 0.30m)",
                "multiBuy + couponOff + happyHour"
              ]
            ]
          },
          {
            "name": "the cap is 40%",
            "replace": [
              [
                "subtotal * 0.30m",
                "subtotal * 0.40m"
              ]
            ]
          },
          {
            "name": "happy hour starts at 18:00",
            "replace": [
              [
                "hour >= 17",
                "hour > 17"
              ]
            ]
          },
          {
            "name": "happy hour includes 19:00",
            "replace": [
              [
                "hour < 19",
                "hour <= 19"
              ]
            ]
          },
          {
            "name": "a quantity of zero is accepted",
            "replace": [
              [
                "ThrowIfNegativeOrZero(line.Quantity)",
                "ThrowIfNegative(line.Quantity)"
              ]
            ]
          }
        ]
      },
      "hints": [
        "Check the starter against the bug names: which edge does no test pin?",
        "Exactly 50 with SAVE10 must give 5.00; three mugs plus 30.00 of tea with SAVE10 gives 8.00 (the coupon sees 30.00, below 50).",
        "Two fake clocks per edge: 16:59 and 17:00, 18:59 and 19:00."
      ],
      "explain": "Your suite now pins every rule from both sides, so a refactor of the engine, or a well-meant \"small fix\", cannot change a price without a red test. That is the job a test suite does at a shop that takes money."
    }
  ]
}
