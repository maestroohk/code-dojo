{
  "title": "Secure the API",
  "summary": "Build a complete token-secured API from nothing: registration with hashed passwords, HS256 access tokens, your own bearer middleware, roles with correct 401 and 403, and refresh tokens with rotation and revocation. Every stage is tested over real HTTP.",
  "kind": "project",
  "level": "After the Authentication & JWT modules 1 to 5.",
  "skills": [
    "Password hashing",
    "JWT",
    "Bearer middleware",
    "Authorization",
    "Refresh tokens",
    "Minimal APIs"
  ],
  "blueprint": {
    "layers": [
      "Client",
      "Auth endpoint",
      "Middleware",
      "Endpoints",
      "User store"
    ],
    "parts": [
      {
        "id": "client",
        "label": "HTTP client",
        "layer": "Client",
        "stage": 1,
        "note": "The tests, or any app holding a token."
      },
      {
        "id": "register",
        "label": "POST /register · /login",
        "layer": "Auth endpoint",
        "stage": 1,
        "note": "PBKDF2, generic errors"
      },
      {
        "id": "users",
        "label": "User store",
        "layer": "User store",
        "stage": 1,
        "note": "Hashes only, never passwords"
      },
      {
        "id": "issuer",
        "label": "HS256 token issuer",
        "layer": "Auth endpoint",
        "stage": 2,
        "note": "iss, sub, aud, iat, exp, jti, role"
      },
      {
        "id": "bearer",
        "label": "Bearer middleware",
        "layer": "Middleware",
        "stage": 3,
        "note": "Validates and sets HttpContext.User"
      },
      {
        "id": "me",
        "label": "GET /me",
        "layer": "Endpoints",
        "stage": 3
      },
      {
        "id": "admin",
        "label": "/admin/* (role admin)",
        "layer": "Endpoints",
        "stage": 4,
        "note": "401 vs 403"
      },
      {
        "id": "refresh",
        "label": "POST /refresh · /logout",
        "layer": "Auth endpoint",
        "stage": 5,
        "note": "Rotation and reuse detection"
      },
      {
        "id": "rtstore",
        "label": "Refresh token store",
        "layer": "User store",
        "stage": 5,
        "note": "SHA-256 hashes, families"
      }
    ],
    "flow": [
      [
        "client",
        "register"
      ],
      [
        "register",
        "users"
      ],
      [
        "register",
        "issuer"
      ],
      [
        "client",
        "bearer"
      ],
      [
        "bearer",
        "me"
      ],
      [
        "bearer",
        "admin"
      ],
      [
        "admin",
        "users"
      ],
      [
        "client",
        "refresh"
      ],
      [
        "refresh",
        "rtstore"
      ],
      [
        "refresh",
        "issuer"
      ]
    ]
  }
}
