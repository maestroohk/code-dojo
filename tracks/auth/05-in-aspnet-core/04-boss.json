        "    }",
        "",
        "    static byte[] FromB64Url(string text)",
        "    {",
        "        var s = text.Replace('-', '+').Replace('_', '/');",
        "        if (s.Length % 4 == 1) throw new FormatException();",
        "        return Convert.FromBase64String(s.PadRight(s.Length + (4 - s.Length % 4) % 4, '='));",
        "    }",
        "",
        "    public static ClaimsPrincipal ToPrincipal(string payloadJson, string scheme)",
        "    {",
        "        using var doc = JsonDocument.Parse(payloadJson);",
        "        var claims = new List<Claim>();",
        "        foreach (var prop in doc.RootElement.EnumerateObject())",
        "        {",
        "            if (prop.Value.ValueKind == JsonValueKind.Array)",
        "                foreach (var item in prop.Value.EnumerateArray()) claims.Add(new Claim(prop.Name, item.ToString()));",
        "            else",
        "                claims.Add(new Claim(prop.Name, prop.Value.ToString()));",
        "        }",
        "        return new ClaimsPrincipal(new ClaimsIdentity(claims, scheme, \"sub\", \"role\"));",
        "    }",
        "}"
      ],
      "solution": [
        "using System.Security.Claims;",
        "using System.Security.Cryptography;",
        "using System.Text;",
        "using System.Text.Encodings.Web;",
        "using Microsoft.AspNetCore.Authentication;",
        "using Microsoft.AspNetCore.Authorization;",
        "using Microsoft.Extensions.Options;",
        "",
        "var builder = WebApplication.CreateBuilder(args);",
        "",
        "builder.Services.AddAuthentication(\"Bearer\")",
        "    .AddScheme<AuthenticationSchemeOptions, HsBearerHandler>(\"Bearer\", null);",
        "builder.Services.AddAuthorization(o => o.AddPolicy(\"Admin\", p => p.RequireRole(\"admin\")));",
        "",
        "var app = builder.Build();",
        "app.UseAuthentication();",
        "app.UseAuthorization();",
        "",
        "app.MapGet(\"/public\", () => \"hello\");",
        "app.MapGet(\"/me\", (ClaimsPrincipal user) => new { sub = user.Identity?.Name }).RequireAuthorization();",
        "app.MapDelete(\"/admin/tasks/{id:int}\", (int id) => Results.NoContent()).RequireAuthorization(\"Admin\");",
        "",
        "app.Run();",
        "",
        "class HsBearerHandler(IOptionsMonitor<AuthenticationSchemeOptions> options, ILoggerFactory logger, UrlEncoder encoder)",
        "    : AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder)",
        "{",
        "    protected override Task<AuthenticateResult> HandleAuthenticateAsync()",
        "    {",
        "        var header = Request.Headers.Authorization.ToString();",
        "        if (header.Length == 0) return Task.FromResult(AuthenticateResult.NoResult());",
        "        if (!header.StartsWith(\"Bearer \", StringComparison.OrdinalIgnoreCase))",
        "            return Task.FromResult(AuthenticateResult.Fail(\"Not a bearer token.\"));",
        "",
        "        var payload = TokenValidator.ValidatePayload(header[7..].Trim(), DateTimeOffset.UtcNow.ToUnixTimeSeconds());",
        "        if (payload is null) return Task.FromResult(AuthenticateResult.Fail(\"Invalid token.\"));",
        "",
        "        var principal = TokenValidator.ToPrincipal(payload, Scheme.Name);",
        "        return Task.FromResult(AuthenticateResult.Success(new AuthenticationTicket(principal, Scheme.Name)));",
        "    }",
        "",
        "    protected override Task HandleChallengeAsync(AuthenticationProperties properties)",
        "    {",
        "        Response.StatusCode = 401;",
        "        Response.Headers.WWWAuthenticate = \"Bearer\";",
        "        return Task.CompletedTask;",
        "    }",
        "}",
        "",
        "static class TokenValidator",
        "{",
        "    public static readonly byte[] Key = Encoding.UTF8.GetBytes(\"aspnet-demo-signing-key-0123456789ab\");",
        "",
        "    // Checks alg, signature, exp (30 s skew), iss and aud. Returns the payload JSON, or null.",
        "    public static string? ValidatePayload(string token, long now)",
        "    {",
        "        var parts = token.Split('.');",
        "        if (parts.Length != 3) return null;",
        "        try",
        "        {",
        "            using var header = JsonDocument.Parse(FromB64Url(parts[0]));",
        "            if (!header.RootElement.TryGetProperty(\"alg\", out var alg) || alg.GetString() != \"HS256\") return null;",
        "            var mac = HMACSHA256.HashData(Key, Encoding.ASCII.GetBytes(parts[0] + \".\" + parts[1]));",
        "            if (!CryptographicOperations.FixedTimeEquals(mac, FromB64Url(parts[2]))) return null;",
        "",
        "            var json = Encoding.UTF8.GetString(FromB64Url(parts[1]));",
        "            using var payload = JsonDocument.Parse(json);",
        "            var p = payload.RootElement;",
        "            if (!p.TryGetProperty(\"exp\", out var exp) || exp.ValueKind != JsonValueKind.Number || now >= exp.GetInt64() + 30) return null;",
        "            if (!p.TryGetProperty(\"iss\", out var iss) || iss.GetString() != \"https://auth.dojo\") return null;",
        "            if (!p.TryGetProperty(\"aud\", out var aud) || aud.ValueKind != JsonValueKind.String || aud.GetString() != \"tasks-api\") return null;",
        "            return json;",
        "        }",
        "        catch (Exception e) when (e is FormatException or JsonException or InvalidOperationException)",
        "        {",
        "            return null;",
        "        }",
        "    }",
        "",
        "    static byte[] FromB64Url(string text)",
        "    {",
        "        var s = text.Replace('-', '+').Replace('_', '/');",
        "        if (s.Length % 4 == 1) throw new FormatException();",
        "        return Convert.FromBase64String(s.PadRight(s.Length + (4 - s.Length % 4) % 4, '='));",
        "    }",
        "",
        "    public static ClaimsPrincipal ToPrincipal(string payloadJson, string scheme)",
        "    {",
        "        using var doc = JsonDocument.Parse(payloadJson);",
        "        var claims = new List<Claim>();",
        "        foreach (var prop in doc.RootElement.EnumerateObject())",
        "        {",
        "            if (prop.Value.ValueKind == JsonValueKind.Array)",
        "                foreach (var item in prop.Value.EnumerateArray()) claims.Add(new Claim(prop.Name, item.ToString()));",
        "            else",
        "                claims.Add(new Claim(prop.Name, prop.Value.ToString()));",
        "        }",
        "        return new ClaimsPrincipal(new ClaimsIdentity(claims, scheme, \"sub\", \"role\"));",
        "    }",
        "}"
      ],
      "hints": [
        "Derive from `AuthenticationHandler<AuthenticationSchemeOptions>` with the three-parameter primary constructor.",
        "`AuthenticateResult.NoResult()`, `.Fail(\"...\")`, `.Success(new AuthenticationTicket(principal, Scheme.Name))`.",
        "Override `HandleChallengeAsync` to set the status and `WWW-Authenticate`."
      ],
      "template": [
        "{{CODE}}",
        "",
        "static class DojoTests",
        "{",
        "    public static async Task Run(HttpClient http)",
        "    {",
        "        await Dojo.TryAsync(\"The handler could be checked\", async () =>",
        "        {",
        "            Dojo.Eq(\"GET /public is open\", \"hello\", await DojoWeb.Text(await DojoAuth.Send(http, HttpMethod.Get, \"/public\", null)));",
        "            var anon = await DojoAuth.Send(http, HttpMethod.Get, \"/me\", null);",
        "            DojoWeb.Status(\"GET /me anonymously gets 401\", 401, anon);",
        "            Dojo.Check(\"with WWW-Authenticate: Bearer\", DojoAuth.Challenge(anon).StartsWith(\"Bearer\"), DojoAuth.Challenge(anon));",
        "            DojoWeb.Status(\"a Basic credential gets 401\", 401, await DojoAuth.Send(http, HttpMethod.Get, \"/me\", \"dXNlcjpwYXNz\", \"Basic\"));",
        "            DojoWeb.Status(\"a wrong-key token gets 401\", 401, await DojoAuth.Send(http, HttpMethod.Get, \"/me\", DojoAuth.Sign(\"{\\\"iss\\\":\\\"https://auth.dojo\\\",\\\"aud\\\":\\\"tasks-api\\\",\\\"sub\\\":\\\"x\\\",\\\"exp\\\":4102444800}\", \"another-key-another-key-another-key\")));",
        "            var me = await DojoAuth.Send(http, HttpMethod.Get, \"/me\", DojoAuth.For(\"ada\"));",
        "            DojoWeb.Status(\"a good token gets 200\", 200, me);",
        "            Dojo.Eq(\"sub\", \"ada\", DojoWeb.Prop(await DojoWeb.Json(me), \"sub\"));",
        "            DojoWeb.Status(\"admin endpoint as user gets 403\", 403, await DojoAuth.Send(http, HttpMethod.Delete, \"/admin/tasks/3\", DojoAuth.For(\"ada\", \"[\\\"user\\\"]\")));",
        "            DojoWeb.Status(\"admin endpoint as admin gets 204\", 204, await DojoAuth.Send(http, HttpMethod.Delete, \"/admin/tasks/3\", DojoAuth.For(\"root\", \"[\\\"admin\\\"]\")));",
        "        });",
        "    }",
        "}",
        "",
        "static class DojoAuth",
        "{",
        "    static string B64(byte[] d) => Convert.ToBase64String(d).TrimEnd('=').Replace('+', '-').Replace('/', '_');",
        "    static string B64(string s) => B64(System.Text.Encoding.UTF8.GetBytes(s));",
        "",
        "    public static string Sign(string payload, string? key = null, string header = \"{\\\"alg\\\":\\\"HS256\\\",\\\"typ\\\":\\\"JWT\\\"}\")",
        "    {",
        "        var input = B64(header) + \".\" + B64(payload);",
        "        var k = System.Text.Encoding.UTF8.GetBytes(key ?? \"aspnet-demo-signing-key-0123456789ab\");",
        "        return input + \".\" + B64(System.Security.Cryptography.HMACSHA256.HashData(k, System.Text.Encoding.ASCII.GetBytes(input)));",
        "    }",
        "",
        "    // A valid token for tasks-api that expires in 2100.",
        "    public static string For(string sub, string roles = \"[]\", string scope = \"\", long exp = 4102444800) =>",
        "        Sign(\"{\\\"iss\\\":\\\"https://auth.dojo\\\",\\\"aud\\\":\\\"tasks-api\\\",\\\"sub\\\":\\\"\" + sub + \"\\\",\\\"role\\\":\" + roles + \",\\\"scope\\\":\\\"\" + scope + \"\\\",\\\"exp\\\":\" + exp + \"}\");",
        "",
        "    public static Task<HttpResponseMessage> Send(HttpClient http, HttpMethod method, string url, string? token, string scheme = \"Bearer\")",
        "    {",
        "        var msg = new HttpRequestMessage(method, url);",
        "        if (token is not null) msg.Headers.TryAddWithoutValidation(\"Authorization\", scheme + \" \" + token);",
        "        return http.SendAsync(msg);",
        "    }",
        "",
        "    public static string Challenge(HttpResponseMessage r) =>",
        "        r.Headers.WwwAuthenticate.Count > 0 ? string.Join(\",\", r.Headers.WwwAuthenticate) : \"\";",
        "}"
      ],
      "require": [
        {
          "pattern": "AuthenticationHandler<",
          "message": "Writes an AuthenticationHandler"
        },
        {
          "pattern": "HandleChallengeAsync",
          "message": "Customises the challenge"
        }
      ]
    }
  ]
