{
  "title": "Pipeline for an app",
  "summary": "Build the complete GitHub Actions pipeline for a .NET API, one stage at a time: build and test, cache and artifacts, a container image, and gated deployments to staging and production.",
  "kind": "project",
  "level": "After module 2 (GitHub Actions); stage 4 uses module 4.",
  "skills": [
    "Workflow triggers",
    "dotnet build/test/publish",
    "Caching",
    "Artifacts",
    "needs",
    "Docker build and push",
    "Least-privilege permissions",
    "Environments and approvals",
    "Smoke tests",
    "Concurrency"
  ],
  "blueprint": {
    "layers": [
      "Triggers",
      "CI",
      "Package",
      "Deploy"
    ],
    "parts": [
      {
        "id": "triggers",
        "label": "push + pull_request on main",
        "layer": "Triggers",
        "stage": 1
      },
      {
        "id": "build",
        "label": "restore, build, test",
        "layer": "CI",
        "stage": 1
      },
      {
        "id": "cache",
        "label": "NuGet cache",
        "layer": "CI",
        "stage": 2
      },
      {
        "id": "results",
        "label": "test results artifact",
        "layer": "CI",
        "stage": 2,
        "note": "uploaded even on failure"
      },
      {
        "id": "publish",
        "label": "api artifact",
        "layer": "Package",
        "stage": 2
      },
      {
        "id": "image",
        "label": "Docker image on ghcr.io",
        "layer": "Package",
        "stage": 3,
        "note": "tagged with the commit SHA"
      },
      {
        "id": "staging",
        "label": "deploy staging + smoke test",
        "layer": "Deploy",
        "stage": 4
      },
      {
        "id": "prod",
        "label": "deploy production (approval)",
        "layer": "Deploy",
        "stage": 4
      }
    ],
    "flow": [
      [
        "triggers",
        "build"
      ],
      [
        "cache",
        "build"
      ],
      [
        "build",
        "results"
      ],
      [
        "build",
        "publish"
      ],
      [
        "build",
        "image"
      ],
      [
        "image",
        "staging"
      ],
      [
        "staging",
        "prod"
      ]
    ]
  }
}
