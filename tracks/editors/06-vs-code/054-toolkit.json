{
  "title": "Senior's toolkit: VS Code",
  "summary": "The keys, commands and files someone fast in VS Code reaches for every day.",
  "minutes": 8,
  "kind": "lesson",
  "steps": [
    {
      "type": "learn",
      "title": "Senior's toolkit: VS Code",
      "body": "Shortcuts are shown for Windows and Linux; on macOS use Cmd where it says Ctrl (and Option for Alt), except where a line says otherwise.",
      "toolkit": [
        {
          "cmd": "Ctrl+Shift+P  Ctrl+P",
          "what": "The command palette runs any command by name; Quick Open finds any file by a few letters.",
          "flags": [
            [
              "Ctrl+Shift+P / F1",
              "command palette"
            ],
            [
              "Ctrl+P",
              "open a file; `:42` line, `@` symbol, `>` palette"
            ],
            [
              "Ctrl+Shift+O",
              "symbol in this file"
            ],
            [
              "Ctrl+T",
              "symbol in the workspace"
            ]
          ],
          "when": "every time you reach for the mouse to find something",
          "lang": "bash"
        },
        {
          "cmd": "F12  Shift+F12  F2  Ctrl+.",
          "what": "Language-server navigation: definition, references, rename across files, quick fixes.",
          "flags": [
            [
              "F12",
              "go to definition"
            ],
            [
              "Alt+F12",
              "peek definition (macOS Option+F12)"
            ],
            [
              "Shift+F12",
              "find all references"
            ],
            [
              "F2",
              "rename symbol everywhere, skipping strings and comments"
            ],
            [
              "Ctrl+.",
              "quick fix / refactor"
            ]
          ],
          "lang": "bash"
        },
        {
          "cmd": "Ctrl+D  Ctrl+Shift+L  Alt+Click",
          "what": "Multi-cursor: add the next match, all matches, or a cursor anywhere, then type once.",
          "flags": [
            [
              "Ctrl+D",
              "add next match (Ctrl+K Ctrl+D skips one)"
            ],
            [
              "Ctrl+Shift+L",
              "every match"
            ],
            [
              "Alt+Click",
              "extra cursor (macOS Option+Click)"
            ],
            [
              "Ctrl+Alt+Up/Down",
              "cursor above/below (Linux Shift+Alt, macOS Option+Cmd)"
            ],
            [
              "Shift+Alt+drag",
              "column selection"
            ],
            [
              "Ctrl+U",
              "undo the last cursor"
            ]
          ],
          "lang": "bash"
        },
        {
          "cmd": "F5  F9  F10  F11  Shift+F11",
          "what": "Debug: start or continue, toggle a breakpoint, step over, into, out.",
          "flags": [
            [
              "right-click the gutter",
              "conditional breakpoint, hit count, logpoint"
            ],
            [
              ".vscode/launch.json",
              "what F5 runs: `type`, `request`, `program`, `args`, `env`"
            ],
            [
              "Shift+F5",
              "stop"
            ]
          ],
          "lang": "bash"
        },
        {
          "cmd": "code --wait",
          "what": "Make VS Code an editor that other tools can wait for: Git, crontab, kubectl edit.",
          "flags": [
            [
              "-w / --wait",
              "do not return until the tab is closed"
            ],
            [
              "-g file:line:col",
              "open at a position"
            ],
            [
              "-d a b",
              "diff two files"
            ],
            [
              "-m l r base result",
              "three-way merge"
            ]
          ],
          "example": "git config --global core.editor \"code --wait\"",
          "lang": "bash"
        },
        {
          "cmd": "Remote-SSH: Connect to Host...",
          "what": "Run VS Code's server on a machine you reach over SSH; it reads `~/.ssh/config`.",
          "flags": [
            [
              "ProxyJump",
              "hop through a bastion"
            ],
            [
              "IdentitiesOnly yes",
              "offer only the configured key"
            ],
            [
              "ssh -G host",
              "check what the config resolves to"
            ]
          ],
          "when": "the bug only happens on that machine",
          "lang": "bash"
        },
        {
          "cmd": "Dev Containers: Reopen in Container",
          "what": "Work inside the toolchain defined in `.devcontainer/devcontainer.json`.",
          "flags": [
            [
              "image / build.dockerfile",
              "where the environment comes from"
            ],
            [
              "features",
              "add tools"
            ],
            [
              "postCreateCommand",
              "install dependencies once"
            ],
            [
              "forwardPorts",
              "reach the app on localhost"
            ]
          ],
          "lang": "bash"
        },
        {
          "cmd": ".vscode/settings.json",
          "what": "Workspace settings committed with the repo; they override user settings key by key.",
          "flags": [
            [
              "\"[python]\": {...}",
              "settings for one language"
            ],
            [
              "files.eol",
              "line endings for new files"
            ],
            [
              "editor.formatOnSave",
              "format on every save"
            ],
            [
              "Ctrl+,",
              "settings UI"
            ]
          ],
          "lang": "bash"
        }
      ]
    },
    {
      "type": "match",
      "prompt": "Match each key or command to its job.",
      "pairs": [
        [
          "`F2`",
          "rename a symbol across the project"
        ],
        [
          "`Ctrl+Shift+L`",
          "put a cursor on every match"
        ],
        [
          "`Shift+F12`",
          "list every reference"
        ],
        [
          "`code --wait`",
          "let Git wait until you close the tab"
        ],
        [
          "`ssh -G devbox`",
          "show what Remote-SSH will connect to"
        ],
        [
          "`F9`",
          "toggle a breakpoint"
        ]
      ]
    },
    {
      "type": "mcq",
      "prompt": "A new teammate's tests fail locally with a different Python version than CI uses, and setup takes them a day. What do you add to the repo?",
      "options": [
        "`.devcontainer/devcontainer.json` with a pinned image and `postCreateCommand` for the dependencies",
        "A longer README",
        "A `.vscode/settings.json` with `python.defaultInterpreterPath`",
        "Their user settings, in a shared drive"
      ],
      "answer": 0,
      "explain": "A dev container makes the toolchain part of the repo: one click and everyone has the same Python, tools and extensions. A settings path only helps if the right Python is already installed."
    },
    {
      "type": "sort",
      "prompt": "User settings or workspace `.vscode/settings.json`?",
      "buckets": [
        "User settings",
        "Workspace (committed)"
      ],
      "items": [
        [
          "Your colour theme",
          0
        ],
        [
          "`editor.formatOnSave` for the project's formatter",
          1
        ],
        [
          "Font size",
          0
        ],
        [
          "`files.eol: \"\\n\"` for a repo of shell scripts",
          1
        ],
        [
          "`editor.multiCursorModifier`",
          0
        ],
        [
          "`\"[python]\": { \"editor.tabSize\": 4 }`",
          1
        ]
      ]
    },
    {
      "type": "blanks",
      "prompt": "Complete the SSH config entry so Remote-SSH can reach `devbox` through the bastion with one key.",
      "code": [
        "Host devbox",
        "    __1__ devbox.example.com",
        "    User ana",
        "    IdentityFile ~/.ssh/id_ed25519",
        "    __2__ yes",
        "    __3__ bastion.example.com"
      ],
      "blanks": [
        "HostName",
        "IdentitiesOnly",
        "ProxyJump"
      ],
      "bank": [
        "Host",
        "ForwardAgent",
        "ProxyCommand"
      ]
    },
    {
      "type": "learn",
      "title": "Make it a habit",
      "body": "For a week, every time you reach for the mouse, open the palette instead and read the shortcut it shows next to the command. Learn `Ctrl+P`, `Ctrl+D`, `F2` and `F12` first: they pay back the most."
    }
  ]
}
