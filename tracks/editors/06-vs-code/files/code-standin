#!/bin/sh
# A stand-in for VS Code's `code` launcher (VS Code itself is not installed in this container).
# Like the real one, it returns at once unless --wait is given. With --wait it pretends you typed a commit
# message, saved and closed the tab, so Git can carry on.
wait=; mode=
for a in "$@"; do case $a in --wait|-w) wait=1 ;; --diff|-d) mode=diff ;; --merge|-m) mode=merge ;; esac; done
last=; for a in "$@"; do last=$a; done
if [ -z "$wait" ]; then
  echo "[code stand-in] opened $last in VS Code and returned at once (no --wait)." >&2
  exit 0
fi
case $mode in
  diff) echo "[code stand-in] VS Code would show a side-by-side diff and wait for you to close it." >&2 ;;
  merge) echo "[code stand-in] VS Code would open the merge editor on $last and wait." >&2 ;;
  *) case $last in
       *COMMIT_EDITMSG) printf 'Fix README typo\n' > "$last"
          echo "[code stand-in] you typed 'Fix README typo', saved, and closed the tab." >&2 ;;
       *) echo "[code stand-in] VS Code would open $last and wait until you close it." >&2 ;;
     esac ;;
esac
exit 0
