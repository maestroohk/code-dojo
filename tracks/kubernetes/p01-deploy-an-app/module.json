{
  "kind": "project",
  "title": "Deploy an app",
  "summary": "Take a web API and its PostgreSQL database from a container image to a production-shaped deployment: Deployment, Services, config and secrets, probes and resources, then a Gateway API route, autoscaling and a safe rollout. You read and complete the manifests, and write the checks a platform team would run on them.",
  "level": "After module 5. Stage 5 uses Helm-free plain manifests.",
  "skills": [
    "Deployments",
    "Services",
    "StatefulSets",
    "ConfigMaps and Secrets",
    "Probes",
    "Requests and limits",
    "Gateway API",
    "HPA",
    "Rolling updates"
  ],
