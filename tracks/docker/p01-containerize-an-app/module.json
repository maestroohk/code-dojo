{
  "title": "Containerize a .NET API",
  "summary": "Take a small .NET todo API from no Dockerfile to a hardened, multi-stage image running in Compose next to Postgres. Each stage teaches one step of the journey and builds a tool that checks it.",
  "kind": "project",
  "level": "After module 4 (Compose). Module 5 helps with the last stage.",
  "skills": [
    "Build context and .dockerignore",
    "Dockerfile basics",
    "Multi-stage builds",
    "Layer caching",
    "Compose with Postgres",
    "Healthchecks",
    "Non-root, pinned, chiseled images"
  ],
  "blueprint": {
    "layers": [
      "Source",
      "Image",
      "Container",
      "Network",
      "Storage"
    ],
    "parts": [
      {
        "id": "api",
        "label": "Todo API (minimal API)",
        "layer": "Source",
        "stage": 1
      },
      {
        "id": "ignore",
        "label": ".dockerignore",
        "layer": "Source",
        "stage": 1,
        "note": "bin, obj, .git, .env"
      },
      {
        "id": "naive",
        "label": "Naive SDK image",
        "layer": "Image",
        "stage": 2,
        "note": "works, but ~900 MB"
      },
      {
        "id": "run",
        "label": "api container",
        "layer": "Container",
        "stage": 2
      },
      {
        "id": "port",
        "label": "Published port 8080",
        "layer": "Network",
        "stage": 2
      },
      {
        "id": "multi",
        "label": "Multi-stage build",
        "layer": "Image",
        "stage": 3,
        "note": "sdk → aspnet"
      },
      {
        "id": "cache",
        "label": "Cached restore layer",
        "layer": "Image",
        "stage": 3
      },
      {
        "id": "compose",
        "label": "compose.yaml: api + db",
        "layer": "Container",
        "stage": 4
      },
      {
        "id": "dns",
        "label": "Project network: api → db",
        "layer": "Network",
        "stage": 4
      },
      {
        "id": "pgdata",
        "label": "pgdata volume",
        "layer": "Storage",
        "stage": 4
      },
      {
        "id": "harden",
        "label": "Chiseled, non-root, pinned",
        "layer": "Image",
        "stage": 5
      },
      {
        "id": "health",
        "label": "Healthcheck + limits",
        "layer": "Container",
        "stage": 5
      }
    ],
    "flow": [
      [
        "api",
        "naive"
      ],
      [
        "ignore",
        "naive"
      ],
      [
        "naive",
        "multi"
      ],
      [
        "cache",
        "multi"
      ],
      [
        "multi",
        "harden"
      ],
      [
        "naive",
        "run"
      ],
      [
        "run",
        "port"
      ],
      [
        "harden",
        "compose"
      ],
      [
        "compose",
        "dns"
      ],
      [
        "compose",
        "pgdata"
      ],
      [
        "compose",
        "health"
      ]
    ]
  }
}
