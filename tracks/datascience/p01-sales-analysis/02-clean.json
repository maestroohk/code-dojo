        "1026,2024-06-04,South,Widget,18,$25.00",
        "1027,2024-06-11,East,Gizmo,2,\"$1,200.00\"",
        "1028,2024-06-18,West,Widget,11,$25.00",
        "1029,2024-06-24, North,Doohickey,45,$8.50",
