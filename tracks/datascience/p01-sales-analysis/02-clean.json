        "1020,2024-04-29,West,Gadget,6,$40.00",
        "1021,2024-05-03,North,Widget,14,$25.00",
        "1022,2024-05-10,South,Gizmo,3,\"$1,200.00\"",
        "1023,2024-05-17,East,Gadget,,$40.00",
        "1024,2024-05-24,west,Doohickey,60,$8.50",
