{
  "title": "The encrypted vault",
  "summary": "Build a password vault from nothing: a PBKDF2 master key, AES-GCM entries with a nonce counter, envelope encryption so a password change re-encrypts nothing, sharing with ECDH, HKDF and ECDSA, then key rotation, an HMAC-chained audit log and an authenticated export. Every stage is tested by feeding your program commands and checking every line it prints.",
  "kind": "project",
  "level": "After the Cryptography & encryption modules 1 to 5.",
  "skills": [
    "PBKDF2",
    "AES-GCM",
    "Nonce management",
    "Envelope encryption",
    "ECDH + HKDF",
    "ECDSA",
    "Key rotation",
    "HMAC chains"
  ],
  "blueprint": {
    "layers": [
      "Input",
      "Keys",
      "Crypto",
      "Storage",
      "Output"
    ],
    "parts": [
      {
        "id": "cmd",
        "label": "Command loop",
        "layer": "Input",
        "stage": 1,
        "note": "One command per line from stdin"
      },
      {
        "id": "master",
        "label": "Master key (PBKDF2)",
        "layer": "Keys",
        "stage": 1,
        "note": "Derived from the password, only in memory"
      },
      {
        "id": "check",
        "label": "Key-check value",
        "layer": "Storage",
        "stage": 1,
        "note": "HMAC of a label, compared in constant time"
      },
      {
        "id": "status",
        "label": "Status lines",
        "layer": "Output",
        "stage": 1,
        "note": "Deterministic, never a secret key"
      },
      {
        "id": "nonce",
        "label": "Nonce counter",
        "layer": "Keys",
        "stage": 2,
        "note": "Never repeats, never goes back"
      },
      {
        "id": "gcm",
        "label": "AES-GCM sealing",
        "layer": "Crypto",
        "stage": 2,
        "note": "Entry name as associated data"
      },
      {
        "id": "entries",
        "label": "Entry store",
        "layer": "Storage",
        "stage": 2,
        "note": "Nonce, ciphertext, tag"
      },
      {
        "id": "dek",
        "label": "Data keys (DEK)",
        "layer": "Keys",
        "stage": 3,
        "note": "One random key per entry, wrapped"
      },
      {
        "id": "passwd",
        "label": "passwd",
        "layer": "Crypto",
        "stage": 3,
        "note": "Rewraps keys, re-encrypts nothing"
      },
      {
        "id": "ecdh",
        "label": "ECDH + HKDF",
        "layer": "Keys",
        "stage": 4,
        "note": "One-time share keys"
      },
      {
        "id": "ecdsa",
        "label": "ECDSA signatures",
        "layer": "Crypto",
        "stage": 4,
        "note": "Verified before decrypting"
      },
      {
        "id": "inbox",
        "label": "Inboxes",
        "layer": "Storage",
        "stage": 4
      },
      {
        "id": "kek",
        "label": "Versioned KEKs (HKDF)",
        "layer": "Keys",
        "stage": 5,
        "note": "rotate, rewrap, retire"
      },
      {
        "id": "audit",
        "label": "HMAC-chained audit log",
