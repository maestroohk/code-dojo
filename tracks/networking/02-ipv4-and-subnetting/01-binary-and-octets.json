{
  "title": "Binary and octets",
  "summary": "Read and write IPv4 addresses as the 32 bits routers actually see.",
  "minutes": 10,
  "kind": "lesson",
  "steps": [
    {
      "type": "learn",
      "title": "Eight bits per octet",
      "body": [
        "Each of the four numbers in an IPv4 address is an **octet**: 8 bits, worth 128, 64, 32, 16, 8, 4, 2, 1 from left to right.",
        "",
        "```text",
        " 128  64  32  16   8   4   2   1",
        "   1   0   1   0   1   1   0   0   = 128 + 32 + 8 + 4 = 172",
        "```",
        "",
        "To convert decimal to binary, walk the place values from 128 down: if the value fits, write 1 and subtract it, else write 0.",
        "Step through the program below to watch it happen for 172."
      ],
      "trace": {
        "code": [
          "int value = 172;",
          "string bits = \"\";",
          "for (int place = 128; place >= 1; place /= 2)",
          "{",
          "    if (value >= place) { bits += \"1\"; value -= place; }",
          "    else bits += \"0\";",
          "}",
          "Console.WriteLine(bits);"
        ]
      }
    },
    {
      "type": "predict",
      "prompt": "What does this print?",
      "code": [
        "foreach (int n in new[] { 10, 192, 255, 1 })",
        "    Console.WriteLine($\"{n} = {Convert.ToString(n, 2).PadLeft(8, '0')}\");"
      ],
      "answer": [
        "10 = 00001010",
        "192 = 11000000",
        "255 = 11111111",
        "1 = 00000001"
      ],
      "explain": "`Convert.ToString(n, 2)` gives binary; `PadLeft(8, '0')` makes it a full octet."
    },
    {
      "type": "match",
      "prompt": "Match each value to its binary octet. You'll meet these constantly in masks.",
      "pairs": [
        [
          "128",
          "`10000000`"
        ],
        [
          "192",
          "`11000000`"
        ],
        [
          "224",
          "`11100000`"
        ],
        [
          "240",
          "`11110000`"
        ],
        [
          "248",
          "`11111000`"
        ],
        [
          "252",
          "`11111100`"
        ]
      ]
    },
    {
      "type": "mcq",
      "prompt": "What is `10101000` in decimal?",
      "options": [
        "168",
        "170",
        "160",
        "136"
      ],
      "answer": 0,
      "explain": "128 + 32 + 8 = 168, as in `192.168.x.x`."
    },
    {
      "type": "learn",
      "title": "The address is one 32-bit number",
      "body": [
        "`192.168.1.10` is really",
        "",
        "```text",
        "11000000.10101000.00000001.00001010",
        "```",
        "",
        "and as a single number `192*2^24 + 168*2^16 + 1*2^8 + 10 = 3232235786`. Shifting left by 8 multiplies by 256, so building it is",
        "`((192 << 8 | 168) << 8 | 1) << 8 | 10`. Everything in subnetting is bit operations on this number: AND with a mask, OR with the inverse, compare."
      ]
    },
    {
      "type": "blanks",
      "prompt": "Fill in the decimal octets.",
      "code": [
        "11000000.10101000.00000001.00001010 = __1__.__2__.1.__3__"
      ],
      "blanks": [
        "192",
        "168",
        "10"
      ],
      "bank": [
        "172",
        "160",
        "12",
        "8"
      ],
      "explain": "Octet by octet: 128+64, 128+32+8, 1, 8+2."
    },
    {
      "type": "code",
      "mode": "write",
      "title": "Address to binary",
      "prompt": [
        "Write `string ToBinary(string ip)` returning the address as four 8-bit groups separated by dots:",
        "`ToBinary(\"192.168.1.10\")` returns `11000000.10101000.00000001.00001010`."
      ],
      "starter": [
        "string ToBinary(string ip)",
        "{",
        "    // your code",
        "}"
      ],
      "solution": [
        "string ToBinary(string ip)",
        "    => string.Join(\".\", ip.Split('.').Select(o => Convert.ToString(int.Parse(o), 2).PadLeft(8, '0')));"
      ],
      "template": [
        "{{CODE}}",
        "Dojo.Eq(\"192.168.1.10\", \"11000000.10101000.00000001.00001010\", ToBinary(\"192.168.1.10\"));",
        "Dojo.Eq(\"10.0.0.255\", \"00001010.00000000.00000000.11111111\", ToBinary(\"10.0.0.255\"));",
        "Dojo.Eq(\"172.16.254.1\", \"10101100.00010000.11111110.00000001\", ToBinary(\"172.16.254.1\"));"
      ],
      "hints": [
        "Split on `.`, convert each with `Convert.ToString(n, 2)`.",
        "`PadLeft(8, '0')` then join with `.`."
      ]
    },
    {
      "type": "code",
      "mode": "write",
      "title": "Binary to address",
      "prompt": [
        "Write `string FromBinary(string bits)`, the reverse: `\"00001010.00000000.00000000.00000001\"` gives `\"10.0.0.1\"`.",
        "Also write `long ToNumber(string ip)` returning the address as a single number (`\"0.0.1.0\"` is 256)."
      ],
      "starter": [
        "string FromBinary(string bits)",
        "{",
        "    // your code",
        "}",
        "",
        "long ToNumber(string ip)",
        "{",
        "    // your code",
        "}"
      ],
      "solution": [
        "string FromBinary(string bits) => string.Join(\".\", bits.Split('.').Select(b => Convert.ToInt32(b, 2)));",
        "",
        "long ToNumber(string ip) => ip.Split('.').Aggregate(0L, (acc, o) => acc * 256 + long.Parse(o));"
      ],
      "template": [
        "{{CODE}}",
        "Dojo.Eq(\"10.0.0.1\", \"10.0.0.1\", FromBinary(\"00001010.00000000.00000000.00000001\"));",
        "Dojo.Eq(\"255.255.240.0\", \"255.255.240.0\", FromBinary(\"11111111.11111111.11110000.00000000\"));",
        "Dojo.Eq(\"0.0.1.0 is 256\", 256L, ToNumber(\"0.0.1.0\"));",
        "Dojo.Eq(\"192.168.1.10\", 3232235786L, ToNumber(\"192.168.1.10\"));",
        "Dojo.Eq(\"255.255.255.255\", 4294967295L, ToNumber(\"255.255.255.255\"));"
      ],
      "hints": [
        "`Convert.ToInt32(b, 2)` parses binary.",
        "Multiply the running total by 256 and add each octet."
      ]
    }
  ]
}