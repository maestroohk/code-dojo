<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CodeDojo</RootNamespace>
    <AssemblyName>CodeDojo</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <!--
    Test libraries for learner code (CSharpRunner.cs TestLib): real xUnit v3, NSubstitute and FakeTimeProvider.
    The server never compiles against them (compile assets excluded) and they never flow to projects that
    reference this one (PrivateAssets), so the dojo's own xUnit v2 tests cannot clash with them. Their runtime
    files are copied into testlibs/ beside the server by the DojoTestLibs target below.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3.core" Version="4.0.3" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive;analyzers" />
    <PackageReference Include="xunit.v3.assert" Version="4.0.3" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive;analyzers" />
    <PackageReference Include="NSubstitute" Version="6.2.0" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive;analyzers" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive;analyzers" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive;analyzers" />
  </ItemGroup>

  <PropertyGroup>
    <DojoTestLibPackages>;xunit.v3.assert;xunit.v3.common;xunit.v3.extensibility.core;xunit.v3.runner.common;xunit.v3.runner.inproc.console;NSubstitute;Castle.Core;Microsoft.Extensions.TimeProvider.Testing;Microsoft.AspNetCore.TestHost;Microsoft.Bcl.AsyncInterfaces;</DojoTestLibPackages>
  </PropertyGroup>

  <!-- Where testlibs/ ends up, for the dojo's own tests (they run from another folder). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DojoTestLibs</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(OutDir)testlibs'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="DojoTestLibs" AfterTargets="Build">
    <ItemGroup>
      <_DojoTestLib Include="@(ReferenceCopyLocalPaths)" Condition="$(DojoTestLibPackages.Contains(';%(ReferenceCopyLocalPaths.NuGetPackageId);')) And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(_DojoTestLib)" DestinationFolder="$(OutDir)testlibs" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Python code intelligence (PyIntel.cs runs it in the dojo's Python). -->
    <EmbeddedResource Include="intel\pyintel.py" LogicalName="pyintel.py" />
    <!-- TypeScript / JavaScript code intelligence (TsIntel.cs runs it with Node). -->
    <EmbeddedResource Include="intel\tsintel.js" LogicalName="tsintel.js" />
    <!-- Visualizers for Python and TypeScript learn cards (PolyViz.cs). -->
    <EmbeddedResource Include="intel\pytrace.py" LogicalName="pytrace.py" />
    <EmbeddedResource Include="intel\tstrace.js" LogicalName="tstrace.js" />
    <EmbeddedResource Include="intel\evloop.js" LogicalName="evloop.js" />
  </ItemGroup>

</Project>
