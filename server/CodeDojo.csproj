<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CodeDojo</RootNamespace>
    <AssemblyName>CodeDojo</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Python code intelligence (PyIntel.cs runs it in the dojo's Python). -->
    <EmbeddedResource Include="intel\pyintel.py" LogicalName="pyintel.py" />
    <!-- TypeScript / JavaScript code intelligence (TsIntel.cs runs it with Node). -->
    <EmbeddedResource Include="intel\tsintel.js" LogicalName="tsintel.js" />
    <!-- Visualizers for Python and TypeScript learn cards (PolyViz.cs). -->
    <EmbeddedResource Include="intel\pytrace.py" LogicalName="pytrace.py" />
    <EmbeddedResource Include="intel\tstrace.js" LogicalName="tstrace.js" />
    <EmbeddedResource Include="intel\evloop.js" LogicalName="evloop.js" />
  </ItemGroup>

</Project>
